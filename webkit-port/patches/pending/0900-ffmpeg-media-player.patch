--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegSupportTable.h
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// MIME type / RFC 6381 codec support table of the ffmpeg media engine.
+// Engine-independent (no WebCore, WTF or ffmpeg headers) so it can be unit
+// tested on the host; MediaPlayerPrivateFFmpeg feeds it the decoders that
+// the linked libavcodec actually provides.
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+enum class Support { NotSupported, MaybeSupported, IsSupported };
+
+// Decoders available at run time. Defaults match the PS5 SDK ffmpeg 7.0.1
+// build: native h264/hevc/vp8/vp9/aac/opus/vorbis/mp3/flac/ac3/eac3, but no
+// software AV1 decoder (no libdav1d/libaom; ff_av1_decoder is hwaccel-only).
+struct DecoderAvailability {
+    bool h264 { true };
+    bool hevc { true };
+    bool vp8 { true };
+    bool vp9 { true };
+    bool av1 { false };
+    bool aac { true };
+    bool mp3 { true };
+    bool opus { true };
+    bool vorbis { true };
+    bool flac { true };
+    bool ac3 { true };
+    bool eac3 { true };
+};
+
+enum class Container { Unknown, MP4, WebM, HLS, MPEG, Ogg, Flac, Wav, AAC };
+
+inline char toLowerASCII(char c) { return (c >= 'A' && c <= 'Z') ? static_cast<char>(c - 'A' + 'a') : c; }
+
+inline std::string lowercase(std::string_view s)
+{
+    std::string out(s);
+    for (auto& c : out)
+        c = toLowerASCII(c);
+    return out;
+}
+
+inline std::string_view trim(std::string_view s)
+{
+    while (!s.empty() && (s.front() == ' ' || s.front() == '\t'))
+        s.remove_prefix(1);
+    while (!s.empty() && (s.back() == ' ' || s.back() == '\t'))
+        s.remove_suffix(1);
+    return s;
+}
+
+struct ContainerEntry {
+    std::string_view mimeType;
+    Container container;
+};
+
+// Every MIME type the engine claims. Used both for supportsType() and for
+// MediaPlayerFactory::getSupportedTypes().
+inline constexpr std::array<ContainerEntry, 22> containerTable { {
+    { "video/mp4", Container::MP4 },
+    { "audio/mp4", Container::MP4 },
+    { "video/x-m4v", Container::MP4 },
+    { "audio/x-m4a", Container::MP4 },
+    { "video/quicktime", Container::MP4 },
+    { "video/webm", Container::WebM },
+    { "audio/webm", Container::WebM },
+    { "video/x-matroska", Container::WebM },
+    { "audio/x-matroska", Container::WebM },
+    { "application/vnd.apple.mpegurl", Container::HLS },
+    { "application/x-mpegurl", Container::HLS },
+    { "audio/mpegurl", Container::HLS },
+    { "audio/x-mpegurl", Container::HLS },
+    { "audio/mpeg", Container::MPEG },
+    { "audio/mp3", Container::MPEG },
+    { "audio/ogg", Container::Ogg },
+    { "video/ogg", Container::Ogg },
+    { "audio/flac", Container::Flac },
+    { "audio/x-flac", Container::Flac },
+    { "audio/wav", Container::Wav },
+    { "audio/x-wav", Container::Wav },
+    { "audio/aac", Container::AAC },
+} };
+
+inline Container containerForMIMEType(std::string_view mimeType)
+{
+    auto lower = lowercase(trim(mimeType));
+    for (auto& entry : containerTable) {
+        if (entry.mimeType == lower)
+            return entry.container;
+    }
+    return Container::Unknown;
+}
+
+enum class CodecFamily { Unknown, H264, HEVC, VP8, VP9, AV1, AAC, MP3, Opus, Vorbis, Flac, AC3, EAC3 };
+
+inline bool startsWith(std::string_view s, std::string_view prefix)
+{
+    return s.size() >= prefix.size() && s.substr(0, prefix.size()) == prefix;
+}
+
+// Maps one RFC 6381 codecs-parameter entry (already lowercased) to a family.
+inline CodecFamily codecFamily(std::string_view codec)
+{
+    if (startsWith(codec, "avc1") || startsWith(codec, "avc3"))
+        return CodecFamily::H264;
+    if (startsWith(codec, "hvc1") || startsWith(codec, "hev1"))
+        return CodecFamily::HEVC;
+    if (codec == "vp8" || startsWith(codec, "vp8.") || startsWith(codec, "vp08"))
+        return CodecFamily::VP8;
+    if (codec == "vp9" || startsWith(codec, "vp9.") || startsWith(codec, "vp09"))
+        return CodecFamily::VP9;
+    if (startsWith(codec, "av01"))
+        return CodecFamily::AV1;
+    // mp4a.40.x is AAC (2 LC, 5 HE, 29 HE v2, ...) except 34 (MP3); mp4a.69
+    // and mp4a.6b are MPEG-1/2 audio.
+    if (codec == "mp4a.40.34" || codec == "mp4a.69" || codec == "mp4a.6b" || codec == "mp3")
+        return CodecFamily::MP3;
+    if (startsWith(codec, "mp4a.40") || codec == "mp4a.66" || codec == "mp4a.67" || codec == "mp4a.68" || codec == "aac")
+        return CodecFamily::AAC;
+    if (codec == "opus" || codec == "mp4a.ad")
+        return CodecFamily::Opus;
+    if (codec == "vorbis")
+        return CodecFamily::Vorbis;
+    if (codec == "flac")
+        return CodecFamily::Flac;
+    if (codec == "ac-3" || codec == "mp4a.a5")
+        return CodecFamily::AC3;
+    if (codec == "ec-3" || codec == "mp4a.a6")
+        return CodecFamily::EAC3;
+    return CodecFamily::Unknown;
+}
+
+inline bool decoderAvailable(CodecFamily family, const DecoderAvailability& decoders)
+{
+    switch (family) {
+    case CodecFamily::H264: return decoders.h264;
+    case CodecFamily::HEVC: return decoders.hevc;
+    case CodecFamily::VP8: return decoders.vp8;
+    case CodecFamily::VP9: return decoders.vp9;
+    case CodecFamily::AV1: return decoders.av1;
+    case CodecFamily::AAC: return decoders.aac;
+    case CodecFamily::MP3: return decoders.mp3;
+    case CodecFamily::Opus: return decoders.opus;
+    case CodecFamily::Vorbis: return decoders.vorbis;
+    case CodecFamily::Flac: return decoders.flac;
+    case CodecFamily::AC3: return decoders.ac3;
+    case CodecFamily::EAC3: return decoders.eac3;
+    case CodecFamily::Unknown: return false;
+    }
+    return false;
+}
+
+// Whether a codec family may appear in a container at all (a WebM file
+// cannot carry H.264, an MP3 file cannot carry video, ...).
+inline bool containerAllows(Container container, CodecFamily family)
+{
+    switch (container) {
+    case Container::MP4:
+        return family != CodecFamily::Vorbis;
+    case Container::WebM:
+        return family == CodecFamily::VP8 || family == CodecFamily::VP9 || family == CodecFamily::AV1
+            || family == CodecFamily::Opus || family == CodecFamily::Vorbis;
+    case Container::HLS:
+        // TS and fMP4 segments: the codecs Safari advertises for HLS plus Opus/FLAC in fMP4.
+        return family == CodecFamily::H264 || family == CodecFamily::HEVC || family == CodecFamily::AAC
+            || family == CodecFamily::MP3 || family == CodecFamily::AC3 || family == CodecFamily::EAC3
+            || family == CodecFamily::Opus || family == CodecFamily::Flac || family == CodecFamily::VP9 || family == CodecFamily::AV1;
+    case Container::MPEG:
+        return family == CodecFamily::MP3;
+    case Container::Ogg:
+        return family == CodecFamily::Opus || family == CodecFamily::Vorbis || family == CodecFamily::Flac;
+    case Container::Flac:
+        return family == CodecFamily::Flac;
+    case Container::Wav:
+        return false; // PCM has no RFC 6381 name; only "1" is used in practice.
+    case Container::AAC:
+        return family == CodecFamily::AAC;
+    case Container::Unknown:
+        return false;
+    }
+    return false;
+}
+
+// Splits a codecs parameter value ("avc1.64001f, mp4a.40.2") into entries.
+inline std::vector<std::string> splitCodecs(std::string_view codecs)
+{
+    std::vector<std::string> result;
+    size_t start = 0;
+    while (start <= codecs.size()) {
+        size_t comma = codecs.find(',', start);
+        if (comma == std::string_view::npos)
+            comma = codecs.size();
+        auto item = trim(codecs.substr(start, comma - start));
+        if (!item.empty())
+            result.push_back(lowercase(item));
+        start = comma + 1;
+    }
+    return result;
+}
+
+// HTML canPlayType()/isTypeSupported() semantics:
+//  - unknown container: NotSupported ("");
+//  - known container, no codecs parameter: MaybeSupported ("maybe");
+//  - every listed codec known and decodable in this container: IsSupported ("probably");
+//  - a codec known to be undecodable or impossible in the container: NotSupported;
+//  - otherwise (a codec string we do not recognise): MaybeSupported.
+inline Support evaluate(std::string_view mimeType, const std::vector<std::string>& codecs, const DecoderAvailability& decoders)
+{
+    auto container = containerForMIMEType(mimeType);
+    if (container == Container::Unknown)
+        return Support::NotSupported;
+    if (codecs.empty())
+        return Support::MaybeSupported;
+
+    Support result = Support::IsSupported;
+    for (auto& rawCodec : codecs) {
+        auto codec = lowercase(trim(rawCodec));
+        if (container == Container::Wav && (codec == "1" || codec == "3"))
+            continue;
+        auto family = codecFamily(codec);
+        if (family == CodecFamily::Unknown) {
+            result = Support::MaybeSupported;
+            continue;
+        }
+        if (!containerAllows(container, family) || !decoderAvailable(family, decoders))
+            return Support::NotSupported;
+    }
+    return result;
+}
+
+} // namespace FFmpegMedia
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegTimeRanges.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegTimeRanges.h
new file mode 100644
index 0000000..42b33ee
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegTimeRanges.h
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Sorted, non-overlapping set of half-open [start, end) time ranges in
+// seconds. Engine-independent; the demuxer records what it has demuxed here
+// and the player converts it into PlatformTimeRanges for buffered().
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <vector>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+class TimeRangeSet {
+public:
+    struct Range {
+        double start;
+        double end;
+    };
+
+    // Ranges closer than this are merged: demuxed packets of one stream are
+    // contiguous but timestamps carry rounding error.
+    static constexpr double mergeTolerance = 0.05;
+
+    void add(double start, double end)
+    {
+        if (!std::isfinite(start) || !std::isfinite(end) || end <= start)
+            return;
+        Range added { start, end };
+        std::vector<Range> merged;
+        merged.reserve(m_ranges.size() + 1);
+        bool inserted = false;
+        for (auto& range : m_ranges) {
+            if (range.end + mergeTolerance < added.start) {
+                merged.push_back(range);
+                continue;
+            }
+            if (added.end + mergeTolerance < range.start) {
+                if (!inserted) {
+                    merged.push_back(added);
+                    inserted = true;
+                }
+                merged.push_back(range);
+                continue;
+            }
+            added.start = std::min(added.start, range.start);
+            added.end = std::max(added.end, range.end);
+        }
+        if (!inserted)
+            merged.push_back(added);
+        m_ranges = std::move(merged);
+    }
+
+    void clear() { m_ranges.clear(); }
+    bool isEmpty() const { return m_ranges.empty(); }
+    size_t size() const { return m_ranges.size(); }
+    const Range& operator[](size_t i) const { return m_ranges[i]; }
+    const std::vector<Range>& ranges() const { return m_ranges; }
+
+    bool contains(double time) const
+    {
+        for (auto& range : m_ranges) {
+            if (time >= range.start - mergeTolerance && time < range.end)
+                return true;
+        }
+        return false;
+    }
+
+    // Seconds of contiguous data available from `time` on (0 if `time` is
+    // not buffered). Drives the HAVE_FUTURE_DATA/HAVE_ENOUGH_DATA decision.
+    double bufferedAhead(double time) const
+    {
+        for (auto& range : m_ranges) {
+            if (time >= range.start - mergeTolerance && time < range.end)
+                return range.end - time;
+        }
+        return 0;
+    }
+
+    double totalDuration() const
+    {
+        double total = 0;
+        for (auto& range : m_ranges)
+            total += range.end - range.start;
+        return total;
+    }
+
+private:
+    std::vector<Range> m_ranges;
+};
+
+} // namespace FFmpegMedia
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegUtilities.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegUtilities.h
new file mode 100644
index 0000000..d1f3f65
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegUtilities.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// ffmpeg RAII helpers and timestamp conversion shared by the ffmpeg media
+// engine (demuxer, decoders, player).
+
+#pragma once
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include <cmath>
+#include <limits>
+#include <memory>
+#include <wtf/text/WTFString.h>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/avutil.h>
+#include <libavutil/error.h>
+}
+
+namespace WebCore {
+
+struct AVPacketDeleter {
+    void operator()(AVPacket* packet) const { av_packet_free(&packet); }
+};
+using AVPacketPtr = std::unique_ptr<AVPacket, AVPacketDeleter>;
+
+struct AVFrameDeleter {
+    void operator()(AVFrame* frame) const { av_frame_free(&frame); }
+};
+using AVFramePtr = std::unique_ptr<AVFrame, AVFrameDeleter>;
+
+struct AVCodecContextDeleter {
+    void operator()(AVCodecContext* context) const { avcodec_free_context(&context); }
+};
+using AVCodecContextPtr = std::unique_ptr<AVCodecContext, AVCodecContextDeleter>;
+
+struct AVCodecParametersDeleter {
+    void operator()(AVCodecParameters* parameters) const { avcodec_parameters_free(&parameters); }
+};
+using AVCodecParametersPtr = std::unique_ptr<AVCodecParameters, AVCodecParametersDeleter>;
+
+// Immutable description of one demuxed stream, handed from the demuxer to a
+// decoder. Times are in seconds on the media timeline: stream timestamps
+// minus the container start time, so the media starts at 0.
+struct FFmpegStreamInfo {
+    int index { -1 };
+    AVRational timeBase { 0, 1 };
+    double startTime { 0 };
+    AVCodecParametersPtr parameters;
+
+    double toSeconds(int64_t timestamp) const
+    {
+        if (timestamp == AV_NOPTS_VALUE || !timeBase.den)
+            return std::numeric_limits<double>::quiet_NaN();
+        return timestamp * av_q2d(timeBase) - startTime;
+    }
+};
+
+// libavcodec's native AV1 decoder only drives hardware accelerators, so AV1
+// needs libdav1d or libaom (absent from the PS5 SDK build).
+inline const AVCodec* findSoftwareDecoder(AVCodecID codecId)
+{
+    if (codecId == AV_CODEC_ID_AV1) {
+        if (auto* codec = avcodec_find_decoder_by_name("libdav1d"))
+            return codec;
+        return avcodec_find_decoder_by_name("libaom-av1");
+    }
+    return avcodec_find_decoder(codecId);
+}
+
+inline String ffmpegErrorString(int error)
+{
+    char buffer[AV_ERROR_MAX_STRING_SIZE] = { };
+    av_strerror(error, buffer, sizeof(buffer));
+    return String::fromLatin1(buffer);
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegVideoDecoder.cpp b/Source/WebCore/platform/graphics/ffmpeg/FFmpegVideoDecoder.cpp
new file mode 100644
index 0000000..5d4da5e
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegVideoDecoder.cpp
@@ -0,0 +1,361 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "config.h"
+#include "FFmpegVideoDecoder.h"
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "FFmpegDemuxer.h"
+#include "Logging.h"
+
+extern "C" {
+#include <libavutil/imgutils.h>
+#include <libavutil/pixdesc.h>
+#include <libswscale/swscale.h>
+}
+
+namespace WebCore {
+
+namespace {
+
+constexpr Seconds packetWaitTimeout = 20_ms;
+constexpr Seconds outputWaitTimeout = 20_ms;
+// Decoded frames waiting for presentation. Small: each 1080p BGRA frame is
+// 8 MiB, and the presentation tick only ever needs the next one or two.
+constexpr size_t maxOutputFrames = 3;
+constexpr size_t maxPooledFrames = 6;
+// Output is capped at 1080p; anything bigger is downscaled by swscale.
+constexpr int maxOutputWidth = 1920;
+constexpr int maxOutputHeight = 1080;
+// Decoder threads. The WebProcess shares the Zen 2 cores with the UI
+// process and the audio decoder; 4 leaves headroom.
+constexpr int decoderThreads = 4;
+// A frame this far behind the clock is dropped before conversion; one in
+// lateFrameKeepInterval late frames is still shown so the picture moves.
+constexpr double lateThreshold = 0.08;
+constexpr unsigned lateFrameKeepInterval = 8;
+constexpr unsigned lateFramesBeforeSkippingLoopFilter = 4;
+
+int swsColorspace(const AVFrame* frame)
+{
+    switch (frame->colorspace) {
+    case AVCOL_SPC_BT709:
+        return SWS_CS_ITU709;
+    case AVCOL_SPC_BT2020_NCL:
+    case AVCOL_SPC_BT2020_CL:
+        return SWS_CS_BT2020;
+    case AVCOL_SPC_SMPTE170M:
+    case AVCOL_SPC_BT470BG:
+        return SWS_CS_ITU601;
+    default:
+        // Unspecified: HD content is BT.709 in practice.
+        return frame->height >= 720 ? SWS_CS_ITU709 : SWS_CS_ITU601;
+    }
+}
+
+} // namespace
+
+RefPtr<FFmpegVideoDecoder> FFmpegVideoDecoder::create(const FFmpegStreamInfo& stream, FFmpegPacketQueue& queue)
+{
+    if (!stream.parameters)
+        return nullptr;
+    const AVCodec* codec = findSoftwareDecoder(stream.parameters->codec_id);
+    if (!codec)
+        return nullptr;
+    AVCodecContextPtr context(avcodec_alloc_context3(codec));
+    if (!context || avcodec_parameters_to_context(context.get(), stream.parameters.get()) < 0)
+        return nullptr;
+    context->pkt_timebase = stream.timeBase;
+    context->thread_count = decoderThreads;
+    context->thread_type = FF_THREAD_FRAME | FF_THREAD_SLICE;
+    int result = avcodec_open2(context.get(), codec, nullptr);
+    if (result < 0) {
+        LOG(Media, "FFmpegVideoDecoder: cannot open %s: %s", codec->name, ffmpegErrorString(result).utf8().legacyCStringPointer());
+        return nullptr;
+    }
+    return adoptRef(*new FFmpegVideoDecoder(stream, queue, WTF::move(context)));
+}
+
+FFmpegVideoDecoder::FFmpegVideoDecoder(const FFmpegStreamInfo& stream, FFmpegPacketQueue& queue, AVCodecContextPtr&& context)
+    : m_timeBase(stream.timeBase)
+    , m_startTime(stream.startTime)
+    , m_queue(queue)
+    , m_codec(WTF::move(context))
+    , m_frame(av_frame_alloc())
+{
+    updateOutputSize(m_codec->width, m_codec->height);
+}
+
+FFmpegVideoDecoder::~FFmpegVideoDecoder()
+{
+    ASSERT(!m_thread);
+    if (m_sws)
+        sws_freeContext(m_sws);
+}
+
+void FFmpegVideoDecoder::start()
+{
+    if (m_thread || !m_frame)
+        return;
+    m_thread = Thread::create("FFmpegVideoDecoder"_s, [protectedThis = Ref { *this }] {
+        protectedThis->run();
+    });
+}
+
+void FFmpegVideoDecoder::stop()
+{
+    m_stopping = true;
+    {
+        Locker locker { m_lock };
+        m_condition.notifyAll();
+    }
+    if (RefPtr thread = std::exchange(m_thread, nullptr))
+        thread->waitForCompletion();
+}
+
+void FFmpegVideoDecoder::updateOutputSize(int width, int height)
+{
+    if (width <= 0 || height <= 0)
+        return;
+    AVRational sar = m_codec->sample_aspect_ratio;
+    double displayWidth = width;
+    if (sar.num > 0 && sar.den > 0)
+        displayWidth = width * av_q2d(sar);
+    double scale = std::min({ 1.0, maxOutputWidth / displayWidth, maxOutputHeight / static_cast<double>(height) });
+    // Even dimensions keep swscale on its fast paths.
+    int outputWidth = std::max(2, static_cast<int>(std::lround(displayWidth * scale)) & ~1);
+    int outputHeight = std::max(2, static_cast<int>(std::lround(height * scale)) & ~1);
+    m_outputWidth = outputWidth;
+    m_outputHeight = outputHeight;
+}
+
+void FFmpegVideoDecoder::run()
+{
+    while (!m_stopping) {
+        auto entry = m_queue.pop(packetWaitTimeout);
+        if (!entry) {
+            if (m_queue.isAborted())
+                break;
+            continue;
+        }
+        if (entry->serial != m_serial)
+            flushForSerial(entry->serial);
+        if (entry->isEndOfStream()) {
+            avcodec_send_packet(m_codec.get(), nullptr);
+            receiveFrames();
+            // Draining leaves the codec in EOF state; reset it for whatever
+            // comes next (a seek, or a looping restart).
+            avcodec_flush_buffers(m_codec.get());
+            Locker locker { m_lock };
+            m_endSerial = m_serial;
+            m_condition.notifyAll();
+            continue;
+        }
+        if (!handlePacket(entry->packet.get()))
+            break;
+    }
+}
+
+void FFmpegVideoDecoder::flushForSerial(unsigned serial)
+{
+    avcodec_flush_buffers(m_codec.get());
+    m_serial = serial;
+    m_waitingForKeyframe = false;
+    m_lateFrames = 0;
+    if (m_skippingLoopFilter) {
+        m_codec->skip_loop_filter = AVDISCARD_DEFAULT;
+        m_skippingLoopFilter = false;
+    }
+    Locker locker { m_lock };
+    m_output.removeAllMatching([serial](auto& frame) {
+        return frame->serial != serial;
+    });
+    m_endSerial = std::numeric_limits<unsigned>::max();
+    m_condition.notifyAll();
+}
+
+bool FFmpegVideoDecoder::handlePacket(AVPacket* packet)
+{
+    if (m_suspended) {
+        m_waitingForKeyframe = true;
+        return true;
+    }
+    if (m_waitingForKeyframe) {
+        if (!(packet->flags & AV_PKT_FLAG_KEY))
+            return true;
+        avcodec_flush_buffers(m_codec.get());
+        m_waitingForKeyframe = false;
+    }
+
+    int result = avcodec_send_packet(m_codec.get(), packet);
+    if (result == AVERROR(EAGAIN)) {
+        receiveFrames();
+        result = avcodec_send_packet(m_codec.get(), packet);
+    }
+    if (result < 0 && result != AVERROR(EAGAIN) && result != AVERROR_EOF) {
+        // Corrupt packets are routine in live streams; keep going.
+        LOG(Media, "FFmpegVideoDecoder: send_packet: %s", ffmpegErrorString(result).utf8().legacyCStringPointer());
+    }
+    receiveFrames();
+    return !m_stopping;
+}
+
+void FFmpegVideoDecoder::receiveFrames()
+{
+    while (!m_stopping) {
+        int result = avcodec_receive_frame(m_codec.get(), m_frame.get());
+        if (result == AVERROR(EAGAIN) || result == AVERROR_EOF)
+            return;
+        if (result < 0) {
+            LOG(Media, "FFmpegVideoDecoder: receive_frame: %s", ffmpegErrorString(result).utf8().legacyCStringPointer());
+            return;
+        }
+        ++m_decodedFrames;
+        emitFrame(m_frame.get());
+        av_frame_unref(m_frame.get());
+    }
+}
+
+RefPtr<FFmpegVideoFrame> FFmpegVideoDecoder::takePoolFrame(int width, int height)
+{
+    // A pooled frame referenced only by the pool is neither queued nor held
+    // by the player or a NativeImage, so it can be overwritten.
+    m_pool.removeAllMatching([&](auto& frame) {
+        return frame->hasOneRef() && (frame->width() != width || frame->height() != height);
+    });
+    for (auto& frame : m_pool) {
+        if (frame->hasOneRef())
+            return frame.ptr();
+    }
+    auto frame = FFmpegVideoFrame::create(width, height);
+    if (m_pool.size() < maxPooledFrames)
+        m_pool.append(frame);
+    return frame;
+}
+
+void FFmpegVideoDecoder::emitFrame(AVFrame* frame)
+{
+    double pts = (frame->best_effort_timestamp == AV_NOPTS_VALUE || !m_timeBase.den)
+        ? std::numeric_limits<double>::quiet_NaN()
+        : frame->best_effort_timestamp * av_q2d(m_timeBase) - m_startTime;
+    double duration = frame->duration > 0 ? frame->duration * av_q2d(m_timeBase) : 0;
+    if (duration <= 0 && m_codec->framerate.num > 0 && m_codec->framerate.den > 0)
+        duration = av_q2d(av_inv_q(m_codec->framerate));
+    if (duration <= 0)
+        duration = 1.0 / 30;
+    if (!std::isfinite(pts))
+        return;
+
+    {
+        Locker locker { m_lock };
+        if (m_seekTarget >= 0 && m_seekSerial == m_serial) {
+            if (pts + duration <= m_seekTarget)
+                return;
+            m_seekTarget = -1;
+        }
+    }
+
+    bool isLate = pts + duration < m_clockHint - lateThreshold;
+    if (isLate) {
+        ++m_lateFrames;
+        if (m_lateFrames >= lateFramesBeforeSkippingLoopFilter && !m_skippingLoopFilter) {
+            // Deblocking is a large share of H.264 decode time; skipping it
+            // costs some quality but lets a slow CPU catch up.
+            m_codec->skip_loop_filter = AVDISCARD_ALL;
+            m_skippingLoopFilter = true;
+        }
+        if (m_lateFrames % lateFrameKeepInterval) {
+            ++m_droppedFrames;
+            return;
+        }
+    } else {
+        m_lateFrames = 0;
+        if (m_skippingLoopFilter) {
+            m_codec->skip_loop_filter = AVDISCARD_DEFAULT;
+            m_skippingLoopFilter = false;
+        }
+    }
+
+    updateOutputSize(frame->width, frame->height);
+    int width = m_outputWidth;
+    int height = m_outputHeight;
+    RefPtr output = takePoolFrame(width, height);
+    m_sws = sws_getCachedContext(m_sws, frame->width, frame->height, static_cast<AVPixelFormat>(frame->format),
+        width, height, AV_PIX_FMT_BGRA, SWS_BILINEAR, nullptr, nullptr, nullptr);
+    if (!m_sws) {
+        LOG(Media, "FFmpegVideoDecoder: no swscale path from %s", av_get_pix_fmt_name(static_cast<AVPixelFormat>(frame->format)));
+        m_fatalError = true;
+        return;
+    }
+    bool fullRange = frame->color_range == AVCOL_RANGE_JPEG;
+    sws_setColorspaceDetails(m_sws, sws_getCoefficients(swsColorspace(frame)), fullRange ? 1 : 0,
+        sws_getCoefficients(SWS_CS_DEFAULT), 1, 0, 1 << 16, 1 << 16);
+    uint8_t* destination[4] = { output->data(), nullptr, nullptr, nullptr };
+    int destinationStride[4] = { static_cast<int>(output->stride()), 0, 0, 0 };
+    sws_scale(m_sws, frame->data, frame->linesize, 0, frame->height, destination, destinationStride);
+    output->pts = pts;
+    output->duration = duration;
+    output->serial = m_serial;
+
+    Locker locker { m_lock };
+    while (m_output.size() >= maxOutputFrames && !m_stopping && m_queue.serial() == m_serial)
+        m_condition.waitFor(m_lock, outputWaitTimeout);
+    if (m_stopping || m_queue.serial() != m_serial)
+        return;
+    m_output.append(output.releaseNonNull());
+}
+
+RefPtr<FFmpegVideoFrame> FFmpegVideoDecoder::peekFrame(unsigned serial, size_t index)
+{
+    Locker locker { m_lock };
+    while (!m_output.isEmpty() && m_output.first()->serial != serial) {
+        m_output.removeFirst();
+        m_condition.notifyAll();
+    }
+    if (index >= m_output.size())
+        return nullptr;
+    auto it = m_output.begin();
+    for (size_t i = 0; i < index; ++i)
+        ++it;
+    if ((*it)->serial != serial)
+        return nullptr;
+    return it->ptr();
+}
+
+void FFmpegVideoDecoder::popFrame()
+{
+    Locker locker { m_lock };
+    if (!m_output.isEmpty())
+        m_output.removeFirst();
+    m_condition.notifyAll();
+}
+
+size_t FFmpegVideoDecoder::queuedFrames() const
+{
+    Locker locker { m_lock };
+    return m_output.size();
+}
+
+bool FFmpegVideoDecoder::reachedEnd(unsigned serial) const
+{
+    Locker locker { m_lock };
+    return m_endSerial == serial && m_output.isEmpty();
+}
+
+void FFmpegVideoDecoder::setSeekTarget(double time, unsigned serial)
+{
+    m_clockHint = time;
+    Locker locker { m_lock };
+    m_seekTarget = time;
+    m_seekSerial = serial;
+    m_condition.notifyAll();
+}
+
+void FFmpegVideoDecoder::setSuspended(bool suspended)
+{
+    m_suspended = suspended;
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegVideoDecoder.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegVideoDecoder.h
new file mode 100644
index 0000000..b1fe650
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegVideoDecoder.h
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Software video decoding for the ffmpeg media engine: a worker thread pulls
+// packets from the demuxer queue, decodes them with libavcodec (frame and
+// slice threads) and converts each picture with libswscale into an opaque
+// BGRA FFmpegVideoFrame taken from a small recycling pool. Decoded frames
+// wait in a short output queue until the player's presentation tick shows
+// them against the AVClock.
+//
+// The decoder only knows packets and frames, not WebCore players, so an MSE
+// SourceBuffer-fed player can reuse it with its own packet queue.
+
+#pragma once
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "FFmpegUtilities.h"
+#include <atomic>
+#include <wtf/Condition.h>
+#include <wtf/Deque.h>
+#include <wtf/Lock.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/Threading.h>
+#include <wtf/Vector.h>
+
+struct SwsContext;
+
+namespace WebCore {
+
+class FFmpegPacketQueue;
+
+class FFmpegVideoFrame final : public ThreadSafeRefCounted<FFmpegVideoFrame> {
+public:
+    static Ref<FFmpegVideoFrame> create(int width, int height)
+    {
+        return adoptRef(*new FFmpegVideoFrame(width, height));
+    }
+
+    int width() const { return m_width; }
+    int height() const { return m_height; }
+    size_t stride() const { return static_cast<size_t>(m_width) * 4; }
+    uint8_t* data() { return m_pixels.mutableSpan().data(); }
+    const uint8_t* data() const { return m_pixels.span().data(); }
+    size_t sizeInBytes() const { return m_pixels.size(); }
+
+    double pts { 0 };
+    double duration { 0 };
+    unsigned serial { 0 };
+
+private:
+    FFmpegVideoFrame(int width, int height)
+        : m_width(width)
+        , m_height(height)
+        , m_pixels(static_cast<size_t>(width) * height * 4)
+    {
+    }
+
+    int m_width;
+    int m_height;
+    Vector<uint8_t> m_pixels;
+};
+
+class FFmpegVideoDecoder final : public ThreadSafeRefCounted<FFmpegVideoDecoder> {
+public:
+    // Returns nullptr when no decoder can be opened for the stream.
+    static RefPtr<FFmpegVideoDecoder> create(const FFmpegStreamInfo&, FFmpegPacketQueue&);
+    ~FFmpegVideoDecoder();
+
+    void start();
+    void stop();
+
+    // Output queue (main thread). Frames of an older serial are dropped
+    // internally; peek/pop only ever return frames of `serial`.
+    RefPtr<FFmpegVideoFrame> peekFrame(unsigned serial, size_t index = 0);
+    void popFrame();
+    size_t queuedFrames() const;
+    // The decoder drained the stream for `serial` and every frame was popped.
+    bool reachedEnd(unsigned serial) const;
+    bool hasFatalError() const { return m_fatalError; }
+
+    // Frames before `time` are decoded but not converted or queued (accurate
+    // seek). Call right after the demuxer seek with the same serial.
+    void setSeekTarget(double time, unsigned serial);
+    // Hidden page: packets are dropped until the next keyframe after resume.
+    void setSuspended(bool);
+    // Current playback position, used to drop late frames before conversion.
+    void setClockHint(double time) { m_clockHint = time; }
+
+    unsigned decodedFrames() const { return m_decodedFrames; }
+    unsigned droppedFrames() const { return m_droppedFrames; }
+    int outputWidth() const { return m_outputWidth; }
+    int outputHeight() const { return m_outputHeight; }
+
+private:
+    FFmpegVideoDecoder(const FFmpegStreamInfo&, FFmpegPacketQueue&, AVCodecContextPtr&&);
+
+    void run();
+    void flushForSerial(unsigned serial);
+    bool handlePacket(AVPacket*);
+    void receiveFrames();
+    void emitFrame(AVFrame*);
+    RefPtr<FFmpegVideoFrame> takePoolFrame(int width, int height);
+    void updateOutputSize(int width, int height);
+
+    const AVRational m_timeBase;
+    const double m_startTime;
+    FFmpegPacketQueue& m_queue;
+    AVCodecContextPtr m_codec;
+    AVFramePtr m_frame;
+    SwsContext* m_sws { nullptr };
+    RefPtr<Thread> m_thread;
+    std::atomic<bool> m_stopping { false };
+    std::atomic<bool> m_fatalError { false };
+    std::atomic<bool> m_suspended { false };
+    std::atomic<double> m_clockHint { 0 };
+    std::atomic<unsigned> m_decodedFrames { 0 };
+    std::atomic<unsigned> m_droppedFrames { 0 };
+    std::atomic<int> m_outputWidth { 0 };
+    std::atomic<int> m_outputHeight { 0 };
+
+    // Decoder thread only.
+    unsigned m_serial { 0 };
+    bool m_waitingForKeyframe { false };
+    bool m_skippingLoopFilter { false };
+    unsigned m_lateFrames { 0 };
+    Vector<Ref<FFmpegVideoFrame>> m_pool;
+
+    mutable Lock m_lock;
+    Condition m_condition;
+    Deque<Ref<FFmpegVideoFrame>> m_output WTF_GUARDED_BY_LOCK(m_lock);
+    unsigned m_endSerial WTF_GUARDED_BY_LOCK(m_lock) { std::numeric_limits<unsigned>::max() };
+    double m_seekTarget WTF_GUARDED_BY_LOCK(m_lock) { -1 };
+    unsigned m_seekSerial WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/MediaPlayerPrivateFFmpeg.cpp b/Source/WebCore/platform/graphics/ffmpeg/MediaPlayerPrivateFFmpeg.cpp
