+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "config.h"
+#include "FFmpegDemuxer.h"
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "Logging.h"
+#include "PlatformMediaResourceLoader.h"
+#include <wtf/MainThread.h>
+
+namespace WebCore {
+
+namespace {
+
+constexpr Seconds idlePollInterval = 20_ms;
+// Consecutive non-fatal read errors tolerated before giving up.
+constexpr unsigned maxConsecutiveReadErrors = 64;
+// HLS variant cap: software decoding above 1080p is not realistic.
+constexpr int maxVideoWidth = 1920;
+constexpr int maxVideoHeight = 1088;
+
+int64_t streamBitRate(const AVStream* stream)
+{
+    if (stream->codecpar->bit_rate > 0)
+        return stream->codecpar->bit_rate;
+    if (auto* entry = av_dict_get(stream->metadata, "variant_bitrate", nullptr, 0))
+        return strtoll(entry->value, nullptr, 10);
+    return 0;
+}
+
+} // namespace
+
+// MARK: - FFmpegPacketQueue
+
+void FFmpegPacketQueue::push(AVPacketPtr&& packet, unsigned serial)
+{
+    Locker locker { m_lock };
+    if (m_aborted || serial != m_serial)
+        return;
+    m_bytes += packet->size;
+    int64_t timestamp = packet->pts != AV_NOPTS_VALUE ? packet->pts : packet->dts;
+    if (timestamp != AV_NOPTS_VALUE) {
+        int64_t end = timestamp + std::max<int64_t>(packet->duration, 0);
+        if (m_lastTimestamp == AV_NOPTS_VALUE || end > m_lastTimestamp)
+            m_lastTimestamp = end;
+    }
+    m_entries.append({ WTF::move(packet), serial });
+    m_condition.notifyAll();
+}
+
+void FFmpegPacketQueue::pushEndOfStream(unsigned serial)
+{
+    Locker locker { m_lock };
+    if (m_aborted || serial != m_serial)
+        return;
+    m_entries.append({ nullptr, serial });
+    m_condition.notifyAll();
+}
+
+std::optional<FFmpegPacketQueue::Entry> FFmpegPacketQueue::pop(Seconds timeout)
+{
+    Locker locker { m_lock };
+    if (m_entries.isEmpty() && !m_aborted)
+        m_condition.waitFor(m_lock, timeout);
+    if (m_aborted || m_entries.isEmpty())
+        return std::nullopt;
+    auto entry = m_entries.takeFirst();
+    if (entry.packet)
+        m_bytes -= std::min<size_t>(m_bytes, entry.packet->size);
+    if (m_entries.isEmpty())
+        m_lastTimestamp = AV_NOPTS_VALUE;
+    return entry;
+}
+
+void FFmpegPacketQueue::flush(unsigned newSerial)
+{
+    Locker locker { m_lock };
+    m_entries.clear();
+    m_bytes = 0;
+    m_lastTimestamp = AV_NOPTS_VALUE;
+    m_serial = newSerial;
+    m_condition.notifyAll();
+}
+
+void FFmpegPacketQueue::abort()
+{
+    Locker locker { m_lock };
+    m_aborted = true;
+    m_entries.clear();
+    m_bytes = 0;
+    m_condition.notifyAll();
+}
+
+size_t FFmpegPacketQueue::bytes() const
+{
+    Locker locker { m_lock };
+    return m_bytes;
+}
+
+FFmpegMedia::QueueLevel FFmpegPacketQueue::level() const
+{
+    Locker locker { m_lock };
+    FFmpegMedia::QueueLevel level;
+    level.enabled = m_enabled;
+    level.packets = m_entries.size();
+    if (m_entries.isEmpty() || m_lastTimestamp == AV_NOPTS_VALUE)
+        return level;
+    for (auto& entry : m_entries) {
+        if (!entry.packet)
+            continue;
+        int64_t first = entry.packet->pts != AV_NOPTS_VALUE ? entry.packet->pts : entry.packet->dts;
+        if (first == AV_NOPTS_VALUE)
+            continue;
+        level.seconds = std::max(0.0, (m_lastTimestamp - first) * av_q2d(m_timeBase));
+        break;
+    }
+    return level;
+}
+
+// MARK: - FFmpegDemuxer
+
+Ref<FFmpegDemuxer> FFmpegDemuxer::create(const URL& url, Ref<PlatformMediaResourceLoader>&& loader, const String& userAgent)
+{
+    return adoptRef(*new FFmpegDemuxer(url, WTF::move(loader), userAgent));
+}
+
+FFmpegDemuxer::FFmpegDemuxer(const URL& url, Ref<PlatformMediaResourceLoader>&& loader, const String& userAgent)
+    : m_url(url.isolatedCopy())
+    , m_loader(WTF::move(loader))
+    , m_userAgent(userAgent.isolatedCopy())
+    , m_shared(FFmpegIOShared::create())
+{
+}
+
+FFmpegDemuxer::~FFmpegDemuxer()
+{
+    // The thread holds a reference, so it has finished by now.
+    ASSERT(!m_context);
+}
+
+void FFmpegDemuxer::start()
+{
+    ASSERT(isMainThread());
+    if (m_thread)
+        return;
+    m_thread = Thread::create("FFmpegDemuxer"_s, [protectedThis = Ref { *this }] {
+        protectedThis->run();
+    });
+}
+
+void FFmpegDemuxer::stop()
+{
+    ASSERT(isMainThread());
+    m_shared->aborted = true;
+    m_videoQueue.abort();
+    m_audioQueue.abort();
+    {
+        Locker locker { m_lock };
+        m_condition.notifyAll();
+    }
+    if (RefPtr thread = std::exchange(m_thread, nullptr))
+        thread->waitForCompletion();
+}
+
+FFmpegDemuxer::Status FFmpegDemuxer::status() const
+{
+    Status status;
+    Locker locker { m_lock };
+    status.state = m_state;
+    status.failure = m_failure;
+    status.endOfStream = m_endOfStream;
+    status.readerWaiting = m_readerWaiting;
+    status.bytesReceived = m_shared->bytesReceived;
+    status.buffered = m_buffered;
+    return status;
+}
+
+void FFmpegDemuxer::seek(double time, unsigned serial)
+{
+    Locker locker { m_lock };
+    m_pendingSeek = std::make_pair(time, serial);
+    m_endOfStream = false;
+    m_condition.notifyAll();
+}
+
+int FFmpegDemuxer::interruptCallback(void* opaque)
+{
+    return static_cast<FFmpegDemuxer*>(opaque)->m_shared->aborted ? 1 : 0;
+}
+
+bool FFmpegDemuxer::usesResourceLoader(const URL& url) const
+{
+    // Everything WebCore can load goes through its loader (cookies, CORS,
+    // CSP, blob: URLs). Compound URLs such as HLS "crypto+https://" (AES-128
+    // segments) use ffmpeg's own protocols: no cookies there.
+    return url.isValid() && (url.protocolIsInHTTPFamily() || url.protocolIsBlob() || url.protocolIsFile() || url.protocolIsData());
+}
+
+int FFmpegDemuxer::ioOpen(AVFormatContext* context, AVIOContext** pb, const char* url, int flags, AVDictionary** options)
+{
+    auto* demuxer = static_cast<FFmpegDemuxer*>(context->opaque);
+    URL parsed { String::fromUTF8(url) };
+    if (!(flags & AVIO_FLAG_WRITE) && demuxer->usesResourceLoader(parsed)) {
+        auto stream = FFmpegResourceStream::create(demuxer->m_loader.copyRef(), parsed, demuxer->m_shared.copyRef());
+        int result = stream->open();
+        if (result < 0) {
+            stream->close();
+            return result;
+        }
+        *pb = FFmpegResourceStream::createAVIOContext(WTF::move(stream));
+        return *pb ? 0 : AVERROR(ENOMEM);
+    }
+    if (!demuxer->m_defaultIoOpen)
+        return AVERROR(ENOSYS);
+    return demuxer->m_defaultIoOpen(context, pb, url, flags, options);
+}
+
+int FFmpegDemuxer::ioClose(AVFormatContext* context, AVIOContext* pb)
+{
+    if (FFmpegResourceStream::isOurAVIOContext(pb)) {
+        FFmpegResourceStream::destroyAVIOContext(pb);
+        return 0;
+    }
+    auto* demuxer = static_cast<FFmpegDemuxer*>(context->opaque);
+    if (demuxer && demuxer->m_defaultIoClose)
+        return demuxer->m_defaultIoClose(context, pb);
+    return 0;
+}
+
+void FFmpegDemuxer::fail(FFmpegMedia::LoadFailure failure)
+{
+    m_videoQueue.abort();
+    m_audioQueue.abort();
+    Locker locker { m_lock };
+    m_state = State::Failed;
+    if (m_failure == FFmpegMedia::LoadFailure::None)
+        m_failure = failure;
+}
+
+void FFmpegDemuxer::run()
+{
+    if (openInput()) {
+        selectStreams();
+        if (!m_video.parameters && !m_audio.parameters) {
+            LOG(Media, "FFmpegDemuxer: no decodable stream in %s", m_url.string().utf8().legacyCStringPointer());
+            fail(FFmpegMedia::LoadFailure::Open);
+        } else {
+            {
+                Locker locker { m_lock };
+                m_state = State::Ready;
+            }
+            readLoop();
+        }
+    }
+    closeInput();
+}
+
+bool FFmpegDemuxer::openInput()
+{
+    m_context = avformat_alloc_context();
+    if (!m_context) {
+        fail(FFmpegMedia::LoadFailure::Open);
+        return false;
+    }
+    m_context->interrupt_callback.callback = interruptCallback;
+    m_context->interrupt_callback.opaque = this;
+    m_context->opaque = this;
+    m_defaultIoOpen = m_context->io_open;
+    m_defaultIoClose = m_context->io_close2;
+    m_context->io_open = ioOpen;
+    m_context->io_close2 = ioClose;
+
+    if (usesResourceLoader(m_url)) {
+        // The top-level context is custom I/O: avformat_close_input() would
+        // free a non-custom pb with avio_close(), which assumes a URLContext.
+        auto stream = FFmpegResourceStream::create(m_loader.copyRef(), m_url, m_shared.copyRef());
+        int result = stream->open();
+        if (result < 0) {
+            stream->close();
+            if (!m_shared->aborted)
+                fail(FFmpegMedia::LoadFailure::Network);
+            return false;
+        }
+        m_topLevelIO = FFmpegResourceStream::createAVIOContext(WTF::move(stream));
+        if (!m_topLevelIO) {
+            fail(FFmpegMedia::LoadFailure::Open);
+            return false;
+        }
+        m_context->pb = m_topLevelIO;
+        m_context->flags |= AVFMT_FLAG_CUSTOM_IO;
+    }
+
+    AVDictionary* options = nullptr;
+    // hls: our AVIOContexts are not ffmpeg http contexts, so connection reuse
+    // (which pokes at URLContext internals) must stay off.
+    av_dict_set(&options, "http_persistent", "0", 0);
+    av_dict_set(&options, "http_multiple", "0", 0);
+    // Only used by ffmpeg's own protocols (see usesResourceLoader()).
+    if (!m_userAgent.isEmpty())
+        av_dict_set(&options, "user_agent", m_userAgent.utf8().legacyCStringPointer(), 0);
+
+    auto urlString = m_url.string().utf8();
+    int result = avformat_open_input(&m_context, urlString.legacyCStringPointer(), nullptr, &options);
+    av_dict_free(&options);
+    if (result < 0) {
+        // avformat_open_input() freed the context on failure.
+        m_context = nullptr;
+        if (!m_shared->aborted) {
+            LOG(Media, "FFmpegDemuxer: avformat_open_input failed: %s", ffmpegErrorString(result).utf8().legacyCStringPointer());
+            fail(m_shared->networkError ? FFmpegMedia::LoadFailure::Network : FFmpegMedia::LoadFailure::Open);
+        }
+        return false;
+    }
+
+    m_isHLS = m_context->iformat && m_context->iformat->name && strstr(m_context->iformat->name, "hls");
+    result = avformat_find_stream_info(m_context, nullptr);
+    if (result < 0 && !m_shared->aborted)
+        LOG(Media, "FFmpegDemuxer: avformat_find_stream_info: %s", ffmpegErrorString(result).utf8().legacyCStringPointer());
+    if (m_shared->aborted)
+        return false;
+
+    if (m_context->duration != AV_NOPTS_VALUE && m_context->duration > 0)
+        m_duration = m_context->duration / static_cast<double>(AV_TIME_BASE);
+    else {
+        // HLS without #EXT-X-ENDLIST, Icecast, live WebM: unbounded.
+        m_duration = std::numeric_limits<double>::infinity();
+        m_isLive = true;
+    }
+    bool ioSeekable = !m_context->pb || (m_context->pb->seekable & AVIO_SEEKABLE_NORMAL) || m_isHLS;
+    m_isSeekable = !m_isLive && ioSeekable && !(m_context->ctx_flags & AVFMTCTX_UNSEEKABLE);
+    return true;
+}
+
+void FFmpegDemuxer::selectStreams()
+{
+    double startTime = m_context->start_time != AV_NOPTS_VALUE ? m_context->start_time / static_cast<double>(AV_TIME_BASE) : 0;
+
+    // Video: prefer the highest bit rate at or below 1080p (HLS exposes every
+    // variant as a stream; there is no adaptive switching).
+    int videoIndex = -1;
+    bool bestFits = false;
+    int64_t bestRate = -1;
+    int bestHeight = 0;
+    for (unsigned i = 0; i < m_context->nb_streams; ++i) {
+        AVStream* stream = m_context->streams[i];
+        auto* parameters = stream->codecpar;
+        if (parameters->codec_type != AVMEDIA_TYPE_VIDEO || (stream->disposition & AV_DISPOSITION_ATTACHED_PIC))
+            continue;
+        if (!findSoftwareDecoder(parameters->codec_id))
+            continue;
+        bool fits = parameters->width <= maxVideoWidth && parameters->height <= maxVideoHeight;
+        int64_t rate = streamBitRate(stream);
+        bool better;
+        if (videoIndex < 0)
+            better = true;
+        else if (fits != bestFits)
+            better = fits;
+        else if (fits)
+            better = rate > bestRate || (rate == bestRate && parameters->height > bestHeight);
+        else
+            better = parameters->height < bestHeight;
+        if (better) {
+            videoIndex = static_cast<int>(i);
+            bestFits = fits;
+            bestRate = rate;
+            bestHeight = parameters->height;
+        }
+    }
+
+    int audioIndex = av_find_best_stream(m_context, AVMEDIA_TYPE_AUDIO, -1, videoIndex, nullptr, 0);
+    if (audioIndex >= 0 && !findSoftwareDecoder(m_context->streams[audioIndex]->codecpar->codec_id))
+        audioIndex = -1;
+
+    auto fill = [&](FFmpegStreamInfo& info, FFmpegPacketQueue& queue, int index) {
+        if (index < 0)
+            return;
+        AVStream* stream = m_context->streams[index];
+        AVCodecParametersPtr parameters(avcodec_parameters_alloc());
+        if (!parameters || avcodec_parameters_copy(parameters.get(), stream->codecpar) < 0)
+            return;
+        info.index = index;
+        info.timeBase = stream->time_base;
+        info.startTime = startTime;
+        info.parameters = WTF::move(parameters);
+        queue.setTimeBase(stream->time_base);
+        queue.setEnabled(true);
+    };
+    fill(m_video, m_videoQueue, videoIndex);
+    fill(m_audio, m_audioQueue, audioIndex);
+
+    for (unsigned i = 0; i < m_context->nb_streams; ++i) {
+        if (static_cast<int>(i) != m_video.index && static_cast<int>(i) != m_audio.index)
+            m_context->streams[i]->discard = AVDISCARD_ALL;
+    }
+}
+
+void FFmpegDemuxer::performSeek(double time, unsigned serial)
+{
+    double startTime = m_video.index >= 0 ? m_video.startTime : m_audio.startTime;
+    int64_t target = static_cast<int64_t>((time + startTime) * AV_TIME_BASE);
+    // Land on the keyframe at or before the target; the decoders discard
+    // what precedes the target (accurate seek).
+    int result = avformat_seek_file(m_context, -1, std::numeric_limits<int64_t>::min(), target, target, 0);
+    if (result < 0)
+        LOG(Media, "FFmpegDemuxer: seek to %.3f failed: %s", time, ffmpegErrorString(result).utf8().legacyCStringPointer());
+    m_serial = serial;
+    m_videoQueue.flush(serial);
+    m_audioQueue.flush(serial);
+    m_segmentStart = time;
+}
+
+void FFmpegDemuxer::readLoop()
+{
+    AVPacketPtr packet(av_packet_alloc());
+    if (!packet) {
+        fail(FFmpegMedia::LoadFailure::Open);
+        return;
+    }
+    unsigned consecutiveErrors = 0;
+    const FFmpegStreamInfo& primary = m_video.index >= 0 ? m_video : m_audio;
+
+    while (!m_shared->aborted) {
+        std::optional<std::pair<double, unsigned>> seekRequest;
+        bool shouldWait;
+        {
+            Locker locker { m_lock };
+            seekRequest = std::exchange(m_pendingSeek, std::nullopt);
+            shouldWait = !seekRequest && (m_endOfStream
+                || FFmpegMedia::demuxerShouldWait(m_videoQueue.bytes() + m_audioQueue.bytes(), m_videoQueue.level(), m_audioQueue.level()));
+            m_readerWaiting = shouldWait;
+            if (shouldWait) {
+                m_condition.waitFor(m_lock, idlePollInterval);
+                continue;
+            }
+        }
+        if (seekRequest) {
+            performSeek(seekRequest->first, seekRequest->second);
+            consecutiveErrors = 0;
+            continue;
+        }
+
+        int result = av_read_frame(m_context, packet.get());
+        if (result < 0) {
+            if (result == AVERROR_EXIT || m_shared->aborted)
+                break;
+            bool endOfFile = result == AVERROR_EOF || (m_context->pb && avio_feof(m_context->pb));
+            if (!endOfFile && ++consecutiveErrors < maxConsecutiveReadErrors) {
+                Locker locker { m_lock };
+                m_condition.waitFor(m_lock, 10_ms);
+                continue;
+            }
+            m_videoQueue.pushEndOfStream(m_serial);
+            m_audioQueue.pushEndOfStream(m_serial);
+            Locker locker { m_lock };
+            m_endOfStream = true;
+            if (m_shared->networkError && !endOfFile && m_failure == FFmpegMedia::LoadFailure::None)
+                m_failure = FFmpegMedia::LoadFailure::Network;
+            continue;
+        }
+        consecutiveErrors = 0;
+
+        FFmpegPacketQueue* queue = nullptr;
+        if (packet->stream_index == m_video.index)
+            queue = &m_videoQueue;
+        else if (packet->stream_index == m_audio.index)
+            queue = &m_audioQueue;
+        if (!queue) {
+            av_packet_unref(packet.get());
+            continue;
+        }
+
+        if (packet->stream_index == primary.index) {
+            int64_t timestamp = packet->pts != AV_NOPTS_VALUE ? packet->pts : packet->dts;
+            double start = primary.toSeconds(timestamp);
+            if (std::isfinite(start)) {
+                double end = start + std::max<int64_t>(packet->duration, 0) * av_q2d(primary.timeBase);
+                Locker locker { m_lock };
+                m_buffered.add(std::min(m_segmentStart, start), std::max(end, start + 0.001));
+            }
+        }
+
+        AVPacketPtr queued(av_packet_alloc());
+        if (!queued)
+            break;
+        av_packet_move_ref(queued.get(), packet.get());
+        queue->push(WTF::move(queued), m_serial);
+    }
+}
+
+void FFmpegDemuxer::closeInput()
+{
+    if (m_context)
+        avformat_close_input(&m_context);
+    m_context = nullptr;
+    // Custom top-level I/O is not closed by avformat_close_input().
+    if (m_topLevelIO) {
+        FFmpegResourceStream::destroyAVIOContext(m_topLevelIO);
+        m_topLevelIO = nullptr;
+    }
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegDemuxer.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegDemuxer.h
new file mode 100644
index 0000000..4db9a20
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegDemuxer.h
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Demuxer of the ffmpeg media engine: one thread that opens the resource
+// with libavformat (progressive MP4/WebM/MP3/Ogg/..., and HLS through
+// libavformat's hls demuxer), selects one video and one audio stream and
+// fills a packet queue per stream. Seeks are requested asynchronously and
+// tagged with a serial number that flows through the queues to the decoders,
+// so stale packets and frames are recognised and dropped.
+
+#pragma once
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "FFmpegPlaybackPolicy.h"
+#include "FFmpegResourceIO.h"
+#include "FFmpegTimeRanges.h"
+#include "FFmpegUtilities.h"
+#include <atomic>
+#include <optional>
+#include <wtf/Condition.h>
+#include <wtf/Deque.h>
+#include <wtf/Lock.h>
+#include <wtf/Seconds.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/Threading.h>
+#include <wtf/URL.h>
+
+namespace WebCore {
+
+class PlatformMediaResourceLoader;
+
+class FFmpegPacketQueue {
+    WTF_MAKE_NONCOPYABLE(FFmpegPacketQueue);
+public:
+    FFmpegPacketQueue() = default;
+
+    struct Entry {
+        AVPacketPtr packet; // null: end of stream for `serial`
+        unsigned serial { 0 };
+        bool isEndOfStream() const { return !packet; }
+    };
+
+    void setTimeBase(AVRational timeBase) { m_timeBase = timeBase; }
+    void setEnabled(bool enabled) { m_enabled = enabled; }
+    bool enabled() const { return m_enabled; }
+
+    void push(AVPacketPtr&&, unsigned serial);
+    void pushEndOfStream(unsigned serial);
+    // Waits up to `timeout`. Returns nullopt on timeout or abort.
+    std::optional<Entry> pop(Seconds timeout);
+    void flush(unsigned newSerial);
+    void abort();
+
+    bool isAborted() const { return m_aborted; }
+    unsigned serial() const { return m_serial; }
+    FFmpegMedia::QueueLevel level() const;
+    size_t bytes() const;
+
+private:
+    mutable Lock m_lock;
+    Condition m_condition;
+    Deque<Entry> m_entries WTF_GUARDED_BY_LOCK(m_lock);
+    size_t m_bytes WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    int64_t m_lastTimestamp WTF_GUARDED_BY_LOCK(m_lock) { AV_NOPTS_VALUE };
+    AVRational m_timeBase { 1, 1 };
+    std::atomic<unsigned> m_serial { 0 };
+    std::atomic<bool> m_aborted { false };
+    bool m_enabled { false };
+};
+
+class FFmpegDemuxer final : public ThreadSafeRefCounted<FFmpegDemuxer> {
+public:
+    static Ref<FFmpegDemuxer> create(const URL&, Ref<PlatformMediaResourceLoader>&&, const String& userAgent);
+    ~FFmpegDemuxer();
+
+    void start();
+    // Aborts all I/O and joins the thread. Idempotent; main thread.
+    void stop();
+
+    enum class State : uint8_t { Opening, Ready, Failed };
+    struct Status {
+        State state { State::Opening };
+        FFmpegMedia::LoadFailure failure { FFmpegMedia::LoadFailure::None };
+        bool endOfStream { false };
+        bool readerWaiting { false };
+        uint64_t bytesReceived { 0 };
+        FFmpegMedia::TimeRangeSet buffered;
+    };
+    Status status() const;
+
+    // Valid once status().state == Ready; immutable from then on.
+    const FFmpegStreamInfo* videoStream() const { return m_video.index >= 0 ? &m_video : nullptr; }
+    const FFmpegStreamInfo* audioStream() const { return m_audio.index >= 0 ? &m_audio : nullptr; }
+    // NaN while unknown, +infinity for live streams.
+    double duration() const { return m_duration; }
+    bool isLive() const { return m_isLive; }
+    bool isSeekable() const { return m_isSeekable; }
+    bool isHLS() const { return m_isHLS; }
+    bool didPassAccessControlCheck() const { return m_shared->sawResponse && m_shared->didPassAccessControlCheck; }
+
+    FFmpegPacketQueue& videoQueue() { return m_videoQueue; }
+    FFmpegPacketQueue& audioQueue() { return m_audioQueue; }
+
+    // Main thread. Packets demuxed after the seek carry `serial`.
+    void seek(double time, unsigned serial);
+
+private:
+    FFmpegDemuxer(const URL&, Ref<PlatformMediaResourceLoader>&&, const String& userAgent);
+
+    void run();
+    bool openInput();
+    void selectStreams();
+    void readLoop();
+    void performSeek(double time, unsigned serial);
+    void fail(FFmpegMedia::LoadFailure);
+    void closeInput();
+    bool usesResourceLoader(const URL&) const;
+
+    static int interruptCallback(void*);
+    static int ioOpen(AVFormatContext*, AVIOContext**, const char* url, int flags, AVDictionary** options);
+    static int ioClose(AVFormatContext*, AVIOContext*);
+
+    const URL m_url;
+    const Ref<PlatformMediaResourceLoader> m_loader;
+    const String m_userAgent;
+    const Ref<FFmpegIOShared> m_shared;
+    RefPtr<Thread> m_thread;
+
+    // Demuxer thread only.
+    AVFormatContext* m_context { nullptr };
+    AVIOContext* m_topLevelIO { nullptr };
+    int (*m_defaultIoOpen)(AVFormatContext*, AVIOContext**, const char*, int, AVDictionary**) { nullptr };
+    int (*m_defaultIoClose)(AVFormatContext*, AVIOContext*) { nullptr };
+    unsigned m_serial { 0 };
+    double m_segmentStart { 0 };
+
+    // Written by the demuxer thread before State::Ready is published.
+    FFmpegStreamInfo m_video;
+    FFmpegStreamInfo m_audio;
+    double m_duration { std::numeric_limits<double>::quiet_NaN() };
+    bool m_isLive { false };
+    bool m_isSeekable { false };
+    bool m_isHLS { false };
+
+    FFmpegPacketQueue m_videoQueue;
+    FFmpegPacketQueue m_audioQueue;
+
+    mutable Lock m_lock;
+    Condition m_condition;
+    State m_state WTF_GUARDED_BY_LOCK(m_lock) { State::Opening };
+    FFmpegMedia::LoadFailure m_failure WTF_GUARDED_BY_LOCK(m_lock) { FFmpegMedia::LoadFailure::None };
+    bool m_endOfStream WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_readerWaiting WTF_GUARDED_BY_LOCK(m_lock) { false };
+    FFmpegMedia::TimeRangeSet m_buffered WTF_GUARDED_BY_LOCK(m_lock);
+    std::optional<std::pair<double, unsigned>> m_pendingSeek WTF_GUARDED_BY_LOCK(m_lock);
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegPlaybackPolicy.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegPlaybackPolicy.h
new file mode 100644
index 0000000..2b86ed7
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegPlaybackPolicy.h
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Buffering thresholds and the HTML readyState/networkState decisions of the
+// ffmpeg media engine, as pure functions so they can be unit tested and
+// reused by a future MSE player.
+
+#pragma once
+
+#include <cstddef>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+// Demuxer read-ahead limits. Reading pauses (networkState IDLE) when either
+// the total queued bytes reach maxQueuedBytes or every enabled stream has at
+// least maxQueuedSeconds queued; it resumes once that is no longer true.
+inline constexpr size_t maxQueuedBytes = 48u << 20;
+inline constexpr double maxQueuedSeconds = 15.0;
+// A stream with fewer packets than this is never considered "full" (sparse
+// streams or broken durations must not stall the other stream).
+inline constexpr size_t minQueuedPackets = 25;
+
+struct QueueLevel {
+    bool enabled { false };
+    size_t packets { 0 };
+    double seconds { 0 };
+};
+
+inline bool streamHasEnough(const QueueLevel& queue)
+{
+    return !queue.enabled || (queue.packets >= minQueuedPackets && queue.seconds >= maxQueuedSeconds);
+}
+
+inline bool demuxerShouldWait(size_t totalBytes, const QueueLevel& video, const QueueLevel& audio)
+{
+    if (totalBytes >= maxQueuedBytes)
+        return true;
+    if (!video.enabled && !audio.enabled)
+        return false;
+    return streamHasEnough(video) && streamHasEnough(audio);
+}
+
+// Thresholds on contiguous data ahead of the current position.
+inline constexpr double futureDataSeconds = 0.3;
+inline constexpr double enoughDataSeconds = 3.0;
+
+// Mirrors MediaPlayer::ReadyState without depending on WebCore.
+enum class ReadyLevel { HaveNothing, HaveMetadata, HaveCurrentData, HaveFutureData, HaveEnoughData };
+
+struct ReadyInputs {
+    bool metadataLoaded { false };
+    bool seeking { false };
+    // A frame for the current position is decoded (or, for audio-only media,
+    // decoded audio is queued for it).
+    bool currentDataAvailable { false };
+    double bufferedAheadSeconds { 0 };
+    // The demuxer has delivered everything (end of stream).
+    bool endOfStream { false };
+};
+
+inline ReadyLevel computeReadyLevel(const ReadyInputs& in)
+{
+    if (!in.metadataLoaded)
+        return ReadyLevel::HaveNothing;
+    if (in.seeking || !in.currentDataAvailable)
+        return ReadyLevel::HaveMetadata;
+    if (in.endOfStream || in.bufferedAheadSeconds >= enoughDataSeconds)
+        return ReadyLevel::HaveEnoughData;
+    if (in.bufferedAheadSeconds >= futureDataSeconds)
+        return ReadyLevel::HaveFutureData;
+    return ReadyLevel::HaveCurrentData;
+}
+
+// Mirrors MediaPlayer::NetworkState.
+enum class NetworkLevel { Empty, Idle, Loading, Loaded, FormatError, NetworkError, DecodeError };
+
+enum class LoadFailure { None, Open, Network, Decode };
+
+struct NetworkInputs {
+    bool started { false };
+    bool metadataLoaded { false };
+    LoadFailure failure { LoadFailure::None };
+    bool endOfStream { false };
+    bool readerWaiting { false };
+};
+
+inline NetworkLevel computeNetworkLevel(const NetworkInputs& in)
+{
+    switch (in.failure) {
+    case LoadFailure::Open:
+        // Nothing usable was found: the resource is not a playable format
+        // (or could not be fetched at all, which HTML reports the same way
+        // before metadata).
+        return in.metadataLoaded ? NetworkLevel::NetworkError : NetworkLevel::FormatError;
+    case LoadFailure::Network:
+        return in.metadataLoaded ? NetworkLevel::NetworkError : NetworkLevel::FormatError;
+    case LoadFailure::Decode:
+        return NetworkLevel::DecodeError;
+    case LoadFailure::None:
+        break;
+    }
+    if (!in.started)
+        return NetworkLevel::Idle;
+    if (in.endOfStream)
+        return NetworkLevel::Loaded;
+    if (in.readerWaiting && in.metadataLoaded)
+        return NetworkLevel::Idle;
+    return NetworkLevel::Loading;
+}
+
+} // namespace FFmpegMedia
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegResourceIO.cpp b/Source/WebCore/platform/graphics/ffmpeg/FFmpegResourceIO.cpp
new file mode 100644
index 0000000..41879e9
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegResourceIO.cpp
@@ -0,0 +1,487 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "config.h"
+#include "FFmpegResourceIO.h"
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "HTTPHeaderNames.h"
+#include "HTTPStatusCodes.h"
+#include "PlatformMediaResourceLoader.h"
+#include "ResourceError.h"
+#include "ResourceRequest.h"
+#include "ResourceResponse.h"
+#include "SharedBuffer.h"
+#include <wtf/MainThread.h>
+#include <wtf/text/MakeString.h>
+#include <wtf/text/StringToIntegerConversion.h>
+
+extern "C" {
+#include <libavformat/avio.h>
+#include <libavutil/error.h>
+#include <libavutil/mem.h>
+}
+
+namespace WebCore {
+
+namespace {
+
+// Network read-ahead per stream: the request is cancelled above the high
+// water mark and resumed with a Range request below the low one. Servers
+// without range support are never suspended (they cannot be resumed).
+constexpr uint64_t highWaterBytes = 16u << 20;
+constexpr uint64_t lowWaterBytes = 4u << 20;
+// Already-read data kept for the short backward seeks demuxers do.
+constexpr uint64_t historyBytes = 512u << 10;
+// A forward seek this close to the received data waits for it instead of
+// issuing a new request.
+constexpr uint64_t forwardWaitBytes = 512u << 10;
+// Received data is coalesced into chunks of about this size.
+constexpr size_t chunkCoalesceBytes = 256u << 10;
+constexpr Seconds pollInterval = 50_ms;
+constexpr int avioBufferSize = 64 * 1024;
+
+class StreamClient final : public PlatformMediaResourceClient {
+public:
+    static Ref<StreamClient> create(Ref<FFmpegResourceStream>&& stream, unsigned requestId)
+    {
+        return adoptRef(*new StreamClient(WTF::move(stream), requestId));
+    }
+
+private:
+    StreamClient(Ref<FFmpegResourceStream>&& stream, unsigned requestId)
+        : m_stream(WTF::move(stream))
+        , m_requestId(requestId)
+    {
+    }
+
+    void responseReceived(PlatformMediaResource& resource, const ResourceResponse& response, CompletionHandler<void(ShouldContinuePolicyCheck)>&& completionHandler) final
+    {
+        bool shouldContinue = true;
+        m_stream->didReceiveResponse(m_requestId, response, resource.didPassAccessControlCheck(), shouldContinue);
+        completionHandler(shouldContinue ? ShouldContinuePolicyCheck::Yes : ShouldContinuePolicyCheck::No);
+    }
+
+    bool shouldCacheResponse(PlatformMediaResource&, const ResourceResponse&) final { return false; }
+    void dataReceived(PlatformMediaResource&, const SharedBuffer& buffer) final { m_stream->didReceiveData(m_requestId, buffer.span()); }
+    void accessControlCheckFailed(PlatformMediaResource&, const ResourceError&) final { m_stream->didFail(m_requestId, true); }
+    void loadFailed(PlatformMediaResource&, const ResourceError&) final { m_stream->didFail(m_requestId, false); }
+    void loadFinished(PlatformMediaResource&, const NetworkLoadMetrics&) final { m_stream->didFinish(m_requestId); }
+
+    const Ref<FFmpegResourceStream> m_stream;
+    const unsigned m_requestId;
+};
+
+// "bytes 0-99/1234" -> 1234; -1 when absent or "*".
+int64_t totalFromContentRange(const String& contentRange)
+{
+    size_t slash = contentRange.find('/');
+    if (slash == notFound)
+        return -1;
+    auto total = parseIntegerAllowingTrailingJunk<uint64_t>(StringView(contentRange).substring(slash + 1));
+    return total ? static_cast<int64_t>(*total) : -1;
+}
+
+int readPacketCallback(void* opaque, uint8_t* buffer, int size)
+{
+    return static_cast<FFmpegResourceStream*>(opaque)->read(buffer, size);
+}
+
+int64_t seekCallback(void* opaque, int64_t offset, int whence)
+{
+    return static_cast<FFmpegResourceStream*>(opaque)->seek(offset, whence);
+}
+
+} // namespace
+
+Ref<FFmpegResourceStream> FFmpegResourceStream::create(Ref<PlatformMediaResourceLoader>&& loader, const URL& url, Ref<FFmpegIOShared>&& shared)
+{
+    return adoptRef(*new FFmpegResourceStream(WTF::move(loader), url, WTF::move(shared)));
+}
+
+FFmpegResourceStream::FFmpegResourceStream(Ref<PlatformMediaResourceLoader>&& loader, const URL& url, Ref<FFmpegIOShared>&& shared)
+    : m_loader(WTF::move(loader))
+    , m_url(url.isolatedCopy())
+    , m_shared(WTF::move(shared))
+{
+}
+
+FFmpegResourceStream::~FFmpegResourceStream()
+{
+    Locker locker { m_lock };
+    stopResourceLocked();
+}
+
+AVIOContext* FFmpegResourceStream::createAVIOContext(Ref<FFmpegResourceStream>&& stream)
+{
+    auto* buffer = static_cast<unsigned char*>(av_malloc(avioBufferSize));
+    if (!buffer)
+        return nullptr;
+    bool seekable;
+    {
+        Locker locker { stream->m_lock };
+        seekable = stream->m_size > 0;
+    }
+    auto* rawStream = &stream.leakRef();
+    AVIOContext* context = avio_alloc_context(buffer, avioBufferSize, 0, rawStream, readPacketCallback, nullptr, seekCallback);
+    if (!context) {
+        av_free(buffer);
+        rawStream->close();
+        rawStream->deref();
+        return nullptr;
+    }
+    // Servers without Range support stay seekable: a seek restarts the
+    // download and skips to the target, which is slow but correct (an MP4
+    // with the moov atom at the end needs it).
+    context->seekable = seekable ? AVIO_SEEKABLE_NORMAL : 0;
+    return context;
+}
+
+bool FFmpegResourceStream::isOurAVIOContext(const AVIOContext* context)
+{
+    return context && context->read_packet == readPacketCallback;
+}
+
+void FFmpegResourceStream::destroyAVIOContext(AVIOContext* context)
+{
+    if (!context)
+        return;
+    if (auto* stream = static_cast<FFmpegResourceStream*>(context->opaque)) {
+        stream->close();
+        stream->deref();
+    }
+    av_freep(&context->buffer);
+    avio_context_free(&context);
+}
+
+int FFmpegResourceStream::open()
+{
+    Locker locker { m_lock };
+    startRequestLocked(0, false);
+    while (m_state == RequestState::Pending) {
+        if (m_shared->aborted || m_closed)
+            return AVERROR_EXIT;
+        m_condition.waitFor(m_lock, pollInterval);
+    }
+    if (m_state == RequestState::Failed)
+        return AVERROR(EIO);
+    return 0;
+}
+
+uint64_t FFmpegResourceStream::bufferStartLocked() const
+{
+    return m_chunks.isEmpty() ? m_requestPosition : m_chunks.first().position;
+}
+
+uint64_t FFmpegResourceStream::bufferEndLocked() const
+{
+    return m_chunks.isEmpty() ? m_requestPosition : m_chunks.last().end();
+}
+
+size_t FFmpegResourceStream::copyOutLocked(uint8_t* out, size_t size)
+{
+    size_t copied = 0;
+    for (auto& chunk : m_chunks) {
+        if (copied == size)
+            break;
+        if (m_readPosition < chunk.position || m_readPosition >= chunk.end())
+            continue;
+        size_t offset = static_cast<size_t>(m_readPosition - chunk.position);
+        size_t count = std::min(size - copied, chunk.data.size() - offset);
+        memcpy(out + copied, chunk.data.span().subspan(offset, count).data(), count);
+        copied += count;
+        m_readPosition += count;
+    }
+    return copied;
+}
+
+void FFmpegResourceStream::trimHistoryLocked()
+{
+    while (m_chunks.size() > 1 && m_chunks.first().end() + historyBytes <= m_readPosition)
+        m_chunks.removeFirst();
+}
+
+bool FFmpegResourceStream::waitLocked()
+{
+    if (m_shared->aborted || m_closed)
+        return false;
+    m_condition.waitFor(m_lock, pollInterval);
+    return !(m_shared->aborted || m_closed);
+}
+
+int FFmpegResourceStream::read(uint8_t* buffer, int size)
+{
+    if (size <= 0)
+        return 0;
+    Locker locker { m_lock };
+    while (true) {
+        if (m_shared->aborted || m_closed)
+            return AVERROR_EXIT;
+
+        uint64_t start = bufferStartLocked();
+        uint64_t end = bufferEndLocked();
+        if (m_readPosition >= start && m_readPosition < end) {
+            size_t copied = copyOutLocked(buffer, static_cast<size_t>(size));
+            trimHistoryLocked();
+            if (m_state == RequestState::Suspended && bufferEndLocked() - m_readPosition < lowWaterBytes)
+                startRequestLocked(bufferEndLocked(), true);
+            return static_cast<int>(copied);
+        }
+
+        if (m_size >= 0 && m_readPosition >= static_cast<uint64_t>(m_size))
+            return AVERROR_EOF;
+
+        bool inReach = m_readPosition >= start && m_readPosition <= end + forwardWaitBytes;
+        switch (m_state) {
+        case RequestState::None:
+            startRequestLocked(m_readPosition, false);
+            break;
+        case RequestState::Pending:
+        case RequestState::Receiving:
+            if (!inReach)
+                startRequestLocked(m_readPosition, false);
+            break;
+        case RequestState::Finished:
+            if (inReach)
+                return AVERROR_EOF;
+            startRequestLocked(m_readPosition, false);
+            break;
+        case RequestState::Failed:
+            return AVERROR(EIO);
+        case RequestState::Suspended:
+            startRequestLocked(m_readPosition, m_readPosition == end);
+            break;
+        }
+        if (!waitLocked())
+            return AVERROR_EXIT;
+    }
+}
+
+int64_t FFmpegResourceStream::seek(int64_t offset, int whence)
+{
+    Locker locker { m_lock };
+    if (whence & AVSEEK_SIZE) {
+        while (m_state == RequestState::Pending || m_state == RequestState::None) {
+            if (m_state == RequestState::None)
+                startRequestLocked(m_readPosition, false);
+            if (!waitLocked())
+                return AVERROR_EXIT;
+        }
+        return m_size >= 0 ? m_size : AVERROR(ENOSYS);
+    }
+
+    int64_t target;
+    switch (whence & ~AVSEEK_FORCE) {
+    case SEEK_SET:
+        target = offset;
+        break;
+    case SEEK_CUR:
+        target = static_cast<int64_t>(m_readPosition) + offset;
+        break;
+    case SEEK_END:
+        if (m_size < 0)
+            return AVERROR(ENOSYS);
+        target = m_size + offset;
+        break;
+    default:
+        return AVERROR(EINVAL);
+    }
+    if (target < 0)
+        return AVERROR(EINVAL);
+    // The request (if one is needed) is issued lazily by the next read().
+    m_readPosition = static_cast<uint64_t>(target);
+    return target;
+}
+
+void FFmpegResourceStream::close()
+{
+    Locker locker { m_lock };
+    m_closed = true;
+    ++m_requestId;
+    stopResourceLocked();
+    m_chunks.clear();
+    m_condition.notifyAll();
+}
+
+void FFmpegResourceStream::startRequestLocked(uint64_t position, bool keepBuffer)
+{
+    stopResourceLocked();
+    if (!keepBuffer)
+        m_chunks.clear();
+    m_requestPosition = position;
+    m_receivedInRequest = 0;
+    m_skipBytes = 0;
+    m_state = RequestState::Pending;
+    unsigned requestId = ++m_requestId;
+    callOnMainThread([protectedThis = Ref { *this }, requestId, position] {
+        protectedThis->dispatchRequest(requestId, position);
+    });
+}
+
+void FFmpegResourceStream::dispatchRequest(unsigned requestId, uint64_t position)
+{
+    ASSERT(isMainThread());
+    {
+        Locker locker { m_lock };
+        if (m_closed || requestId != m_requestId)
+            return;
+    }
+
+    ResourceRequest request { URL { m_url } };
+    request.setAllowCookies(true);
+    if (position)
+        request.setHTTPHeaderField(HTTPHeaderName::Range, makeString("bytes="_s, position, '-'));
+
+    // Never call into the resource while holding m_lock: shutdown() and the
+    // loader may call the client synchronously, which takes m_lock.
+    RefPtr resource = m_loader->requestResource(WTF::move(request), PlatformMediaResourceLoader::LoadOption::DisallowCaching);
+    if (!resource) {
+        Locker locker { m_lock };
+        if (requestId == m_requestId) {
+            m_state = RequestState::Failed;
+            m_shared->networkError = true;
+            m_condition.notifyAll();
+        }
+        return;
+    }
+    resource->setClient(StreamClient::create(Ref { *this }, requestId));
+
+    bool stale;
+    {
+        Locker locker { m_lock };
+        stale = m_closed || requestId != m_requestId;
+        if (!stale)
+            m_resource = resource;
+    }
+    if (stale) {
+        resource->shutdown();
+        resource->setClient(nullptr);
+    }
+}
+
+void FFmpegResourceStream::stopResourceLocked()
+{
+    RefPtr resource = WTF::move(m_resource);
+    if (!resource)
+        return;
+    // Always asynchronous: this runs on the demuxer thread or inside a
+    // resource client callback.
+    callOnMainThread([resource = WTF::move(resource)] {
+        resource->shutdown();
+        resource->setClient(nullptr);
+    });
+}
+
+void FFmpegResourceStream::suspendLocked()
+{
+    ++m_requestId;
+    m_state = RequestState::Suspended;
+    stopResourceLocked();
+}
+
+void FFmpegResourceStream::didReceiveResponse(unsigned requestId, const ResourceResponse& response, bool passedAccessControlCheck, bool& shouldContinue)
+{
+    Locker locker { m_lock };
+    if (m_closed || requestId != m_requestId) {
+        shouldContinue = false;
+        return;
+    }
+
+    bool isHTTP = response.url().protocolIsInHTTPFamily() || m_url.protocolIsInHTTPFamily();
+    int status = response.httpStatusCode();
+    if (isHTTP && status >= httpStatus400BadRequest) {
+        m_state = RequestState::Failed;
+        m_shared->networkError = true;
+        m_condition.notifyAll();
+        shouldContinue = false;
+        return;
+    }
+
+    m_shared->sawResponse = true;
+    if (isHTTP && !passedAccessControlCheck)
+        m_shared->didPassAccessControlCheck = false;
+
+    bool isPartial = isHTTP && status == httpStatus206PartialContent;
+    if (m_requestPosition && !isPartial) {
+        // The server ignored Range and sends the whole body: skip to the
+        // requested position and stop issuing range requests.
+        m_skipBytes = m_requestPosition;
+        m_rangesSupported = false;
+    }
+
+    int64_t length = response.httpHeaderFields().contains(HTTPHeaderName::ContentEncoding) ? -1 : response.expectedContentLength();
+    if (isPartial) {
+        int64_t total = totalFromContentRange(response.httpHeaderField(HTTPHeaderName::ContentRange));
+        if (total > 0)
+            m_size = total;
+        else if (length > 0)
+            m_size = static_cast<int64_t>(m_requestPosition) + length;
+    } else if (length > 0)
+        m_size = length;
+
+    if (isHTTP && equalLettersIgnoringASCIICase(response.httpHeaderField(HTTPHeaderName::AcceptRanges), "none"_s))
+        m_rangesSupported = false;
+
+    m_state = RequestState::Receiving;
+    m_condition.notifyAll();
+}
+
+void FFmpegResourceStream::didReceiveData(unsigned requestId, std::span<const uint8_t> data)
+{
+    Locker locker { m_lock };
+    if (m_closed || requestId != m_requestId)
+        return;
+
+    m_shared->bytesReceived += data.size();
+    if (m_skipBytes) {
+        size_t skipped = static_cast<size_t>(std::min<uint64_t>(m_skipBytes, data.size()));
+        m_skipBytes -= skipped;
+        data = data.subspan(skipped);
+    }
+    if (data.empty())
+        return;
+
+    uint64_t position = m_requestPosition + m_receivedInRequest;
+    m_receivedInRequest += data.size();
+    if (!m_chunks.isEmpty() && m_chunks.last().end() == position && m_chunks.last().data.size() < chunkCoalesceBytes)
+        m_chunks.last().data.append(data);
+    else {
+        Chunk chunk;
+        chunk.position = position;
+        chunk.data.append(data);
+        m_chunks.append(WTF::move(chunk));
+    }
+
+    uint64_t end = bufferEndLocked();
+    if (m_rangesSupported && m_size > 0 && end > m_readPosition && end - m_readPosition > highWaterBytes && end < static_cast<uint64_t>(m_size))
+        suspendLocked();
+    m_condition.notifyAll();
+}
+
+void FFmpegResourceStream::didFinish(unsigned requestId)
+{
+    Locker locker { m_lock };
+    if (m_closed || requestId != m_requestId)
+        return;
+    m_state = RequestState::Finished;
+    // Without Content-Length the size is known once the body is complete.
+    if (m_size < 0 && !m_skipBytes)
+        m_size = static_cast<int64_t>(m_requestPosition + m_receivedInRequest);
+    m_condition.notifyAll();
+}
+
+void FFmpegResourceStream::didFail(unsigned requestId, bool isAccessControlFailure)
+{
+    Locker locker { m_lock };
+    if (m_closed || requestId != m_requestId)
+        return;
+    m_state = RequestState::Failed;
+    m_shared->networkError = true;
+    if (isAccessControlFailure)
+        m_shared->didPassAccessControlCheck = false;
+    m_condition.notifyAll();
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegResourceIO.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegResourceIO.h
new file mode 100644
index 0000000..07c503a
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegResourceIO.h
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Byte-stream input for libavformat backed by WebCore's media resource
+// loader (PlatformMediaResourceLoader), so media requests carry the page's
+// cookies, referrer, CORS mode and CSP checks and share the network process
+// with the rest of the page. The demuxer installs it as the top-level
+// AVIOContext and as AVFormatContext::io_open, which libavformat's HLS
+// demuxer uses for playlists, keys and segments.
+//
+// Threading: read()/seek() run on the demuxer thread and block (polling an
+// abort flag every 50 ms); requests are started on the main thread and the
+// PlatformMediaResourceClient callbacks arrive there. The main thread never
+// waits for the demuxer thread, so the two cannot deadlock.
+
+#pragma once
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include <atomic>
+#include <span>
+#include <wtf/Condition.h>
+#include <wtf/Deque.h>
+#include <wtf/Lock.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/URL.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+struct AVIOContext;
+
+namespace WebCore {
+
+class PlatformMediaResource;
+class PlatformMediaResourceLoader;
+class ResourceResponse;
+
+// State shared by every stream one demuxer opens.
+class FFmpegIOShared : public ThreadSafeRefCounted<FFmpegIOShared> {
+public:
+    static Ref<FFmpegIOShared> create() { return adoptRef(*new FFmpegIOShared); }
+
+    std::atomic<bool> aborted { false };
+    std::atomic<bool> networkError { false };
+    std::atomic<bool> didPassAccessControlCheck { true };
+    std::atomic<bool> sawResponse { false };
+    std::atomic<uint64_t> bytesReceived { 0 };
+
+private:
+    FFmpegIOShared() = default;
+};
+
+class FFmpegResourceStream final : public ThreadSafeRefCounted<FFmpegResourceStream> {
+public:
+    static Ref<FFmpegResourceStream> create(Ref<PlatformMediaResourceLoader>&&, const URL&, Ref<FFmpegIOShared>&&);
+    ~FFmpegResourceStream();
+
+    // Demuxer thread. open() issues the first request and waits for the
+    // response; it returns 0 or a negative AVERROR.
+    int open();
+    int read(uint8_t*, int size);
+    int64_t seek(int64_t offset, int whence);
+    void close();
+
+    // Creates an AVIOContext that owns a reference to `stream`. Returns
+    // nullptr on allocation failure.
+    static AVIOContext* createAVIOContext(Ref<FFmpegResourceStream>&&);
+    static bool isOurAVIOContext(const AVIOContext*);
+    // Closes the stream and frees the context and its buffer.
+    static void destroyAVIOContext(AVIOContext*);
+
+    // Main thread, from the resource client.
+    void didReceiveResponse(unsigned requestId, const ResourceResponse&, bool passedAccessControlCheck, bool& shouldContinue);
+    void didReceiveData(unsigned requestId, std::span<const uint8_t>);
+    void didFinish(unsigned requestId);
+    void didFail(unsigned requestId, bool isAccessControlFailure);
+
+private:
+    FFmpegResourceStream(Ref<PlatformMediaResourceLoader>&&, const URL&, Ref<FFmpegIOShared>&&);
+
+    enum class RequestState : uint8_t { None, Pending, Receiving, Finished, Failed, Suspended };
+
+    struct Chunk {
+        uint64_t position { 0 };
+        Vector<uint8_t> data;
+        uint64_t end() const { return position + data.size(); }
+    };
+
+    void dispatchRequest(unsigned requestId, uint64_t position);
+    void startRequestLocked(uint64_t position, bool keepBuffer) WTF_REQUIRES_LOCK(m_lock);
+    void suspendLocked() WTF_REQUIRES_LOCK(m_lock);
+    void stopResourceLocked() WTF_REQUIRES_LOCK(m_lock);
+    uint64_t bufferStartLocked() const WTF_REQUIRES_LOCK(m_lock);
+    uint64_t bufferEndLocked() const WTF_REQUIRES_LOCK(m_lock);
+    size_t copyOutLocked(uint8_t*, size_t) WTF_REQUIRES_LOCK(m_lock);
+    void trimHistoryLocked() WTF_REQUIRES_LOCK(m_lock);
+    bool waitLocked() WTF_REQUIRES_LOCK(m_lock);
+
+    const Ref<PlatformMediaResourceLoader> m_loader;
+    const URL m_url;
+    const Ref<FFmpegIOShared> m_shared;
+
+    Lock m_lock;
+    Condition m_condition;
+    Deque<Chunk> m_chunks WTF_GUARDED_BY_LOCK(m_lock);
+    uint64_t m_readPosition WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    // Bytes of a 200 response to drop because the server ignored Range.
+    uint64_t m_skipBytes WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    uint64_t m_requestPosition WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    uint64_t m_receivedInRequest WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    int64_t m_size WTF_GUARDED_BY_LOCK(m_lock) { -1 };
+    unsigned m_requestId WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    RequestState m_state WTF_GUARDED_BY_LOCK(m_lock) { RequestState::None };
+    bool m_rangesSupported WTF_GUARDED_BY_LOCK(m_lock) { true };
+    bool m_closed WTF_GUARDED_BY_LOCK(m_lock) { false };
+    RefPtr<PlatformMediaResource> m_resource WTF_GUARDED_BY_LOCK(m_lock);
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegRingBuffer.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegRingBuffer.h
new file mode 100644
index 0000000..51fb904
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegRingBuffer.h
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Fixed-capacity FIFO of interleaved audio samples between the audio decoder
+// thread and the audio sink callback. Not internally synchronised: the owner
+// (FFmpegAudioDecoder) guards it with its lock, which also makes flushes on
+// seek trivially safe. Engine-independent for host unit tests.
+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <vector>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+template<typename T>
+class RingBuffer {
+public:
+    explicit RingBuffer(size_t capacity)
+        : m_buffer(std::max<size_t>(capacity, 1))
+    {
+    }
+
+    size_t capacity() const { return m_buffer.size(); }
+    size_t size() const { return m_size; }
+    size_t freeSpace() const { return capacity() - m_size; }
+    bool isEmpty() const { return !m_size; }
+
+    // Writes up to `count` items, returns how many fit.
+    size_t write(const T* data, size_t count)
+    {
+        count = std::min(count, freeSpace());
+        size_t writePos = (m_readPos + m_size) % capacity();
+        size_t first = std::min(count, capacity() - writePos);
+        std::copy(data, data + first, m_buffer.begin() + writePos);
+        std::copy(data + first, data + count, m_buffer.begin());
+        m_size += count;
+        return count;
+    }
+
+    // Appends `count` copies of `value` (silence), returns how many fit.
+    size_t fill(const T& value, size_t count)
+    {
+        count = std::min(count, freeSpace());
+        size_t writePos = (m_readPos + m_size) % capacity();
+        for (size_t i = 0; i < count; ++i)
+            m_buffer[(writePos + i) % capacity()] = value;
+        m_size += count;
+        return count;
+    }
+
+    // Reads up to `count` items, returns how many were read.
+    size_t read(T* out, size_t count)
+    {
+        count = std::min(count, m_size);
+        size_t first = std::min(count, capacity() - m_readPos);
+        std::copy(m_buffer.begin() + m_readPos, m_buffer.begin() + m_readPos + first, out);
+        std::copy(m_buffer.begin(), m_buffer.begin() + (count - first), out + first);
+        m_readPos = (m_readPos + count) % capacity();
+        m_size -= count;
+        return count;
+    }
+
+    // Drops up to `count` items without copying them out.
+    size_t skip(size_t count)
+    {
+        count = std::min(count, m_size);
+        m_readPos = (m_readPos + count) % capacity();
+        m_size -= count;
+        return count;
+    }
+
+    void clear()
+    {
+        m_readPos = 0;
+        m_size = 0;
+    }
+
+private:
+    std::vector<T> m_buffer;
+    size_t m_readPos { 0 };
+    size_t m_size { 0 };
+};
+
+} // namespace FFmpegMedia
+} // namespace WebCore
