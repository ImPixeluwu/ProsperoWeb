+// ProsperoWeb (console run 33: pages partly rendered in the native title):
+// resource loads started, finished and failed, summarised every 5 s with no
+// per-request logging.
+extern "C" void ps5_log_printf(const char*, ...) __attribute__((weak, format(printf, 1, 2)));
+namespace {
+std::atomic<unsigned> ps5LoadsStarted;
+std::atomic<unsigned> ps5LoadsFinished;
+std::atomic<unsigned> ps5LoadsFailed;
+std::atomic<long long> ps5LoadsWindow;
+void ps5LoadsSummary()
+{
+    timespec ts { };
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    const long long now = ts.tv_sec * 1000LL + ts.tv_nsec / 1000000;
+    long long start = ps5LoadsWindow.load();
+    if (!start) {
+        ps5LoadsWindow.compare_exchange_strong(start, now);
+        return;
+    }
+    if (now - start < 5000 || !ps5LoadsWindow.compare_exchange_strong(start, now))
+        return;
+    const unsigned started = ps5LoadsStarted.exchange(0);
+    const unsigned finished = ps5LoadsFinished.exchange(0);
+    const unsigned failed = ps5LoadsFailed.exchange(0);
+    if (ps5_log_printf && (started || finished || failed))
+        ps5_log_printf("webkit: loads 5s: %u started, %u finished, %u failed", started, finished, failed);
+}
+}
+#endif
+
