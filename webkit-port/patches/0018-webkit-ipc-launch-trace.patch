index 16eb9a0de..14257155c 100644
--- a/Source/WebCore/platform/unix/SharedMemoryUnix.cpp
+++ b/Source/WebCore/platform/unix/SharedMemoryUnix.cpp
@@ -27,6 +27,18 @@
 
 #include "config.h"
 #include "SharedMemory.h"
+#include <atomic>
+
+#if defined(PS5_HOMEBREW) && !defined(PS5_TRACE)
+// ProsperoWeb diagnostics (console run 24: page updates never reached the
+// screen in the native title): the shell's logger, when linked.
+extern "C" void ps5_log_printf(const char*, ...) __attribute__((weak, format(printf, 1, 2)));
+#define PS5_TRACE(...) do { if (ps5_log_printf) ps5_log_printf(__VA_ARGS__); } while (0)
+#elif !defined(PS5_TRACE)
+#define PS5_TRACE(...) do { } while (0)
+#endif
+// Logs the first 12 occurrences and then every 200th.
+#define PS5_TRACE_SOME(counter, ...) do { static std::atomic<unsigned> counter { 0 }; unsigned n_ = ++counter; if (n_ <= 12 || !(n_ % 200)) PS5_TRACE(__VA_ARGS__); } while (0)
 
 #if USE(UNIX_DOMAIN_SOCKETS) && !OS(ANDROID)
 
@@ -150,8 +162,10 @@ RefPtr<SharedMemory> SharedMemory::map(Handle&& handle, Protection protection, C
     ASSERT_UNUSED(copyOnWrite, copyOnWrite == CopyOnWrite::No);
 
     void* data = mmap(0, handle.size(), accessModeMMap(protection), MAP_SHARED, handle.m_handle.value(), 0);
-    if (data == MAP_FAILED)
+    if (data == MAP_FAILED) {
+        PS5_TRACE_SOME(mapFailures, "webkit: SharedMemory::map fd %d size %zu FAILED: errno %d", handle.m_handle.value(), static_cast<size_t>(handle.size()), errno);
         return nullptr;
+    }
 
     RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
     instance->m_data = data;
