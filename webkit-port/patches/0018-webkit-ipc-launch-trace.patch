+#if defined(PS5_HOMEBREW)
+// The native PS5 title could not allocate the out-of-line body of a 7746-byte
+// IPC message (console run 27: errno 1), although an anonymous shm object of
+// 16 KiB worked in the same process. Size the object in whole 16 KiB pages,
+// and fall back to an unlinked file in TMPDIR (the profile's tmp directory),
+// which is also passable by descriptor. Every failed step is logged.
+static void* ps5MapShared(int fd, size_t length)
+{
+    void* data = mmap(nullptr, length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    return data == MAP_FAILED ? nullptr : data;
+}
+#endif
+
 RefPtr<SharedMemory> SharedMemory::allocate(size_t size)
 {
+#if defined(PS5_HOMEBREW)
+    auto ps5Allocate = [](size_t size, UnixFileDescriptor&& fileDescriptor, void* data) {
+        RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
+        instance->m_data = data;
+        instance->m_fileDescriptor = WTF::move(fileDescriptor);
+        instance->m_size = size;
+        return instance;
+    };
+    const size_t length = (size + 0x3fff) & ~static_cast<size_t>(0x3fff);
+    {
+        auto fileDescriptor = createSharedMemory();
+        if (!fileDescriptor)
+            PS5_TRACE_SOME(shmOpenFailures, "webkit: SharedMemory::allocate %zu: shm_open(SHM_ANON) failed: errno %d", size, errno);
+        else if (ftruncate(fileDescriptor.value(), length) == -1)
+            PS5_TRACE_SOME(shmTruncateFailures, "webkit: SharedMemory::allocate %zu: ftruncate(shm, %zu) failed: errno %d", size, length, errno);
+        else if (void* data = ps5MapShared(fileDescriptor.value(), length))
+            return ps5Allocate(size, WTF::move(fileDescriptor), data);
+        else
+            PS5_TRACE_SOME(shmMapFailures, "webkit: SharedMemory::allocate %zu: mmap(shm, %zu) failed: errno %d", size, length, errno);
+    }
+    const char* tmp = getenv("TMPDIR");
+    char path[512];
+    snprintf(path, sizeof(path), "%s/wk-shm-%d-%u", tmp && tmp[0] ? tmp : "/data/prosperoweb/tmp", static_cast<int>(getpid()), cryptographicallyRandomNumber<unsigned>());
+    int fd = open(path, O_RDWR | O_CREAT | O_EXCL, S_IRUSR | S_IWUSR);
+    if (fd < 0) {
+        PS5_TRACE_SOME(fileOpenFailures, "webkit: SharedMemory::allocate %zu: file fallback open(%s) failed: errno %d", size, path, errno);
+        return nullptr;
+    }
+    unlink(path);
+    UnixFileDescriptor fileDescriptor { fd, UnixFileDescriptor::Adopt };
+    if (ftruncate(fd, length) == -1) {
+        PS5_TRACE_SOME(fileTruncateFailures, "webkit: SharedMemory::allocate %zu: file fallback ftruncate failed: errno %d", size, errno);
+        return nullptr;
+    }
+    void* data = ps5MapShared(fd, length);
+    if (!data) {
+        PS5_TRACE_SOME(fileMapFailures, "webkit: SharedMemory::allocate %zu: file fallback mmap failed: errno %d", size, errno);
+        return nullptr;
+    }
+    PS5_TRACE_SOME(fileAllocations, "webkit: SharedMemory::allocate %zu: using an unlinked file in %s", size, tmp && tmp[0] ? tmp : "/data/prosperoweb/tmp");
+    return ps5Allocate(size, WTF::move(fileDescriptor), data);
+#else
     auto fileDescriptor = createSharedMemory();
     if (!fileDescriptor) {
         SAFE_WTFLOGALWAYS("Failed to create shared memory: %s", safeStrerror(errno));
@@ -141,6 +209,7 @@ RefPtr<SharedMemory> SharedMemory::allocate(size_t size)
     instance->m_fileDescriptor = WTF::move(fileDescriptor);
     instance->m_size = size;
     return instance;
+#endif
 }
 
