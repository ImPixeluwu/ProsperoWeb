@@ -26,6 +26,103 @@
 #include "config.h"
 #include "Connection.h"
 
+#if defined(PS5_HOMEBREW)
+#include <atomic>
+#include <time.h>
+// ProsperoWeb diagnostics (console run 25: the UI sent the page's WebProcess
+// one message and then nothing): the message names on each connection.
+extern "C" void ps5_log_printf(const char*, ...) __attribute__((weak, format(printf, 1, 2)));
+extern "C" bool ps5_trace_enabled(void) __attribute__((weak));
+// Routine traces only with PROSPEROWEB_TRACE=1 (ps5_trace_enabled, the shell);
+// failures and one-time events always (PS5_LOG).
+#define PS5_TRACE(...) do { if (ps5_log_printf && ps5_trace_enabled && ps5_trace_enabled()) ps5_log_printf(__VA_ARGS__); } while (0)
+#define PS5_LOG(...) do { if (ps5_log_printf) ps5_log_printf(__VA_ARGS__); } while (0)
+namespace {
+std::atomic<unsigned> ps5SentPerFd[256];
+std::atomic<unsigned> ps5DispatchedPerFd[256];
+// The first 400 messages each way on a descriptor are logged, with the
+// system-wide monotonic time (comparable across processes) to measure each
+// hop: send -> written -> received -> dispatched.
+bool ps5TraceMessage(std::atomic<unsigned>* table, int fd)
+{
+    return fd >= 0 && fd < 256 && ++table[fd] <= 400;
+}
+}
+extern "C" double ps5MonotonicMs()
+{
+    timespec ts { };
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
+}
+
+// Always-on, cheap: how long received messages wait for their dispatch in
+// this process, summarised every 5 s (console run 33: with tracing off there
+// were no numbers on the children's stalls). The receiving thread notes the
+// decoder's address with the time; dispatch looks it up.
+namespace {
+Lock ps5LatencyLock;
+HashMap<const void*, double>& ps5Pending() WTF_REQUIRES_LOCK(ps5LatencyLock)
+{
+    static NeverDestroyed<HashMap<const void*, double>> pending;
+    return pending.get();
+}
+constexpr double ps5Buckets[] = { 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, 5000 };
+constexpr size_t ps5BucketCount = std::size(ps5Buckets) + 1;
+unsigned ps5Histogram[ps5BucketCount] WTF_GUARDED_BY_LOCK(ps5LatencyLock);
+unsigned ps5Dispatched WTF_GUARDED_BY_LOCK(ps5LatencyLock);
+double ps5MaxWait WTF_GUARDED_BY_LOCK(ps5LatencyLock);
+double ps5WindowStart WTF_GUARDED_BY_LOCK(ps5LatencyLock);
+
+double ps5Percentile(unsigned* histogram, unsigned total, double fraction)
+{
+    unsigned seen = 0;
+    for (size_t i = 0; i < ps5BucketCount; ++i) {
+        seen += histogram[i];
+        if (seen >= fraction * total)
+            return i < std::size(ps5Buckets) ? ps5Buckets[i] : 1e9;
+    }
+    return 1e9;
+}
+}
+
+extern "C" void ps5NoteReceived(const void* decoder)
+{
+    Locker locker { ps5LatencyLock };
+    if (ps5Pending().size() < 4096)
+        ps5Pending().set(decoder, ps5MonotonicMs());
+}
+
+static void ps5NoteDispatched(const void* decoder)
+{
+    const double now = ps5MonotonicMs();
+    Locker locker { ps5LatencyLock };
+    auto it = ps5Pending().find(decoder);
+    if (it == ps5Pending().end())
+        return;
+    const double wait = now - it->value;
+    ps5Pending().remove(it);
+    size_t bucket = 0;
+    while (bucket < std::size(ps5Buckets) && wait >= ps5Buckets[bucket])
+        ++bucket;
+    ++ps5Histogram[bucket];
+    ++ps5Dispatched;
+    ps5MaxWait = std::max(ps5MaxWait, wait);
+    if (!ps5WindowStart)
