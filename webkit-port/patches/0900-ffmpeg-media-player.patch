+void MediaPlayerPrivateFFmpegMSE::setPageIsVisible(bool visible)
+{
+    if (m_pageVisible == visible)
+        return;
+    m_pageVisible = visible;
+    if (RefPtr decoder = m_videoDecoder)
+        decoder->setSuspended(!visible);
