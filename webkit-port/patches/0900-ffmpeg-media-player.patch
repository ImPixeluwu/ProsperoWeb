diff --git a/Source/WebCore/platform/graphics/ffmpeg/AudioSink.cpp b/Source/WebCore/platform/graphics/ffmpeg/AudioSink.cpp
new file mode 100644
index 000000000..6777de3ab
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/AudioSink.cpp
@@ -0,0 +1,348 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "config.h"
+#include "AudioSink.h"
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "FFmpegLog.h"
+#include "FFmpegRemoteAudioClient.h"
+#include "Logging.h"
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <wtf/Condition.h>
+#include <wtf/Lock.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/Threading.h>
+#include <wtf/Vector.h>
+
+#if defined(FFMPEG_MEDIA_SDL_AUDIO) && FFMPEG_MEDIA_SDL_AUDIO
+#include <SDL2/SDL.h>
+#endif
+
+namespace WebCore {
+
+namespace {
+
+// Consumes samples at the real-time rate and discards them.
+class NullAudioSink final : public AudioSink {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(NullAudioSink);
+public:
+    explicit NullAudioSink(RenderCallback&& render)
+        : m_render(WTF::move(render))
+        , m_scratch(static_cast<size_t>(sampleRate / 10) * channels)
+    {
+        m_thread = Thread::create("FFmpegNullAudio"_s, [this] {
+            run();
+        });
+    }
+
+    ~NullAudioSink() final
+    {
+        {
+            Locker locker { m_lock };
+            m_quit = true;
+            m_condition.notifyAll();
+        }
+        m_thread->waitForCompletion();
+    }
+
+    void play() final
+    {
+        Locker locker { m_lock };
+        if (!m_playing)
+            m_lastTick = MonotonicTime::now();
+        m_playing = true;
+        m_condition.notifyAll();
+    }
+
+    void pause() final
+    {
+        Locker locker { m_lock };
+        m_playing = false;
+    }
+
+    double latency() const final { return 0; }
+    bool isNull() const final { return true; }
+    const char* name() const final { return "null"; }
+
+private:
+    void run()
+    {
+        double pendingFrames = 0;
+        while (true) {
+            size_t frames;
+            {
+                Locker locker { m_lock };
+                while (!m_quit && !m_playing)
+                    m_condition.wait(m_lock);
+                if (m_quit)
+                    return;
+                m_condition.waitFor(m_lock, 10_ms);
+                if (m_quit)
+                    return;
+                if (!m_playing)
+                    continue;
+                auto now = MonotonicTime::now();
+                pendingFrames += (now - m_lastTick).seconds() * sampleRate;
+                m_lastTick = now;
+                frames = std::min(static_cast<size_t>(pendingFrames), m_scratch.size() / channels);
+                pendingFrames -= frames;
+            }
+            if (frames)
+                m_render(m_scratch.mutableSpan().first(frames * channels));
+        }
+    }
+
+    RenderCallback m_render;
+    Vector<float> m_scratch;
+    RefPtr<Thread> m_thread;
+    Lock m_lock;
+    Condition m_condition;
+    bool m_playing WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_quit WTF_GUARDED_BY_LOCK(m_lock) { false };
+    MonotonicTime m_lastTick WTF_GUARDED_BY_LOCK(m_lock);
+};
+
+// Forwards samples to the UI process's audio server (FFmpegAudioWire.h).
+// A writer thread pulls from the render callback whenever less than the
+// target (100 ms, PROSPEROWEB_AUDIO_AHEAD_MS) is queued on the server, so the
+// main thread never touches the socket. latency() follows the server's
+// played reports, which makes the engine's audio clock track what is heard.
+class RemoteAudioSink final : public AudioSink {
+    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(RemoteAudioSink);
+public:
+    static std::unique_ptr<AudioSink> create(RenderCallback& render, int port)
+    {
+        auto sink = std::unique_ptr<RemoteAudioSink>(new RemoteAudioSink(WTF::move(render)));
+        if (const char* ahead = getenv("PROSPEROWEB_AUDIO_AHEAD_MS"); ahead && atoi(ahead) > 0)
+            sink->m_client.setTargetAhead(atoi(ahead) / 1000.0);
+        std::string error;
+        if (!sink->m_client.connect(port, 300, error)) {
+            ffmpegMediaLog("audio sink: remote 127.0.0.1:%d failed: %s", port, error.c_str());
+            render = WTF::move(sink->m_render);
+            return nullptr;
+        }
+        const auto& accepted = sink->m_client.accepted();
+        ffmpegMediaLog("audio sink: remote 127.0.0.1:%d connected (stream %u, output latency %u frames, %.0f ms ahead)",
+            port, accepted.streamId, accepted.outputLatencyFrames, sink->m_client.targetAhead() * 1000);
+        sink->m_port = port;
+        sink->m_thread = Thread::create("FFmpegRemoteAudio"_s, [self = sink.get()] {
+            self->run();
+        });
+        return sink;
+    }
+
+    ~RemoteAudioSink() final
+    {
+        {
+            Locker locker { m_lock };
+            m_quit = true;
+            m_condition.notifyAll();
+        }
+        m_thread->waitForCompletion();
+    }
+
+    void play() final
+    {
+        m_client.setPlaying(true);
+        wake();
+    }
+
+    void pause() final
+    {
+        m_client.setPlaying(false);
+        wake();
+    }
+
+    void flush() final
+    {
+        m_client.requestFlush();
+        wake();
+    }
+
+    double latency() const final { return m_client.latencySeconds(); }
+    bool isNull() const final { return false; }
+    const char* name() const final { return "remote"; }
+
+private:
+    explicit RemoteAudioSink(RenderCallback&& render)
+        : m_render(WTF::move(render))
+    {
+    }
+
+    void wake()
+    {
+        Locker locker { m_lock };
+        m_condition.notifyAll();
+    }
+
+    void run()
+    {
+        auto pull = [this](float* interleaved, size_t frames) {
+            m_render(std::span<float>(interleaved, frames * channels));
+        };
+        bool loggedFailure = false;
+        while (true) {
+            {
+                Locker locker { m_lock };
+                if (m_quit)
+                    break;
+            }
+            if (!m_client.pump(pull) && !loggedFailure) {
+                loggedFailure = true;
+                ffmpegMediaLog("audio sink: remote 127.0.0.1:%d %s, continuing without sound",
+                    m_port, m_client.failure().c_str());
+            }
+            Locker locker { m_lock };
+            if (!m_quit)
+                m_condition.waitFor(m_lock, 5_ms);
+        }
+        // Sends the close message.
+        m_client.requestClose();
+        if (!m_client.failed())
+            m_client.pump(pull);
+    }
+
+    RenderCallback m_render;
+    mutable FFmpegMedia::AudioWire::RemoteAudioClient m_client;
+    RefPtr<Thread> m_thread;
+    int m_port { 0 };
+    Lock m_lock;
+    Condition m_condition;
+    bool m_quit WTF_GUARDED_BY_LOCK(m_lock) { false };
+};
+
+#if defined(FFMPEG_MEDIA_SDL_AUDIO) && FFMPEG_MEDIA_SDL_AUDIO
+class SDLAudioSink final : public AudioSink {
+public:
+    static std::unique_ptr<AudioSink> create(RenderCallback& render)
+    {
+        if (SDL_InitSubSystem(SDL_INIT_AUDIO) < 0) {
+            ffmpegMediaLog("audio sink: SDL_InitSubSystem(AUDIO) failed: %s", SDL_GetError());
+            return nullptr;
+        }
+        const char* driver = SDL_GetCurrentAudioDriver();
+        int devices = SDL_GetNumAudioDevices(0);
+        const char* deviceName = devices > 0 ? SDL_GetAudioDeviceName(0, 0) : nullptr;
+        ffmpegMediaLog("audio sink: SDL driver %s, %d output devices, opening the default (%s)",
+            driver ? driver : "(none)", devices, deviceName ? deviceName : "unnamed");
+        auto sink = std::unique_ptr<SDLAudioSink>(new SDLAudioSink(WTF::move(render)));
+        SDL_AudioSpec desired { };
+        desired.freq = sampleRate;
+        desired.format = AUDIO_F32SYS;
+        desired.channels = channels;
+        desired.samples = 1024;
+        desired.callback = callback;
+        desired.userdata = sink.get();
+        SDL_AudioSpec obtained { };
+        // No allowed changes: SDL converts to the device format itself.
+        sink->m_device = SDL_OpenAudioDevice(nullptr, 0, &desired, &obtained, 0);
+        if (!sink->m_device) {
+            ffmpegMediaLog("audio sink: SDL_OpenAudioDevice(%d Hz, f32, %d ch, %d samples) failed: %s",
+                desired.freq, desired.channels, desired.samples, SDL_GetError());
+            // The sink's destructor balances SDL_InitSubSystem.
+            render = WTF::move(sink->m_render);
+            return nullptr;
+        }
+        ffmpegMediaLog("audio sink: SDL device %u open: requested %d Hz f32 %d ch %d samples, obtained %d Hz format 0x%x %d ch %d samples",
+            static_cast<unsigned>(sink->m_device), desired.freq, desired.channels, desired.samples,
+            obtained.freq, static_cast<unsigned>(obtained.format), obtained.channels, obtained.samples);
+        // The callback fills one buffer while the device plays the previous.
+        sink->m_latency = 2.0 * obtained.samples / sampleRate;
+        return sink;
+    }
+
+    ~SDLAudioSink() final
+    {
+        if (m_device) {
+            // Returns once no callback is running, so `this` is safe to free.
+            SDL_CloseAudioDevice(m_device);
+        }
+        SDL_QuitSubSystem(SDL_INIT_AUDIO);
+    }
+
+    void play() final { SDL_PauseAudioDevice(m_device, 0); }
+    void pause() final { SDL_PauseAudioDevice(m_device, 1); }
+    double latency() const final { return m_latency; }
+    bool isNull() const final { return false; }
+    const char* name() const final { return "sdl"; }
+
+private:
+    explicit SDLAudioSink(RenderCallback&& render)
+        : m_render(WTF::move(render))
+    {
+    }
+
+    static void callback(void* userData, Uint8* stream, int length)
+    {
+        auto* sink = static_cast<SDLAudioSink*>(userData);
+        size_t count = static_cast<size_t>(length) / sizeof(float);
+        sink->m_render(std::span<float>(reinterpret_cast<float*>(stream), count));
+    }
+
+    RenderCallback m_render;
+    SDL_AudioDeviceID m_device { 0 };
+    double m_latency { 0 };
+};
+
+#endif
+
+// The audio server's port: PROSPEROWEB_AUDIO_PORT (the UI exports it), else
+// the default on PlayStation. 0 when forwarding is off.
+int remotePort()
+{
+    const char* value = getenv("PROSPEROWEB_AUDIO_PORT");
+    if (!value || !*value) {
+#if PLATFORM(PLAYSTATION)
+        return FFmpegMedia::AudioWire::defaultPort;
+#else
+        return 0;
+#endif
+    }
+    char* end = nullptr;
+    long port = strtol(value, &end, 10);
+    return (!*end && port > 0 && port <= 65535) ? static_cast<int>(port) : 0;
+}
+
+} // namespace
+
+std::unique_ptr<AudioSink> AudioSink::createNull(RenderCallback&& render)
+{
+    return makeUnique<NullAudioSink>(WTF::move(render));
+}
+
+std::unique_ptr<AudioSink> AudioSink::create(RenderCallback&& render)
+{
+    const char* requested = getenv("PROSPEROWEB_MEDIA_AUDIO");
+    std::string mode = requested ? requested : "";
+    if (mode == "null") {
+        ffmpegMediaLog("audio sink: PROSPEROWEB_MEDIA_AUDIO=null, using the null sink");
+        return createNull(WTF::move(render));
+    }
+    if (!mode.empty() && mode != "remote" && mode != "sdl")
+        ffmpegMediaLog("audio sink: unknown PROSPEROWEB_MEDIA_AUDIO=%s, using the default order", mode.c_str());
+
+    int port = remotePort();
+    if (mode == "remote" && !port)
+        port = FFmpegMedia::AudioWire::defaultPort;
+    if (mode != "sdl" && port) {
+        if (auto sink = RemoteAudioSink::create(render, port))
+            return sink;
+        ffmpegMediaLog("audio sink: remote unavailable, trying the local SDL output (inaudible from the WebProcess on the PS5)");
+    }
+
+#if defined(FFMPEG_MEDIA_SDL_AUDIO) && FFMPEG_MEDIA_SDL_AUDIO
+    if (auto sink = SDLAudioSink::create(render))
+        return sink;
+    ffmpegMediaLog("audio sink: falling back to the null sink (no sound, the clock keeps running)");
+#else
+    ffmpegMediaLog("audio sink: built without SDL audio, using the null sink");
+#endif
+    return createNull(WTF::move(render));
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/AudioSink.h b/Source/WebCore/platform/graphics/ffmpeg/AudioSink.h
new file mode 100644
index 000000000..0826619af
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/AudioSink.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Audio output of the ffmpeg media engine. The sink owns an output thread
+// (SDL's audio callback, or a timer thread for the null sink) that asks the
+// render callback for interleaved float32 stereo at 48 kHz.
+//
+// On the PS5 the WebProcess is a separate payload process: sceAudioOut
+// (SDL's PS5 driver) opens there and is drained, but only the foreground
+// application (the UI process) is heard. RemoteAudioSink therefore forwards
+// the samples to the UI's audio server over loopback TCP
+// (FFmpegAudioWire.h). create() falls back to the local SDL sink and then to
+// NullAudioSink, which consumes samples in real time so the audio clock and
+// A/V sync keep working without sound.
+
+#pragma once
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include <memory>
+#include <span>
+#include <wtf/Function.h>
+
+namespace WebCore {
+
+class AudioSink {
+public:
+    static constexpr int sampleRate = 48000;
+    static constexpr int channels = 2;
+
+    // Called on the sink thread; must fill the whole span (silence if no
+    // data is available).
+    using RenderCallback = Function<void(std::span<float> interleaved)>;
+
+    // PROSPEROWEB_MEDIA_AUDIO selects the first sink tried: "remote" (the
+    // default when PROSPEROWEB_AUDIO_PORT is set, and on PlayStation), "sdl"
+    // or "null". Failures fall through remote -> sdl -> null.
+    static std::unique_ptr<AudioSink> create(RenderCallback&&);
+    static std::unique_ptr<AudioSink> createNull(RenderCallback&&);
+
+    virtual ~AudioSink() = default;
+
+    virtual void play() = 0;
+    virtual void pause() = 0;
+    // A seek: drop samples queued downstream of the render callback.
+    virtual void flush() { }
+    // Seconds between rendering a sample and hearing it.
+    virtual double latency() const = 0;
+    virtual bool isNull() const = 0;
+    virtual const char* name() const = 0;
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegAVClock.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegAVClock.h
new file mode 100644
index 000000000..169cb8011
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegAVClock.h
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Playback clock of the ffmpeg media engine. Engine-independent: callers
+// pass the current monotonic time in seconds, and (when audio is the master)
+// the time of the audio sample currently leaving the speakers. Video frames
+// are scheduled against time(); the same clock can drive an MSE player later.
+//
+// Rules:
+//  - audio master: while audio is playing at rate 1, time() follows the audio
+//    position (base pts + frames consumed / sample rate - output latency), so
+//    an audio underrun stalls video as well;
+//  - otherwise the clock extrapolates from the last anchor with the playback
+//    rate, so silent media, audio-less video, rate != 1 and the tail of a
+//    video whose audio ended early still advance;
+//  - time() never goes backwards except across reset() (a seek).
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+// Media time of the sample being heard: base pts of the first sample written
+// after the last flush, plus the frames the sink has consumed since, minus
+// the sink latency. Never earlier than basePts.
+inline double audioClockTime(double basePts, int64_t framesConsumed, int sampleRate, double latencySeconds)
+{
+    if (sampleRate <= 0)
+        return basePts;
+    double t = basePts + static_cast<double>(framesConsumed) / sampleRate - latencySeconds;
+    return std::max(basePts, t);
+}
+
+class AVClock {
+public:
+    void reset(double mediaTime, double now)
+    {
+        m_anchorMedia = mediaTime;
+        m_anchorWall = now;
+        m_last = mediaTime;
+    }
+
+    void setRunning(bool running, double now)
+    {
+        if (running == m_running)
+            return;
+        reanchor(now);
+        m_running = running;
+    }
+
+    // Buffering: while stalled, the extrapolated clock holds still.
+    void setStalled(bool stalled, double now)
+    {
+        if (stalled == m_stalled)
+            return;
+        reanchor(now);
+        m_stalled = stalled;
+    }
+
+    void setRate(double rate, double now)
+    {
+        if (!(rate >= 0) || rate == m_rate)
+            return;
+        reanchor(now);
+        m_rate = rate;
+    }
+
+    double rate() const { return m_rate; }
+    bool running() const { return m_running; }
+    bool stalled() const { return m_stalled; }
+
+    // Audio may only drive the clock at normal speed: there is no
+    // time-stretching, the engine mutes audio at other rates.
+    bool audioCanBeMaster() const { return m_rate == 1.0; }
+
+    double time(double now, std::optional<double> audioTime = std::nullopt)
+    {
+        double t;
+        if (audioTime && audioCanBeMaster() && m_running) {
+            // Anchor on the value actually returned, so a later fallback to
+            // extrapolation continues from it.
+            t = std::max(*audioTime, m_last);
+            m_anchorMedia = t;
+            m_anchorWall = now;
+        } else
+            t = std::max(extrapolate(now), m_last);
+        m_last = t;
+        return t;
+    }
+
+private:
+    double extrapolate(double now) const
+    {
+        if (!m_running || m_stalled)
+            return m_anchorMedia;
+        return m_anchorMedia + std::max(0.0, now - m_anchorWall) * m_rate;
+    }
+
+    void reanchor(double now)
+    {
+        m_anchorMedia = std::max(extrapolate(now), m_last);
+        m_anchorWall = now;
+    }
+
+    double m_anchorMedia { 0 };
+    double m_anchorWall { 0 };
+    double m_last { 0 };
+    double m_rate { 1 };
+    bool m_running { false };
+    bool m_stalled { false };
+};
+
+// Presentation decision for one decoded video frame at clock time `now`.
+enum class FrameDecision { Wait, Show, Drop };
+
+// A frame is shown once its pts is reached; it is dropped instead when the
+// next frame is also due (the display would only flash it).
+inline FrameDecision decideFrame(double framePts, std::optional<double> nextFramePts, double clock)
+{
+    constexpr double earlyTolerance = 0.005;
+    if (framePts > clock + earlyTolerance)
+        return FrameDecision::Wait;
+    if (nextFramePts && *nextFramePts <= clock + earlyTolerance)
+        return FrameDecision::Drop;
+    return FrameDecision::Show;
+}
+
+} // namespace FFmpegMedia
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegAudioDecoder.cpp b/Source/WebCore/platform/graphics/ffmpeg/FFmpegAudioDecoder.cpp
new file mode 100644
index 000000000..d24d77c56
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegAudioDecoder.cpp
@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "config.h"
+#include "FFmpegAudioDecoder.h"
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "FFmpegAVClock.h"
+#include "FFmpegDemuxer.h"
+#include "FFmpegLog.h"
+#include "Logging.h"
+
+extern "C" {
+#include <libavutil/channel_layout.h>
+#include <libavutil/samplefmt.h>
+#include <libswresample/swresample.h>
+}
+
+namespace WebCore {
+
+namespace {
+
+constexpr Seconds packetWaitTimeout = 20_ms;
+constexpr Seconds spaceWaitTimeout = 10_ms;
+// Decoded audio kept ahead of the sink.
+constexpr double ringSeconds = 1.0;
+// Timestamp gaps larger than this are filled with silence (up to the cap)
+// so the audio clock stays linear.
+constexpr double gapThreshold = 0.04;
+constexpr double maxGapFill = 2.0;
+// Discard mode keeps the decoder at most this far ahead of the clock.
+constexpr double discardLead = 0.2;
+
+} // namespace
+
+RefPtr<FFmpegAudioDecoder> FFmpegAudioDecoder::create(const FFmpegStreamInfo& stream, FFmpegPacketQueue& queue, int outputRate, int outputChannels)
+{
+    if (!stream.parameters || outputRate <= 0 || outputChannels <= 0)
+        return nullptr;
+    const AVCodec* codec = findSoftwareDecoder(stream.parameters->codec_id);
+    if (!codec)
+        return nullptr;
+    AVCodecContextPtr context(avcodec_alloc_context3(codec));
+    if (!context || avcodec_parameters_to_context(context.get(), stream.parameters.get()) < 0)
+        return nullptr;
+    context->pkt_timebase = stream.timeBase;
+    context->thread_count = 1;
+    int result = avcodec_open2(context.get(), codec, nullptr);
+    if (result < 0) {
+        ffmpegMediaLog("audio decoder %s: open failed: %s", codec->name, ffmpegErrorString(result).utf8().legacyCStringPointer());
+        return nullptr;
+    }
+    ffmpegMediaLog("audio decoder %s: %d Hz, %d ch, %s -> f32 %d Hz %d ch", codec->name, context->sample_rate,
+        context->ch_layout.nb_channels, av_get_sample_fmt_name(context->sample_fmt) ? av_get_sample_fmt_name(context->sample_fmt) : "?",
+        outputRate, outputChannels);
+    return adoptRef(*new FFmpegAudioDecoder(stream, queue, WTF::move(context), outputRate, outputChannels));
+}
+
+FFmpegAudioDecoder::FFmpegAudioDecoder(const FFmpegStreamInfo& stream, FFmpegPacketQueue& queue, AVCodecContextPtr&& context, int outputRate, int outputChannels)
+    : m_timeBase(stream.timeBase)
+    , m_startTime(stream.startTime)
+    , m_outputRate(outputRate)
+    , m_outputChannels(outputChannels)
+    , m_queue(queue)
+    , m_codec(WTF::move(context))
+    , m_frame(av_frame_alloc())
+    , m_ring(static_cast<size_t>(outputRate * ringSeconds) * outputChannels)
+{
+}
+
+FFmpegAudioDecoder::~FFmpegAudioDecoder()
+{
+    ASSERT(!m_thread);
+    swr_free(&m_swr);
+    av_channel_layout_uninit(&m_swrInputLayout);
+}
+
+void FFmpegAudioDecoder::start()
+{
+    if (m_thread || !m_frame)
+        return;
+    m_thread = Thread::create("FFmpegAudioDecoder"_s, [protectedThis = Ref { *this }] {
+        protectedThis->run();
+    });
+}
+
+void FFmpegAudioDecoder::stop()
+{
+    m_stopping = true;
+    {
+        Locker locker { m_lock };
+        m_condition.notifyAll();
+    }
+    if (RefPtr thread = std::exchange(m_thread, nullptr))
+        thread->waitForCompletion();
+}
+
+void FFmpegAudioDecoder::run()
+{
+    while (!m_stopping) {
+        auto entry = m_queue.pop(packetWaitTimeout);
+        if (!entry) {
+            if (m_queue.isAborted())
+                break;
+            continue;
+        }
+        if (entry->serial != m_serial)
+            flushForSerial(entry->serial);
+        if (entry->isEndOfStream()) {
+            avcodec_send_packet(m_codec.get(), nullptr);
+            receiveFrames();
+            avcodec_flush_buffers(m_codec.get());
+            Locker locker { m_lock };
+            m_endSerial = m_serial;
+            continue;
+        }
+        decodePacket(entry->packet.get());
+    }
+}
+
+void FFmpegAudioDecoder::flushForSerial(unsigned serial)
+{
+    avcodec_flush_buffers(m_codec.get());
+    // Recreated on the next frame, dropping samples buffered inside swr.
+    swr_free(&m_swr);
+    m_swrInputRate = 0;
+    m_serial = serial;
+    Locker locker { m_lock };
+    m_ring.clear();
+    m_ringSerial = serial;
+    m_basePts.reset();
+    m_framesWritten = 0;
+    m_framesConsumed = 0;
+    m_endSerial = std::numeric_limits<unsigned>::max();
+    m_condition.notifyAll();
+}
+
+void FFmpegAudioDecoder::decodePacket(AVPacket* packet)
+{
+    int result = avcodec_send_packet(m_codec.get(), packet);
+    if (result == AVERROR(EAGAIN)) {
+        receiveFrames();
+        result = avcodec_send_packet(m_codec.get(), packet);
+    }
+    if (result < 0 && result != AVERROR(EAGAIN) && result != AVERROR_EOF)
+        if (!(m_decodeErrors++ % 100))
+            ffmpegMediaLog("audio decoder: send_packet: %s", ffmpegErrorString(result).utf8().legacyCStringPointer());
+    receiveFrames();
+}
+
+void FFmpegAudioDecoder::receiveFrames()
+{
+    while (!m_stopping) {
+        int result = avcodec_receive_frame(m_codec.get(), m_frame.get());
+        if (result == AVERROR(EAGAIN) || result == AVERROR_EOF)
+            return;
+        if (result < 0) {
+            if (!(m_decodeErrors++ % 100))
+                ffmpegMediaLog("audio decoder: receive_frame: %s", ffmpegErrorString(result).utf8().legacyCStringPointer());
+            return;
+        }
+        writeFrame(m_frame.get());
+        av_frame_unref(m_frame.get());
+    }
+}
+
+bool FFmpegAudioDecoder::ensureResampler(const AVFrame* frame)
+{
+    if (m_swr && frame->sample_rate == m_swrInputRate && frame->format == m_swrInputFormat
+        && !av_channel_layout_compare(&frame->ch_layout, &m_swrInputLayout))
+        return true;
+
+    swr_free(&m_swr);
+    AVChannelLayout input { };
+    if (frame->ch_layout.order == AV_CHANNEL_ORDER_UNSPEC || av_channel_layout_check(&frame->ch_layout) != 1)
+        av_channel_layout_default(&input, std::max(frame->ch_layout.nb_channels, 1));
+    else if (av_channel_layout_copy(&input, &frame->ch_layout) < 0)
+        return false;
+    AVChannelLayout output { };
+    av_channel_layout_default(&output, m_outputChannels);
+    int result = swr_alloc_set_opts2(&m_swr, &output, AV_SAMPLE_FMT_FLT, m_outputRate,
+        &input, static_cast<AVSampleFormat>(frame->format), frame->sample_rate, 0, nullptr);
+    av_channel_layout_uninit(&output);
+    av_channel_layout_uninit(&input);
+    if (result < 0 || !m_swr || swr_init(m_swr) < 0) {
+        ffmpegMediaLog("audio decoder: cannot resample %d Hz format %d", frame->sample_rate, frame->format);
+        swr_free(&m_swr);
+        m_fatalError = true;
+        return false;
+    }
+    m_swrInputRate = frame->sample_rate;
+    m_swrInputFormat = frame->format;
+    av_channel_layout_uninit(&m_swrInputLayout);
+    av_channel_layout_copy(&m_swrInputLayout, &frame->ch_layout);
+    return true;
+}
+
+void FFmpegAudioDecoder::writeFrame(const AVFrame* frame)
+{
+    if (frame->nb_samples <= 0 || frame->sample_rate <= 0 || !ensureResampler(frame))
+        return;
+    double pts = (frame->best_effort_timestamp == AV_NOPTS_VALUE || !m_timeBase.den)
+        ? std::numeric_limits<double>::quiet_NaN()
+        : frame->best_effort_timestamp * av_q2d(m_timeBase) - m_startTime;
+
+    int capacity = swr_get_out_samples(m_swr, frame->nb_samples);
+    if (capacity <= 0)
+        return;
+    m_converted.resize(static_cast<size_t>(capacity) * m_outputChannels);
+    uint8_t* output = reinterpret_cast<uint8_t*>(m_converted.mutableSpan().data());
+    int converted = swr_convert(m_swr, &output, capacity, const_cast<const uint8_t**>(frame->extended_data), frame->nb_samples);
+    if (converted <= 0)
+        return;
+    writeSamples(m_converted.span().first(static_cast<size_t>(converted) * m_outputChannels), pts);
+}
+
+bool FFmpegAudioDecoder::waitForSpace()
+{
+    while (!m_ring.freeSpace()) {
+        if (m_stopping || m_discard || m_queue.serial() != m_serial)
+            return false;
+        m_condition.waitFor(m_lock, spaceWaitTimeout);
+    }
+    return !m_stopping && m_queue.serial() == m_serial;
+}
+
+void FFmpegAudioDecoder::writeSamples(std::span<const float> samples, double pts)
+{
+    const size_t channels = static_cast<size_t>(m_outputChannels);
+    if (m_discard) {
+        // Pace the decoder against the clock, then drop.
+        while (m_discard && !m_stopping && m_queue.serial() == m_serial && std::isfinite(pts) && pts > m_clockHint + discardLead) {
+            Locker locker { m_lock };
+            m_condition.waitFor(m_lock, spaceWaitTimeout);
+        }
+        m_needsResync = true;
+        return;
+    }
+
+    Locker locker { m_lock };
+    if (m_needsResync.exchange(false)) {
+        m_ring.clear();
+        m_basePts.reset();
+        m_framesWritten = 0;
+        m_framesConsumed = 0;
+    }
+
+    if (m_seekTarget >= 0 && m_seekSerial == m_serial && std::isfinite(pts)) {
+        double end = pts + static_cast<double>(samples.size() / channels) / m_outputRate;
+        if (end <= m_seekTarget)
+            return;
+        if (pts < m_seekTarget) {
+            size_t skip = static_cast<size_t>((m_seekTarget - pts) * m_outputRate) * channels;
+            samples = samples.subspan(std::min(skip, samples.size()));
+            pts = m_seekTarget;
+        }
+        m_seekTarget = -1;
+    }
+
+    if (!m_basePts)
+        m_basePts = std::isfinite(pts) ? pts : 0;
+    else if (std::isfinite(pts)) {
+        double expected = *m_basePts + static_cast<double>(m_framesWritten) / m_outputRate;
+        double gap = pts - expected;
+        if (gap > gapThreshold) {
+            size_t silence = static_cast<size_t>(std::min(gap, maxGapFill) * m_outputRate) * channels;
+            while (silence) {
+                if (!waitForSpace())
+                    return;
+                size_t written = m_ring.fill(0.0f, std::min(silence, m_ring.freeSpace() - m_ring.freeSpace() % channels));
+                if (!written)
+                    continue;
+                silence -= written;
+                m_framesWritten += written / channels;
+            }
+        }
+    }
+
+    while (!samples.empty()) {
+        if (!waitForSpace())
+            return;
+        size_t room = m_ring.freeSpace() - m_ring.freeSpace() % channels;
+        if (!room) {
+            m_condition.waitFor(m_lock, spaceWaitTimeout);
+            continue;
+        }
+        size_t written = m_ring.write(samples.data(), std::min(room, samples.size()));
+        samples = samples.subspan(written);
+        m_framesWritten += written / channels;
+    }
+}
+
+void FFmpegAudioDecoder::render(std::span<float> out)
+{
+    const size_t channels = static_cast<size_t>(m_outputChannels);
+    size_t read = 0;
+    {
+        Locker locker { m_lock };
+        // After a seek request, stay silent until the decoder has switched
+        // the ring buffer to the new serial.
+        bool current = m_ringSerial == m_seekSerial || m_seekSerial == 0;
+        if (current && !m_discard) {
+            read = m_ring.read(out.data(), out.size() - out.size() % channels);
+            m_framesConsumed += read / channels;
+            m_condition.notifyAll();
+        }
+    }
+    float gain = m_gain;
+    for (size_t i = 0; i < read; ++i)
+        out[i] *= gain;
+    std::fill(out.begin() + read, out.end(), 0.0f);
+}
+
+std::optional<double> FFmpegAudioDecoder::clockTime(double sinkLatency) const
+{
+    Locker locker { m_lock };
+    if (!m_basePts || m_discard)
+        return std::nullopt;
+    return FFmpegMedia::audioClockTime(*m_basePts, m_framesConsumed, m_outputRate, sinkLatency);
+}
+
+double FFmpegAudioDecoder::bufferedSeconds() const
+{
+    Locker locker { m_lock };
+    return static_cast<double>(m_ring.size() / static_cast<size_t>(m_outputChannels)) / m_outputRate;
+}
+
+bool FFmpegAudioDecoder::drained(unsigned serial) const
+{
+    Locker locker { m_lock };
+    return m_endSerial == serial && m_ringSerial == serial && m_ring.isEmpty();
+}
+
+bool FFmpegAudioDecoder::hasData(unsigned serial) const
+{
+    Locker locker { m_lock };
+    return m_ringSerial == serial && m_basePts && (!m_ring.isEmpty() || m_framesConsumed);
+}
+
+void FFmpegAudioDecoder::setSeekTarget(double time, unsigned serial)
+{
+    m_clockHint = time;
+    Locker locker { m_lock };
+    m_seekTarget = time;
+    m_seekSerial = serial;
+    m_condition.notifyAll();
+}
+
+void FFmpegAudioDecoder::setDiscard(bool discard)
+{
+    if (m_discard == discard)
+        return;
+    m_discard = discard;
+    if (!discard)
+        m_needsResync = true;
+    Locker locker { m_lock };
+    m_condition.notifyAll();
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
