+Ref<FFmpegResourceStream> FFmpegResourceStream::create(Ref<PlatformMediaResourceLoader>&& loader, const URL& url, Ref<FFmpegIOShared>&& shared)
+{
+    return adoptRef(*new FFmpegResourceStream(WTF::move(loader), url, WTF::move(shared)));
+}
+
+FFmpegResourceStream::FFmpegResourceStream(Ref<PlatformMediaResourceLoader>&& loader, const URL& url, Ref<FFmpegIOShared>&& shared)
+    : m_loader(WTF::move(loader))
+    , m_url(url.isolatedCopy())
+    , m_shared(WTF::move(shared))
+{
+}
+
+FFmpegResourceStream::~FFmpegResourceStream()
+{
+    Locker locker { m_lock };
+    stopResourceLocked();
+}
+
+AVIOContext* FFmpegResourceStream::createAVIOContext(Ref<FFmpegResourceStream>&& stream)
+{
+    auto* buffer = static_cast<unsigned char*>(av_malloc(avioBufferSize));
+    if (!buffer)
+        return nullptr;
+    bool seekable;
+    {
+        Locker locker { stream->m_lock };
+        seekable = stream->m_size > 0;
+    }
+    auto* rawStream = &stream.leakRef();
+    AVIOContext* context = avio_alloc_context(buffer, avioBufferSize, 0, rawStream, readPacketCallback, nullptr, seekCallback);
+    if (!context) {
+        av_free(buffer);
+        rawStream->close();
+        rawStream->deref();
+        return nullptr;
+    }
+    // Servers without Range support stay seekable: a seek restarts the
+    // download and skips to the target, which is slow but correct (an MP4
+    // with the moov atom at the end needs it).
+    context->seekable = seekable ? AVIO_SEEKABLE_NORMAL : 0;
+    return context;
+}
+
+bool FFmpegResourceStream::isOurAVIOContext(const AVIOContext* context)
+{
+    return context && context->read_packet == readPacketCallback;
+}
+
+void FFmpegResourceStream::destroyAVIOContext(AVIOContext* context)
+{
+    if (!context)
+        return;
+    if (auto* stream = static_cast<FFmpegResourceStream*>(context->opaque)) {
+        stream->close();
+        stream->deref();
+    }
+    av_freep(&context->buffer);
+    avio_context_free(&context);
+}
+
+void FFmpegResourceStream::setByteRange(uint64_t offset, uint64_t endOffset)
+{
+    Locker locker { m_lock };
+    m_readPosition = offset;
+    m_rangeEnd = endOffset > offset ? endOffset : 0;
+    m_byteRangeEnd = m_rangeEnd;
+}
+
+std::string FFmpegResourceStream::hostForLog() const
+{
+    return m_url.host().utf8().legacyCStringPointer();
+}
+
+int FFmpegResourceStream::open()
+{
+    Locker locker { m_lock };
+    startRequestLocked(m_readPosition, false);
+    while (m_state == RequestState::Pending || m_state == RequestState::RetryWait) {
+        if (!waitLocked())
+            return AVERROR_EXIT;
+    }
+    if (m_state == RequestState::Failed)
+        return AVERROR(EIO);
+    return 0;
+}
+
+uint64_t FFmpegResourceStream::bufferStartLocked() const
+{
+    return m_chunks.isEmpty() ? m_requestPosition : m_chunks.first().position;
+}
+
+uint64_t FFmpegResourceStream::bufferEndLocked() const
+{
+    return m_chunks.isEmpty() ? m_requestPosition : m_chunks.last().end();
+}
+
+size_t FFmpegResourceStream::copyOutLocked(uint8_t* out, size_t size)
+{
+    size_t copied = 0;
+    for (auto& chunk : m_chunks) {
+        if (copied == size)
+            break;
+        if (m_readPosition < chunk.position || m_readPosition >= chunk.end())
+            continue;
+        size_t offset = static_cast<size_t>(m_readPosition - chunk.position);
+        size_t count = std::min(size - copied, chunk.data.size() - offset);
+        memcpy(out + copied, chunk.data.span().subspan(offset, count).data(), count);
+        copied += count;
+        m_readPosition += count;
+    }
+    return copied;
+}
+
+void FFmpegResourceStream::trimHistoryLocked()
+{
+    while (m_chunks.size() > 1 && m_chunks.first().end() + historyBytes <= m_readPosition)
+        m_chunks.removeFirst();
+}
+
+bool FFmpegResourceStream::waitLocked()
+{
+    if (m_shared->aborted || m_closed)
+        return false;
+    m_condition.waitFor(m_lock, pollInterval);
+    if (m_shared->aborted || m_closed)
+        return false;
+    checkRequestLocked();
+    return true;
+}
+
+void FFmpegResourceStream::checkRequestLocked()
+{
+    double now = monotonicSeconds();
+    if (m_state == RequestState::RetryWait) {
+        if (now >= m_retryAt)
+            restartRequestLocked();
+        return;
+    }
+    if ((m_state == RequestState::Pending || m_state == RequestState::Receiving) && FFmpegMedia::networkStalled(m_lastProgressAt, now))
+        retryOrFailLocked("stall 8s");
+}
+
+void FFmpegResourceStream::retryOrFailLocked(const char* reason)
+{
+    unsigned long long at = m_requestPosition + m_receivedInRequest;
+    // Whatever the current request still delivers is ignored from now on.
+    ++m_requestId;
+    stopResourceLocked();
+    auto decision = m_retry.onFailure();
+    if (!decision.retry) {
+        ffmpegMediaLog("net: %s on %s at byte %llu, giving up after %u retries", reason, hostForLog().c_str(), at, FFmpegMedia::networkMaxRetries);
+        m_state = RequestState::Failed;
+        m_shared->networkError = true;
+        m_condition.notifyAll();
+        return;
+    }
+    ffmpegMediaLog("net: %s on %s at byte %llu, retry %u/%u in %.1f s", reason, hostForLog().c_str(), at, decision.attempt,
+        FFmpegMedia::networkMaxRetries, decision.delaySeconds);
+    m_state = RequestState::RetryWait;
+    m_retryAt = monotonicSeconds() + decision.delaySeconds;
+    m_condition.notifyAll();
+}
+
+void FFmpegResourceStream::restartRequestLocked()
+{
+    // From the end of the received data when the reader is inside it (the
+    // buffer stays), else from the read position.
+    uint64_t start = bufferStartLocked();
+    uint64_t end = bufferEndLocked();
+    bool continueBuffer = !m_chunks.isEmpty() && m_readPosition >= start && m_readPosition <= end;
+    uint64_t position = continueBuffer ? end : m_readPosition;
+    if (m_byteRangeEnd > position)
+        m_rangeEnd = m_byteRangeEnd;
+    ffmpegMediaLog("net: retry %u/%u: requesting %s from byte %llu", m_retry.attempts(), FFmpegMedia::networkMaxRetries, hostForLog().c_str(),
+        static_cast<unsigned long long>(position));
+    startRequestLocked(position, continueBuffer);
+}
+
+int FFmpegResourceStream::read(uint8_t* buffer, int size)
+{
+    if (size <= 0)
+        return 0;
+    Locker locker { m_lock };
+    while (true) {
+        if (m_shared->aborted || m_closed)
+            return AVERROR_EXIT;
+
+        uint64_t start = bufferStartLocked();
+        uint64_t end = bufferEndLocked();
+        if (m_readPosition >= start && m_readPosition < end) {
+            size_t copied = copyOutLocked(buffer, static_cast<size_t>(size));
+            trimHistoryLocked();
+            if (m_state == RequestState::Suspended && FFmpegMedia::networkShouldResume(bufferEndLocked() - m_readPosition))
+                startRequestLocked(bufferEndLocked(), true);
+            return static_cast<int>(copied);
+        }
+
+        if (m_size >= 0 && m_readPosition >= static_cast<uint64_t>(m_size))
+            return AVERROR_EOF;
+
+        bool inReach = m_readPosition >= start && m_readPosition <= end + forwardWaitBytes;
+        switch (m_state) {
+        case RequestState::None:
+            startRequestLocked(m_readPosition, false);
+            break;
+        case RequestState::Pending:
+        case RequestState::Receiving:
+            if (!inReach)
+                startRequestLocked(m_readPosition, false);
+            break;
+        case RequestState::Finished:
+            if (inReach)
+                return AVERROR_EOF;
+            startRequestLocked(m_readPosition, false);
+            break;
+        case RequestState::Failed:
+            return AVERROR(EIO);
+        case RequestState::Suspended:
+            startRequestLocked(m_readPosition, m_readPosition == end);
+            break;
+        case RequestState::RetryWait:
+            break;
+        }
+        if (m_interruptibleBySeek && m_shared->seekPending)
+            return AVERROR(EINTR);
+        if (!waitLocked())
+            return AVERROR_EXIT;
+    }
+}
+
+int64_t FFmpegResourceStream::seek(int64_t offset, int whence)
+{
+    Locker locker { m_lock };
+    if (whence & AVSEEK_SIZE) {
+        while (m_state == RequestState::Pending || m_state == RequestState::None || m_state == RequestState::RetryWait) {
+            if (m_state == RequestState::None)
+                startRequestLocked(m_readPosition, false);
+            if (!waitLocked())
+                return AVERROR_EXIT;
+        }
+        return m_size >= 0 ? m_size : AVERROR(ENOSYS);
+    }
+
+    int64_t target;
+    switch (whence & ~AVSEEK_FORCE) {
+    case SEEK_SET:
+        target = offset;
+        break;
+    case SEEK_CUR:
+        target = static_cast<int64_t>(m_readPosition) + offset;
+        break;
+    case SEEK_END:
+        if (m_size < 0)
+            return AVERROR(ENOSYS);
+        target = m_size + offset;
+        break;
+    default:
+        return AVERROR(EINVAL);
+    }
+    if (target < 0)
+        return AVERROR(EINVAL);
+    // The request (if one is needed) is issued lazily by the next read().
+    m_readPosition = static_cast<uint64_t>(target);
+    return target;
+}
+
+void FFmpegResourceStream::close()
+{
+    Locker locker { m_lock };
+    m_closed = true;
+    ++m_requestId;
+    stopResourceLocked();
+    m_chunks.clear();
+    m_condition.notifyAll();
+}
+
+void FFmpegResourceStream::startRequestLocked(uint64_t position, bool keepBuffer)
+{
+    stopResourceLocked();
+    if (!keepBuffer)
+        m_chunks.clear();
+    m_requestPosition = position;
+    m_receivedInRequest = 0;
+    m_skipBytes = 0;
+    m_state = RequestState::Pending;
+    m_lastProgressAt = monotonicSeconds();
+    unsigned requestId = ++m_requestId;
+    // The byte range end only bounds the first request (a segment); later
+    // requests (resumes, seeks) are open-ended.
+    uint64_t rangeEnd = std::exchange(m_rangeEnd, 0);
+    if (rangeEnd <= position)
+        rangeEnd = 0;
+    unsigned count = ++m_shared->requestCount;
+    if (position)
+        ffmpegMediaLog("net: request #%u bytes=%llu-%s", count, static_cast<unsigned long long>(position),
+            rangeEnd ? makeString(rangeEnd - 1).utf8().legacyCStringPointer() : "");
+    callOnMainThread([protectedThis = Ref { *this }, requestId, position, rangeEnd] {
+        protectedThis->dispatchRequest(requestId, position, rangeEnd);
+    });
+}
+
+void FFmpegResourceStream::dispatchRequest(unsigned requestId, uint64_t position, uint64_t rangeEnd)
+{
+    ASSERT(isMainThread());
+    {
+        Locker locker { m_lock };
+        if (m_closed || requestId != m_requestId)
+            return;
+    }
+
+    ResourceRequest request { URL { m_url } };
+    request.setAllowCookies(true);
+    if (rangeEnd)
+        request.setHTTPHeaderField(HTTPHeaderName::Range, makeString("bytes="_s, position, '-', rangeEnd - 1));
+    else if (position)
+        request.setHTTPHeaderField(HTTPHeaderName::Range, makeString("bytes="_s, position, '-'));
+
+    // Never call into the resource while holding m_lock: shutdown() and the
+    // loader may call the client synchronously, which takes m_lock.
+    RefPtr resource = m_loader->requestResource(WTF::move(request), PlatformMediaResourceLoader::LoadOption::DisallowCaching);
+    if (!resource) {
+        ffmpegMediaLog("net: the media resource loader refused the request (%s)", m_url.protocol().utf8().legacyCStringPointer());
+        Locker locker { m_lock };
+        if (requestId == m_requestId) {
+            m_state = RequestState::Failed;
+            m_shared->networkError = true;
+            m_condition.notifyAll();
+        }
+        return;
+    }
+    resource->setClient(StreamClient::create(Ref { *this }, requestId));
+
+    bool stale;
+    {
+        Locker locker { m_lock };
+        stale = m_closed || requestId != m_requestId;
+        if (!stale)
+            m_resource = resource;
+    }
+    if (stale) {
+        resource->shutdown();
+        resource->setClient(nullptr);
+    }
+}
+
+void FFmpegResourceStream::stopResourceLocked()
+{
+    RefPtr resource = WTF::move(m_resource);
+    if (!resource)
+        return;
+    // Always asynchronous: this runs on the demuxer thread or inside a
+    // resource client callback.
+    callOnMainThread([resource = WTF::move(resource)] {
+        resource->shutdown();
+        resource->setClient(nullptr);
+    });
+}
+
+void FFmpegResourceStream::suspendLocked()
+{
+    ++m_requestId;
+    m_state = RequestState::Suspended;
+    stopResourceLocked();
+}
+
+void FFmpegResourceStream::didReceiveResponse(unsigned requestId, const ResourceResponse& response, bool passedAccessControlCheck, bool& shouldContinue)
+{
+    Locker locker { m_lock };
+    if (m_closed || requestId != m_requestId) {
+        shouldContinue = false;
+        return;
+    }
+
+    bool isHTTP = response.url().protocolIsInHTTPFamily() || m_url.protocolIsInHTTPFamily();
+    int status = response.httpStatusCode();
+    m_lastProgressAt = monotonicSeconds();
+    if (isHTTP && status >= httpStatus400BadRequest) {
+        ffmpegMediaLog("net: HTTP %d for %s://%s at byte %llu", status, m_url.protocol().utf8().legacyCStringPointer(), hostForLog().c_str(),
+            static_cast<unsigned long long>(m_requestPosition));
+        shouldContinue = false;
+        if (FFmpegMedia::networkStatusIsRetryable(status)) {
+            char reason[16];
+            snprintf(reason, sizeof(reason), "HTTP %d", status);
+            retryOrFailLocked(reason);
+            return;
+        }
+        m_state = RequestState::Failed;
+        m_shared->networkError = true;
+        m_condition.notifyAll();
+        return;
+    }
+    if (m_retry.attempts())
+        ffmpegMediaLog("net: retry %u/%u: HTTP %d from %s", m_retry.attempts(), FFmpegMedia::networkMaxRetries, status, hostForLog().c_str());
+
+    m_shared->sawResponse = true;
+    if (isHTTP && !passedAccessControlCheck)
+        m_shared->didPassAccessControlCheck = false;
+
+    bool isPartial = isHTTP && status == httpStatus206PartialContent;
+    if (m_requestPosition && !isPartial) {
+        // The server ignored Range and sends the whole body: skip to the
+        // requested position and stop issuing range requests.
+        m_skipBytes = m_requestPosition;
+        if (m_rangesSupported)
+            ffmpegMediaLog("net: %s ignored Range (HTTP %d), skipping %llu bytes", m_url.host().utf8().legacyCStringPointer(), status,
+                static_cast<unsigned long long>(m_requestPosition));
+        m_rangesSupported = false;
+    }
+
+    int64_t length = response.httpHeaderFields().contains(HTTPHeaderName::ContentEncoding) ? -1 : response.expectedContentLength();
+    if (isPartial) {
+        int64_t total = totalFromContentRange(response.httpHeaderField(HTTPHeaderName::ContentRange));
+        if (total > 0)
+            m_size = total;
+        else if (length > 0)
+            m_size = static_cast<int64_t>(m_requestPosition) + length;
+    } else if (length > 0)
+        m_size = length;
+
+    if (isHTTP && equalLettersIgnoringASCIICase(response.httpHeaderField(HTTPHeaderName::AcceptRanges), "none"_s))
+        m_rangesSupported = false;
+
+    m_state = RequestState::Receiving;
+    m_condition.notifyAll();
+}
+
+void FFmpegResourceStream::didReceiveData(unsigned requestId, std::span<const uint8_t> data)
+{
+    Locker locker { m_lock };
+    if (m_closed || requestId != m_requestId)
+        return;
+
+    m_shared->bytesReceived += data.size();
+    m_lastProgressAt = monotonicSeconds();
+    if (m_retry.attempts()) {
+        ffmpegMediaLog("net: %s recovered at byte %llu after %u retries", hostForLog().c_str(),
+            static_cast<unsigned long long>(m_requestPosition + m_receivedInRequest), m_retry.attempts());
+        m_retry.onProgress();
+    }
+    if (m_skipBytes) {
+        size_t skipped = static_cast<size_t>(std::min<uint64_t>(m_skipBytes, data.size()));
+        m_skipBytes -= skipped;
+        data = data.subspan(skipped);
+    }
+    if (data.empty())
+        return;
+
+    uint64_t position = m_requestPosition + m_receivedInRequest;
+    m_receivedInRequest += data.size();
+    if (!m_chunks.isEmpty() && m_chunks.last().end() == position && m_chunks.last().data.size() < chunkCoalesceBytes)
+        m_chunks.last().data.append(data);
+    else {
+        Chunk chunk;
+        chunk.position = position;
+        chunk.data.append(data);
+        m_chunks.append(WTF::move(chunk));
+    }
+
+    // Also with an unknown size or without Range support: an unbounded
+    // buffer would hold a whole long progressive download in memory. A
+    // resume without Range support restarts the request and skips ahead.
+    uint64_t end = bufferEndLocked();
+    if (end > m_readPosition && FFmpegMedia::networkShouldSuspend(end - m_readPosition, end, m_size, m_rangesSupported))
+        suspendLocked();
+    m_condition.notifyAll();
+}
+
+void FFmpegResourceStream::didFinish(unsigned requestId)
+{
+    Locker locker { m_lock };
+    if (m_closed || requestId != m_requestId)
+        return;
+    m_state = RequestState::Finished;
+    // Without Content-Length the size is known once the body is complete.
+    if (m_size < 0 && !m_skipBytes)
+        m_size = static_cast<int64_t>(m_requestPosition + m_receivedInRequest);
+    m_condition.notifyAll();
+}
+
+void FFmpegResourceStream::didFail(unsigned requestId, bool isAccessControlFailure)
+{
+    Locker locker { m_lock };
+    if (m_closed || requestId != m_requestId)
+        return;
+    ffmpegMediaLog("net: load failed%s for %s://%s at byte %llu", isAccessControlFailure ? " (CORS)" : "",
+        m_url.protocol().utf8().legacyCStringPointer(), hostForLog().c_str(),
+        static_cast<unsigned long long>(m_requestPosition + m_receivedInRequest));
+    if (!isAccessControlFailure) {
+        retryOrFailLocked("load failed");
+        return;
+    }
+    m_state = RequestState::Failed;
+    m_shared->networkError = true;
+    if (isAccessControlFailure)
+        m_shared->didPassAccessControlCheck = false;
+    m_condition.notifyAll();
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegResourceIO.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegResourceIO.h
new file mode 100644
index 000000000..605135cd9
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegResourceIO.h
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Byte-stream input for libavformat backed by WebCore's media resource
+// loader (PlatformMediaResourceLoader), so media requests carry the page's
+// cookies, referrer, CORS mode and CSP checks and share the network process
+// with the rest of the page. The demuxer installs it as the top-level
+// AVIOContext and as AVFormatContext::io_open, which libavformat's HLS
+// demuxer uses for playlists, keys and segments.
+//
+// Threading: read()/seek() run on the demuxer thread and block (polling an
+// abort flag every 50 ms); requests are started on the main thread and the
+// PlatformMediaResourceClient callbacks arrive there. The main thread never
+// waits for the demuxer thread, so the two cannot deadlock.
+//
+// Stalls and failures: a request that delivers nothing for 8 s while the
+// demuxer waits, a network failure or a 5xx/408/429 response is cancelled
+// and issued again from the current offset (Range), after 0.5, 1 and 2 s;
+// then the stream fails (NetworkRetry in FFmpegPlaybackPolicy.h). The
+// waits of the demuxer thread drive the stall check and the backoff.
+
+#pragma once
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "FFmpegPlaybackPolicy.h"
+#include <atomic>
+#include <span>
+#include <string>
+#include <wtf/Condition.h>
+#include <wtf/Deque.h>
+#include <wtf/Lock.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/URL.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+struct AVIOContext;
+
+namespace WebCore {
+
+class PlatformMediaResource;
+class PlatformMediaResourceLoader;
+class ResourceResponse;
+
+// State shared by every stream one demuxer opens.
+class FFmpegIOShared : public ThreadSafeRefCounted<FFmpegIOShared> {
+public:
+    static Ref<FFmpegIOShared> create() { return adoptRef(*new FFmpegIOShared); }
+
+    std::atomic<bool> aborted { false };
+    std::atomic<bool> networkError { false };
+    std::atomic<bool> didPassAccessControlCheck { true };
+    std::atomic<bool> sawResponse { false };
+    std::atomic<uint64_t> bytesReceived { 0 };
+    // A seek is waiting for the demuxer thread: a read of the top-level
+    // stream that would block returns AVERROR(EINTR) instead, so the seek
+    // does not wait for data at the old position.
+    std::atomic<bool> seekPending { false };
+    // libavformat's HLS demuxer asked for an skd:// key (FairPlay DRM).
+    std::atomic<bool> fairPlayKeyRequested { false };
+    std::atomic<unsigned> requestCount { 0 };
+
+private:
+    FFmpegIOShared() = default;
+};
+
+class FFmpegResourceStream final : public ThreadSafeRefCounted<FFmpegResourceStream> {
+public:
+    static Ref<FFmpegResourceStream> create(Ref<PlatformMediaResourceLoader>&&, const URL&, Ref<FFmpegIOShared>&&);
+    ~FFmpegResourceStream();
+
+    // Before open(): serve only bytes [offset, endOffset) of the resource
+    // (HLS EXT-X-BYTERANGE, passed by libavformat as the "offset" and
+    // "end_offset" options; endOffset 0 means to the end). Reads then start
+    // at `offset`.
+    void setByteRange(uint64_t offset, uint64_t endOffset);
+    // The top-level stream gives way to a pending seek (see seekPending).
+    void setInterruptibleBySeek(bool interruptible) { m_interruptibleBySeek = interruptible; }
+
+    // Demuxer thread. open() issues the first request and waits for the
+    // response; it returns 0 or a negative AVERROR.
+    int open();
+    int read(uint8_t*, int size);
+    int64_t seek(int64_t offset, int whence);
+    void close();
+
+    // Creates an AVIOContext that owns a reference to `stream`. Returns
+    // nullptr on allocation failure.
+    static AVIOContext* createAVIOContext(Ref<FFmpegResourceStream>&&);
+    static bool isOurAVIOContext(const AVIOContext*);
+    // Closes the stream and frees the context and its buffer.
+    static void destroyAVIOContext(AVIOContext*);
+
+    // Main thread, from the resource client.
+    void didReceiveResponse(unsigned requestId, const ResourceResponse&, bool passedAccessControlCheck, bool& shouldContinue);
+    void didReceiveData(unsigned requestId, std::span<const uint8_t>);
+    void didFinish(unsigned requestId);
+    void didFail(unsigned requestId, bool isAccessControlFailure);
+
+private:
+    FFmpegResourceStream(Ref<PlatformMediaResourceLoader>&&, const URL&, Ref<FFmpegIOShared>&&);
+
+    enum class RequestState : uint8_t { None, Pending, Receiving, Finished, Failed, Suspended, RetryWait };
+
+    struct Chunk {
+        uint64_t position { 0 };
+        Vector<uint8_t> data;
+        uint64_t end() const { return position + data.size(); }
+    };
+
+    void dispatchRequest(unsigned requestId, uint64_t position, uint64_t rangeEnd);
+    void startRequestLocked(uint64_t position, bool keepBuffer) WTF_REQUIRES_LOCK(m_lock);
+    void suspendLocked() WTF_REQUIRES_LOCK(m_lock);
+    void stopResourceLocked() WTF_REQUIRES_LOCK(m_lock);
+    uint64_t bufferStartLocked() const WTF_REQUIRES_LOCK(m_lock);
+    uint64_t bufferEndLocked() const WTF_REQUIRES_LOCK(m_lock);
+    size_t copyOutLocked(uint8_t*, size_t) WTF_REQUIRES_LOCK(m_lock);
+    void trimHistoryLocked() WTF_REQUIRES_LOCK(m_lock);
+    bool waitLocked() WTF_REQUIRES_LOCK(m_lock);
+    // Stall detection and the retry backoff (demuxer thread, from the waits).
+    void checkRequestLocked() WTF_REQUIRES_LOCK(m_lock);
+    // A stall or a retryable failure: schedules the next retry or fails.
+    void retryOrFailLocked(const char* reason) WTF_REQUIRES_LOCK(m_lock);
+    void restartRequestLocked() WTF_REQUIRES_LOCK(m_lock);
+    std::string hostForLog() const;
+
+    const Ref<PlatformMediaResourceLoader> m_loader;
+    const URL m_url;
+    const Ref<FFmpegIOShared> m_shared;
+
+    Lock m_lock;
+    Condition m_condition;
+    Deque<Chunk> m_chunks WTF_GUARDED_BY_LOCK(m_lock);
+    uint64_t m_readPosition WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    // Bytes of a 200 response to drop because the server ignored Range.
+    uint64_t m_skipBytes WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    uint64_t m_requestPosition WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    uint64_t m_receivedInRequest WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    int64_t m_size WTF_GUARDED_BY_LOCK(m_lock) { -1 };
+    unsigned m_requestId WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    RequestState m_state WTF_GUARDED_BY_LOCK(m_lock) { RequestState::None };
+    bool m_rangesSupported WTF_GUARDED_BY_LOCK(m_lock) { true };
+    bool m_closed WTF_GUARDED_BY_LOCK(m_lock) { false };
+    // Exclusive end of the first request's Range (0: open-ended).
+    uint64_t m_rangeEnd WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    // The byte range of setByteRange(), for retries of the first request.
+    uint64_t m_byteRangeEnd WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    // Monotonic seconds of the last request start, response or data.
+    double m_lastProgressAt WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    double m_retryAt WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    FFmpegMedia::NetworkRetry m_retry WTF_GUARDED_BY_LOCK(m_lock);
+    bool m_interruptibleBySeek { false };
+    RefPtr<PlatformMediaResource> m_resource WTF_GUARDED_BY_LOCK(m_lock);
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegRingBuffer.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegRingBuffer.h
new file mode 100644
index 000000000..51fb9045b
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegRingBuffer.h
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Fixed-capacity FIFO of interleaved audio samples between the audio decoder
+// thread and the audio sink callback. Not internally synchronised: the owner
+// (FFmpegAudioDecoder) guards it with its lock, which also makes flushes on
+// seek trivially safe. Engine-independent for host unit tests.
+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <vector>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+template<typename T>
+class RingBuffer {
+public:
+    explicit RingBuffer(size_t capacity)
+        : m_buffer(std::max<size_t>(capacity, 1))
+    {
+    }
+
+    size_t capacity() const { return m_buffer.size(); }
+    size_t size() const { return m_size; }
+    size_t freeSpace() const { return capacity() - m_size; }
+    bool isEmpty() const { return !m_size; }
+
+    // Writes up to `count` items, returns how many fit.
+    size_t write(const T* data, size_t count)
+    {
+        count = std::min(count, freeSpace());
+        size_t writePos = (m_readPos + m_size) % capacity();
+        size_t first = std::min(count, capacity() - writePos);
+        std::copy(data, data + first, m_buffer.begin() + writePos);
+        std::copy(data + first, data + count, m_buffer.begin());
+        m_size += count;
+        return count;
+    }
+
+    // Appends `count` copies of `value` (silence), returns how many fit.
+    size_t fill(const T& value, size_t count)
+    {
+        count = std::min(count, freeSpace());
+        size_t writePos = (m_readPos + m_size) % capacity();
+        for (size_t i = 0; i < count; ++i)
+            m_buffer[(writePos + i) % capacity()] = value;
+        m_size += count;
+        return count;
+    }
+
+    // Reads up to `count` items, returns how many were read.
+    size_t read(T* out, size_t count)
+    {
+        count = std::min(count, m_size);
+        size_t first = std::min(count, capacity() - m_readPos);
+        std::copy(m_buffer.begin() + m_readPos, m_buffer.begin() + m_readPos + first, out);
+        std::copy(m_buffer.begin(), m_buffer.begin() + (count - first), out + first);
+        m_readPos = (m_readPos + count) % capacity();
+        m_size -= count;
+        return count;
+    }
+
+    // Drops up to `count` items without copying them out.
+    size_t skip(size_t count)
+    {
+        count = std::min(count, m_size);
+        m_readPos = (m_readPos + count) % capacity();
+        m_size -= count;
+        return count;
+    }
+
+    void clear()
+    {
+        m_readPos = 0;
+        m_size = 0;
+    }
+
+private:
+    std::vector<T> m_buffer;
+    size_t m_readPos { 0 };
+    size_t m_size { 0 };
+};
+
+} // namespace FFmpegMedia
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegSupportTable.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegSupportTable.h
new file mode 100644
index 000000000..ddc8a5d36
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegSupportTable.h
@@ -0,0 +1,457 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// MIME type / RFC 6381 codec support table of the ffmpeg media engine.
+// Engine-independent (no WebCore, WTF or ffmpeg headers) so it can be unit
+// tested on the host; MediaPlayerPrivateFFmpeg feeds it the decoders that
+// the linked libavcodec actually provides.
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+enum class Support { NotSupported, MaybeSupported, IsSupported };
+
+// Decoders available at run time. Defaults match the PS5 SDK ffmpeg 7.0.1
+// build: native h264/hevc/vp8/vp9/aac/opus/vorbis/mp3/flac/ac3/eac3, but no
+// software AV1 decoder (no libdav1d/libaom; ff_av1_decoder is hwaccel-only).
+// The engine reports VP8/VP9 as unavailable unless PROSPEROWEB_MEDIA_VP9=1:
+// software VP9 is much slower than H.264, and players then pick H.264.
+struct DecoderAvailability {
+    bool h264 { true };
+    bool hevc { true };
+    bool vp8 { true };
+    bool vp9 { true };
+    bool av1 { false };
+    bool aac { true };
+    bool mp3 { true };
+    bool opus { true };
+    bool vorbis { true };
+    bool flac { true };
+    bool ac3 { true };
+    bool eac3 { true };
+};
+
+enum class Container { Unknown, MP4, WebM, HLS, MPEG, Ogg, Flac, Wav, AAC };
+
+inline char toLowerASCII(char c) { return (c >= 'A' && c <= 'Z') ? static_cast<char>(c - 'A' + 'a') : c; }
+
+inline std::string lowercase(std::string_view s)
+{
+    std::string out(s);
+    for (auto& c : out)
+        c = toLowerASCII(c);
+    return out;
+}
+
+inline std::string_view trim(std::string_view s)
+{
+    while (!s.empty() && (s.front() == ' ' || s.front() == '\t'))
+        s.remove_prefix(1);
+    while (!s.empty() && (s.back() == ' ' || s.back() == '\t'))
+        s.remove_suffix(1);
+    return s;
+}
+
+struct ContainerEntry {
+    std::string_view mimeType;
+    Container container;
+};
+
+// Every MIME type the engine claims. Used both for supportsType() and for
+// MediaPlayerFactory::getSupportedTypes().
+inline constexpr std::array<ContainerEntry, 22> containerTable { {
+    { "video/mp4", Container::MP4 },
+    { "audio/mp4", Container::MP4 },
+    { "video/x-m4v", Container::MP4 },
+    { "audio/x-m4a", Container::MP4 },
+    { "video/quicktime", Container::MP4 },
+    { "video/webm", Container::WebM },
+    { "audio/webm", Container::WebM },
+    { "video/x-matroska", Container::WebM },
+    { "audio/x-matroska", Container::WebM },
+    { "application/vnd.apple.mpegurl", Container::HLS },
+    { "application/x-mpegurl", Container::HLS },
+    { "audio/mpegurl", Container::HLS },
+    { "audio/x-mpegurl", Container::HLS },
+    { "audio/mpeg", Container::MPEG },
+    { "audio/mp3", Container::MPEG },
+    { "audio/ogg", Container::Ogg },
+    { "video/ogg", Container::Ogg },
+    { "audio/flac", Container::Flac },
+    { "audio/x-flac", Container::Flac },
+    { "audio/wav", Container::Wav },
+    { "audio/x-wav", Container::Wav },
+    { "audio/aac", Container::AAC },
+} };
+
+inline Container containerForMIMEType(std::string_view mimeType)
+{
+    auto lower = lowercase(trim(mimeType));
+    for (auto& entry : containerTable) {
+        if (entry.mimeType == lower)
+            return entry.container;
+    }
+    return Container::Unknown;
+}
+
+enum class CodecFamily { Unknown, H264, HEVC, VP8, VP9, AV1, AAC, MP3, Opus, Vorbis, Flac, AC3, EAC3 };
+
+inline bool startsWith(std::string_view s, std::string_view prefix)
+{
+    return s.size() >= prefix.size() && s.substr(0, prefix.size()) == prefix;
+}
+
+// Maps one RFC 6381 codecs-parameter entry (already lowercased) to a family.
+inline CodecFamily codecFamily(std::string_view codec)
+{
+    if (startsWith(codec, "avc1") || startsWith(codec, "avc3"))
+        return CodecFamily::H264;
+    if (startsWith(codec, "hvc1") || startsWith(codec, "hev1"))
+        return CodecFamily::HEVC;
+    if (codec == "vp8" || startsWith(codec, "vp8.") || startsWith(codec, "vp08"))
+        return CodecFamily::VP8;
+    if (codec == "vp9" || startsWith(codec, "vp9.") || startsWith(codec, "vp09"))
+        return CodecFamily::VP9;
+    if (startsWith(codec, "av01"))
+        return CodecFamily::AV1;
+    // mp4a.40.x is AAC (2 LC, 5 HE, 29 HE v2, ...) except 34 (MP3); mp4a.69
+    // and mp4a.6b are MPEG-1/2 audio.
+    if (codec == "mp4a.40.34" || codec == "mp4a.69" || codec == "mp4a.6b" || codec == "mp3")
+        return CodecFamily::MP3;
+    if (startsWith(codec, "mp4a.40") || codec == "mp4a.66" || codec == "mp4a.67" || codec == "mp4a.68" || codec == "aac")
+        return CodecFamily::AAC;
+    if (codec == "opus" || codec == "mp4a.ad")
+        return CodecFamily::Opus;
+    if (codec == "vorbis")
+        return CodecFamily::Vorbis;
+    if (codec == "flac")
+        return CodecFamily::Flac;
+    if (codec == "ac-3" || codec == "mp4a.a5")
+        return CodecFamily::AC3;
+    if (codec == "ec-3" || codec == "mp4a.a6")
+        return CodecFamily::EAC3;
+    return CodecFamily::Unknown;
+}
+
+inline bool decoderAvailable(CodecFamily family, const DecoderAvailability& decoders)
+{
+    switch (family) {
+    case CodecFamily::H264: return decoders.h264;
+    case CodecFamily::HEVC: return decoders.hevc;
+    case CodecFamily::VP8: return decoders.vp8;
+    case CodecFamily::VP9: return decoders.vp9;
+    case CodecFamily::AV1: return decoders.av1;
+    case CodecFamily::AAC: return decoders.aac;
+    case CodecFamily::MP3: return decoders.mp3;
+    case CodecFamily::Opus: return decoders.opus;
+    case CodecFamily::Vorbis: return decoders.vorbis;
+    case CodecFamily::Flac: return decoders.flac;
+    case CodecFamily::AC3: return decoders.ac3;
+    case CodecFamily::EAC3: return decoders.eac3;
+    case CodecFamily::Unknown: return false;
+    }
+    return false;
+}
+
+// Whether a codec family may appear in a container at all (a WebM file
+// cannot carry H.264, an MP3 file cannot carry video, ...).
+inline bool containerAllows(Container container, CodecFamily family)
+{
+    switch (container) {
+    case Container::MP4:
+        return family != CodecFamily::Vorbis;
+    case Container::WebM:
+        return family == CodecFamily::VP8 || family == CodecFamily::VP9 || family == CodecFamily::AV1
+            || family == CodecFamily::Opus || family == CodecFamily::Vorbis;
+    case Container::HLS:
+        // TS and fMP4 segments: the codecs Safari advertises for HLS plus Opus/FLAC in fMP4.
+        return family == CodecFamily::H264 || family == CodecFamily::HEVC || family == CodecFamily::AAC
+            || family == CodecFamily::MP3 || family == CodecFamily::AC3 || family == CodecFamily::EAC3
+            || family == CodecFamily::Opus || family == CodecFamily::Flac || family == CodecFamily::VP9 || family == CodecFamily::AV1;
+    case Container::MPEG:
+        return family == CodecFamily::MP3;
+    case Container::Ogg:
+        return family == CodecFamily::Opus || family == CodecFamily::Vorbis || family == CodecFamily::Flac;
+    case Container::Flac:
+        return family == CodecFamily::Flac;
+    case Container::Wav:
+        return false; // PCM has no RFC 6381 name; only "1" is used in practice.
+    case Container::AAC:
+        return family == CodecFamily::AAC;
+    case Container::Unknown:
+        return false;
+    }
+    return false;
+}
+
+// Splits a codecs parameter value ("avc1.64001f, mp4a.40.2") into entries.
+inline std::vector<std::string> splitCodecs(std::string_view codecs)
+{
+    std::vector<std::string> result;
+    size_t start = 0;
+    while (start <= codecs.size()) {
+        size_t comma = codecs.find(',', start);
+        if (comma == std::string_view::npos)
+            comma = codecs.size();
+        auto item = trim(codecs.substr(start, comma - start));
+        if (!item.empty())
+            result.push_back(lowercase(item));
+        start = comma + 1;
+    }
+    return result;
+}
+
+// HTML canPlayType()/isTypeSupported() semantics:
+//  - unknown container: NotSupported ("");
+//  - known container, no codecs parameter: MaybeSupported ("maybe");
+//  - every listed codec known and decodable in this container: IsSupported ("probably");
+//  - a codec known to be undecodable or impossible in the container: NotSupported;
+//  - otherwise (a codec string we do not recognise): MaybeSupported.
+inline Support evaluate(std::string_view mimeType, const std::vector<std::string>& codecs, const DecoderAvailability& decoders)
+{
+    auto container = containerForMIMEType(mimeType);
+    if (container == Container::Unknown)
+        return Support::NotSupported;
+    if (codecs.empty())
+        return Support::MaybeSupported;
+
+    Support result = Support::IsSupported;
+    for (auto& rawCodec : codecs) {
+        auto codec = lowercase(trim(rawCodec));
+        if (container == Container::Wav && (codec == "1" || codec == "3"))
+            continue;
+        auto family = codecFamily(codec);
+        if (family == CodecFamily::Unknown) {
+            result = Support::MaybeSupported;
+            continue;
+        }
+        if (!containerAllows(container, family) || !decoderAvailable(family, decoders))
+            return Support::NotSupported;
+    }
+    return result;
+}
+
+
+// MARK: - Media Source Extensions and content type parameters
+
+// MSE byte stream formats this engine parses (SourceBufferPrivateFFmpeg):
+// ISO BMFF (fragmented MP4) and WebM. HLS, MP3, ADTS and the progressive
+// aliases (video/x-m4v, video/quicktime, ...) are not MSE byte streams.
+inline Container mediaSourceContainerForMIMEType(std::string_view mimeType)
+{
+    auto lower = lowercase(trim(mimeType));
+    if (lower == "video/mp4" || lower == "audio/mp4")
+        return Container::MP4;
+    if (lower == "video/webm" || lower == "audio/webm")
+        return Container::WebM;
+    return Container::Unknown;
+}
+
+inline bool isVideoFamily(CodecFamily family)
+{
+    return family == CodecFamily::H264 || family == CodecFamily::HEVC || family == CodecFamily::VP8
+        || family == CodecFamily::VP9 || family == CodecFamily::AV1;
+}
+
+struct ContentTypeParameter {
+    std::string name; // lowercased
+    std::string value; // unquoted, case preserved
+};
+
+// Splits `type/subtype; name=value; name="quoted, value"` into its MIME type
+// and parameters (RFC 7231 media-type syntax, lenient about whitespace).
+// Returns the parameters; `mimeType` receives the trimmed type/subtype.
+inline std::vector<ContentTypeParameter> parseContentTypeParameters(std::string_view raw, std::string* mimeType = nullptr)
+{
+    std::vector<ContentTypeParameter> result;
+    size_t semicolon = raw.find(';');
+    if (mimeType)
+        *mimeType = std::string(trim(raw.substr(0, semicolon)));
+    size_t position = semicolon == std::string_view::npos ? raw.size() : semicolon + 1;
+    while (position < raw.size()) {
+        size_t equals = raw.find('=', position);
+        size_t nextSemicolon = raw.find(';', position);
+        if (equals == std::string_view::npos || (nextSemicolon != std::string_view::npos && nextSemicolon < equals)) {
+            // A parameter without a value: skip it.
+            if (nextSemicolon == std::string_view::npos)
+                break;
+            position = nextSemicolon + 1;
+            continue;
+        }
+        ContentTypeParameter parameter;
+        parameter.name = lowercase(trim(raw.substr(position, equals - position)));
+        size_t valueStart = equals + 1;
+        while (valueStart < raw.size() && (raw[valueStart] == ' ' || raw[valueStart] == '\t'))
+            ++valueStart;
+        size_t end;
+        if (valueStart < raw.size() && raw[valueStart] == '"') {
+            size_t closing = raw.find('"', valueStart + 1);
+            if (closing == std::string_view::npos)
+                closing = raw.size();
+            parameter.value = std::string(raw.substr(valueStart + 1, closing - valueStart - 1));
+            end = raw.find(';', closing);
+        } else {
+            end = raw.find(';', valueStart);
+            parameter.value = std::string(trim(raw.substr(valueStart, (end == std::string_view::npos ? raw.size() : end) - valueStart)));
+        }
+        if (!parameter.name.empty())
+            result.push_back(parameter);
+        if (end == std::string_view::npos)
+            break;
+        position = end + 1;
+    }
+    return result;
+}
+
+inline bool parseDecimal(std::string_view text, double& out)
+{
+    text = trim(text);
+    if (text.empty() || text.size() > 32)
+        return false;
+    double value = 0;
+    double scale = 0;
+    for (char c : text) {
+        if (c >= '0' && c <= '9') {
+            if (scale) {
+                value += (c - '0') * scale;
+                scale /= 10;
+            } else
+                value = value * 10 + (c - '0');
+        } else if (c == '.' && !scale)
+            scale = 0.1;
+        else
+            return false;
+    }
+    out = value;
+    return true;
+}
+
+// Limits for the extended isTypeSupported() parameters that YouTube (and
+// other Cobalt-style players) use to probe the decoder: anything beyond them
+// is "", so a player never picks a stream this build cannot decode in time.
+// Video defaults to 1080p (software decoding on the console); the longer
+// side may be either dimension, so portrait 1080x1920 fits too.
+// PROSPEROWEB_MEDIA_MAX_VIDEO=3840x2160 raises it (parseVideoLimits()).
+struct VideoLimits {
+    double maxLongSide { 1920 };
+    double maxShortSide { 1088 };
+};
+inline constexpr double maxFrameRate = 120;
+inline constexpr double maxAudioChannels = 8;
+
+// "WIDTHxHEIGHT" (either order); false when malformed.
+inline bool parseVideoLimits(std::string_view text, VideoLimits& limits)
+{
+    size_t x = text.find_first_of("xX");
+    double a = 0;
+    double b = 0;
+    if (x == std::string_view::npos || !parseDecimal(text.substr(0, x), a) || !parseDecimal(text.substr(x + 1), b) || a < 16 || b < 16)
+        return false;
+    limits.maxLongSide = std::max(a, b);
+    limits.maxShortSide = std::min(a, b);
+    return true;
+}
+
+// Checks the non-codecs parameters of a content type. IsSupported means "no
+// objection" (the codecs decide), NotSupported means some parameter asks for
+// something this engine cannot do:
+//  - width/height beyond `limits` (1080p by default), framerate above 120,
+//    channels above 8, or a value that is not a number;
+//  - eotf other than bt709 (smpte2084 and arib-std-b67 are HDR transfer
+//    functions; there is no HDR output);
+//  - decode-to-texture other than true/false, experimental other than
+//    allowed/true/false, tunnelmode other than false (no tunneled playback);
+//  - cryptoblockformat with any value (no EME).
+// Unknown parameters are ignored.
+inline Support evaluateContentTypeParameters(const std::vector<ContentTypeParameter>& parameters, const VideoLimits& limits = { })
+{
+    double width = 0;
+    double height = 0;
+    for (auto& parameter : parameters) {
+        auto& name = parameter.name;
+        auto value = lowercase(trim(parameter.value));
+        double number = 0;
+        if (name == "width" || name == "height") {
+            if (!parseDecimal(value, number) || number > limits.maxLongSide)
+                return Support::NotSupported;
+            (name == "width" ? width : height) = number;
+        } else if (name == "framerate") {
+            if (!parseDecimal(value, number) || number > maxFrameRate)
+                return Support::NotSupported;
+        } else if (name == "channels") {
+            if (!parseDecimal(value, number) || number > maxAudioChannels)
+                return Support::NotSupported;
+        } else if (name == "bitrate") {
+            if (!parseDecimal(value, number))
+                return Support::NotSupported;
+        } else if (name == "eotf") {
+            if (value != "bt709")
+                return Support::NotSupported;
+        } else if (name == "decode-to-texture") {
+            if (value != "true" && value != "false")
+                return Support::NotSupported;
+        } else if (name == "experimental") {
+            if (value != "allowed" && value != "true" && value != "false")
+                return Support::NotSupported;
+        } else if (name == "tunnelmode") {
+            if (value != "false")
+                return Support::NotSupported;
+        } else if (name == "cryptoblockformat")
+            return Support::NotSupported;
+    }
+    if (width > 0 && height > 0 && std::min(width, height) > limits.maxShortSide)
+        return Support::NotSupported;
+    return Support::IsSupported;
+}
+
+inline Support combineSupport(Support a, Support b)
+{
+    if (a == Support::NotSupported || b == Support::NotSupported)
+        return Support::NotSupported;
+    if (a == Support::MaybeSupported || b == Support::MaybeSupported)
+        return Support::MaybeSupported;
+    return Support::IsSupported;
+}
+
+// MediaSource.isTypeSupported() / addSourceBuffer() answer for a full content
+// type string. No container (MediaPlayer choosing an engine for a MediaSource
+// before any type is known) is "maybe", so this engine gets selected.
+inline Support evaluateMediaSource(std::string_view rawContentType, const DecoderAvailability& decoders, const VideoLimits& limits = { })
+{
+    std::string mimeType;
+    auto parameters = parseContentTypeParameters(rawContentType, &mimeType);
+    if (mimeType.empty())
+        return Support::MaybeSupported;
+    auto container = mediaSourceContainerForMIMEType(mimeType);
+    if (container == Container::Unknown)
+        return Support::NotSupported;
+
+    std::vector<std::string> codecs;
+    bool hasCodecs = false;
+    for (auto& parameter : parameters) {
+        if (parameter.name == "codecs") {
+            hasCodecs = true;
+            codecs = splitCodecs(parameter.value);
+        }
+    }
+    if (hasCodecs && codecs.empty())
+        return Support::NotSupported;
+    bool isAudioType = startsWith(lowercase(mimeType), "audio/");
+    for (auto& codec : codecs) {
+        if (isAudioType && isVideoFamily(codecFamily(codec)))
+            return Support::NotSupported;
+    }
+    auto codecSupport = evaluate(mimeType, codecs, decoders);
+    return combineSupport(codecSupport, evaluateContentTypeParameters(parameters, limits));
+}
+
+} // namespace FFmpegMedia
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegTimeRanges.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegTimeRanges.h
new file mode 100644
index 000000000..42b33eef1
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegTimeRanges.h
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Sorted, non-overlapping set of half-open [start, end) time ranges in
+// seconds. Engine-independent; the demuxer records what it has demuxed here
+// and the player converts it into PlatformTimeRanges for buffered().
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <vector>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+class TimeRangeSet {
+public:
+    struct Range {
+        double start;
+        double end;
+    };
+
+    // Ranges closer than this are merged: demuxed packets of one stream are
+    // contiguous but timestamps carry rounding error.
+    static constexpr double mergeTolerance = 0.05;
+
+    void add(double start, double end)
+    {
+        if (!std::isfinite(start) || !std::isfinite(end) || end <= start)
+            return;
+        Range added { start, end };
+        std::vector<Range> merged;
+        merged.reserve(m_ranges.size() + 1);
+        bool inserted = false;
+        for (auto& range : m_ranges) {
+            if (range.end + mergeTolerance < added.start) {
+                merged.push_back(range);
+                continue;
+            }
+            if (added.end + mergeTolerance < range.start) {
+                if (!inserted) {
+                    merged.push_back(added);
+                    inserted = true;
+                }
+                merged.push_back(range);
+                continue;
+            }
+            added.start = std::min(added.start, range.start);
+            added.end = std::max(added.end, range.end);
+        }
+        if (!inserted)
+            merged.push_back(added);
+        m_ranges = std::move(merged);
+    }
+
+    void clear() { m_ranges.clear(); }
+    bool isEmpty() const { return m_ranges.empty(); }
+    size_t size() const { return m_ranges.size(); }
+    const Range& operator[](size_t i) const { return m_ranges[i]; }
+    const std::vector<Range>& ranges() const { return m_ranges; }
+
+    bool contains(double time) const
+    {
+        for (auto& range : m_ranges) {
+            if (time >= range.start - mergeTolerance && time < range.end)
+                return true;
+        }
+        return false;
+    }
+
+    // Seconds of contiguous data available from `time` on (0 if `time` is
+    // not buffered). Drives the HAVE_FUTURE_DATA/HAVE_ENOUGH_DATA decision.
+    double bufferedAhead(double time) const
+    {
+        for (auto& range : m_ranges) {
+            if (time >= range.start - mergeTolerance && time < range.end)
+                return range.end - time;
+        }
+        return 0;
+    }
+
+    double totalDuration() const
+    {
+        double total = 0;
+        for (auto& range : m_ranges)
+            total += range.end - range.start;
+        return total;
+    }
+
+private:
+    std::vector<Range> m_ranges;
+};
+
+} // namespace FFmpegMedia
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegUtilities.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegUtilities.h
new file mode 100644
index 000000000..4b6fe252f
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegUtilities.h
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// ffmpeg RAII helpers and timestamp conversion shared by the ffmpeg media
+// engine (demuxer, decoders, player).
+
+#pragma once
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include <cmath>
+#include <limits>
+#include <memory>
+#include <wtf/text/WTFString.h>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/avutil.h>
+#include <libavutil/error.h>
+#include <libavutil/mem.h>
+}
+
+namespace WebCore {
+
+struct AVPacketDeleter {
+    void operator()(AVPacket* packet) const { av_packet_free(&packet); }
+};
+using AVPacketPtr = std::unique_ptr<AVPacket, AVPacketDeleter>;
+
+struct AVFrameDeleter {
+    void operator()(AVFrame* frame) const { av_frame_free(&frame); }
+};
+using AVFramePtr = std::unique_ptr<AVFrame, AVFrameDeleter>;
+
+struct AVCodecContextDeleter {
+    void operator()(AVCodecContext* context) const { avcodec_free_context(&context); }
+};
+using AVCodecContextPtr = std::unique_ptr<AVCodecContext, AVCodecContextDeleter>;
+
+struct AVCodecParametersDeleter {
+    void operator()(AVCodecParameters* parameters) const { avcodec_parameters_free(&parameters); }
+};
+using AVCodecParametersPtr = std::unique_ptr<AVCodecParameters, AVCodecParametersDeleter>;
+
+// Immutable description of one demuxed stream, handed from the demuxer to a
+// decoder. Times are in seconds on the media timeline: stream timestamps
+// minus the container start time, so the media starts at 0.
+struct FFmpegStreamInfo {
+    int index { -1 };
+    AVRational timeBase { 0, 1 };
+    double startTime { 0 };
+    AVCodecParametersPtr parameters;
+
+    double toSeconds(int64_t timestamp) const
+    {
+        if (timestamp == AV_NOPTS_VALUE || !timeBase.den)
+            return std::numeric_limits<double>::quiet_NaN();
+        return timestamp * av_q2d(timeBase) - startTime;
+    }
+};
+
+// libavcodec's native AV1 decoder only drives hardware accelerators, so AV1
+// needs libdav1d or libaom (absent from the PS5 SDK build).
+inline const AVCodec* findSoftwareDecoder(AVCodecID codecId)
+{
+    if (codecId == AV_CODEC_ID_AV1) {
+        if (auto* codec = avcodec_find_decoder_by_name("libdav1d"))
+            return codec;
+        return avcodec_find_decoder_by_name("libaom-av1");
+    }
+    return avcodec_find_decoder(codecId);
+}
+
+inline String ffmpegErrorString(int error)
+{
+    char buffer[AV_ERROR_MAX_STRING_SIZE] = { };
+    av_strerror(error, buffer, sizeof(buffer));
+    return String::fromLatin1(buffer);
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegVideoDecoder.cpp b/Source/WebCore/platform/graphics/ffmpeg/FFmpegVideoDecoder.cpp
new file mode 100644
index 000000000..5f5f03655
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegVideoDecoder.cpp
@@ -0,0 +1,459 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "config.h"
+#include "FFmpegVideoDecoder.h"
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "FFmpegDemuxer.h"
+#include "FFmpegLog.h"
+#include "Logging.h"
+#include <cstdlib>
+#include <cstring>
+
+extern "C" {
+#include <libavutil/imgutils.h>
+#include <libavutil/pixdesc.h>
+#include <libswscale/swscale.h>
+#include <wtf/MonotonicTime.h>
+}
+
+namespace WebCore {
+
+namespace {
+
+constexpr Seconds packetWaitTimeout = 20_ms;
+constexpr Seconds outputWaitTimeout = 20_ms;
+// Decoded frames waiting for presentation. Small: each 1080p BGRA frame is
+// 8 MiB, and the presentation tick only ever needs the next one or two.
+constexpr size_t maxOutputFrames = 3;
+constexpr size_t maxPooledFrames = 5;
+// Output is capped at 1080p; anything bigger is downscaled by swscale.
+constexpr int maxOutputWidth = 1920;
+constexpr int maxOutputHeight = 1080;
+// Decoder threads: 6 of the Zen 2's 8 cores, leaving 2 for the UI process,
+// networking and the audio decoder (PROSPEROWEB_MEDIA_THREADS=1..16).
+// Frame and slice threading: frame threading is what scales H.264 and VP9
+// across cores. The console crashes of run 4/5 that first pointed at the
+// frame threads ("av:h264:df*") were the swscale overrun fixed in
+// FFmpegPlaybackPolicy.h, not frame threading;
+// PROSPEROWEB_MEDIA_FRAME_THREADS=0 goes back to slice threads only.
+constexpr int defaultDecoderThreads = 6;
+
+int decoderThreads()
+{
+    if (const char* value = getenv("PROSPEROWEB_MEDIA_THREADS")) {
+        int count = atoi(value);
+        if (count >= 1 && count <= 16)
+            return count;
+    }
+    return defaultDecoderThreads;
+}
+
+bool frameThreadsEnabled()
+{
+    const char* value = getenv("PROSPEROWEB_MEDIA_FRAME_THREADS");
+    return !value || strcmp(value, "0");
+}
+
+int64_t nowMicroseconds()
+{
+    return static_cast<int64_t>(MonotonicTime::now().secondsSinceEpoch().microseconds());
+}
+// A frame this far behind the clock is dropped before conversion; one in
+// lateFrameKeepInterval late frames is still shown so the picture moves.
+constexpr double lateThreshold = 0.08;
+constexpr unsigned lateFrameKeepInterval = 8;
+// Falling behind: first skip deblocking of non-reference frames, then of
+// all frames.
+constexpr unsigned lateFramesBeforeSkippingLoopFilter = 4;
+constexpr unsigned lateFramesBeforeSkippingAllLoopFilter = 12;
+
+int swsColorspace(const AVFrame* frame)
+{
+    switch (frame->colorspace) {
+    case AVCOL_SPC_BT709:
+        return SWS_CS_ITU709;
+    case AVCOL_SPC_BT2020_NCL:
+    case AVCOL_SPC_BT2020_CL:
+        return SWS_CS_BT2020;
+    case AVCOL_SPC_SMPTE170M:
+    case AVCOL_SPC_BT470BG:
+        return SWS_CS_ITU601;
+    default:
+        // Unspecified: HD content is BT.709 in practice.
+        return frame->height >= 720 ? SWS_CS_ITU709 : SWS_CS_ITU601;
+    }
+}
+
+// Process-wide totals for ps5_media_video_decoder_stats().
+std::atomic<unsigned> liveDecoders { 0 };
+std::atomic<unsigned> liveDecoderThreads { 0 };
+
+} // namespace
+
+RefPtr<FFmpegVideoDecoder> FFmpegVideoDecoder::create(const FFmpegStreamInfo& stream, FFmpegPacketQueue& queue)
+{
+    if (!stream.parameters)
+        return nullptr;
+    const AVCodec* codec = findSoftwareDecoder(stream.parameters->codec_id);
+    if (!codec)
+        return nullptr;
+    AVCodecContextPtr context(avcodec_alloc_context3(codec));
+    if (!context || avcodec_parameters_to_context(context.get(), stream.parameters.get()) < 0)
+        return nullptr;
+    context->pkt_timebase = stream.timeBase;
+    context->thread_count = decoderThreads();
+    context->thread_type = frameThreadsEnabled() ? (FF_THREAD_FRAME | FF_THREAD_SLICE) : FF_THREAD_SLICE;
+    int result = avcodec_open2(context.get(), codec, nullptr);
+    if (result < 0) {
+        ffmpegMediaLog("video decoder %s: open failed: %s", codec->name, ffmpegErrorString(result).utf8().legacyCStringPointer());
+        return nullptr;
+    }
+    ffmpegMediaLog("video decoder %s: %dx%d %s, %d threads (%s)", codec->name, context->width, context->height,
+        av_get_pix_fmt_name(context->pix_fmt) ? av_get_pix_fmt_name(context->pix_fmt) : "?", context->thread_count,
+        (context->active_thread_type & FF_THREAD_FRAME) ? "frame+slice" : (context->active_thread_type & FF_THREAD_SLICE) ? "slice" : "none");
+    return adoptRef(*new FFmpegVideoDecoder(stream, queue, WTF::move(context)));
+}
+
+FFmpegVideoDecoder::FFmpegVideoDecoder(const FFmpegStreamInfo& stream, FFmpegPacketQueue& queue, AVCodecContextPtr&& context)
+    : m_timeBase(stream.timeBase)
+    , m_startTime(stream.startTime)
+    , m_queue(queue)
+    , m_codec(WTF::move(context))
+    , m_frame(av_frame_alloc())
+{
+    updateOutputSize(m_codec->width, m_codec->height);
+    ++liveDecoders;
+    liveDecoderThreads += static_cast<unsigned>(std::max(1, m_codec->thread_count));
+}
+
+FFmpegVideoDecoder::~FFmpegVideoDecoder()
+{
+    ASSERT(!m_thread);
+    --liveDecoders;
+    liveDecoderThreads -= static_cast<unsigned>(std::max(1, m_codec->thread_count));
+    if (m_sws)
+        sws_freeContext(m_sws);
+}
+
+void FFmpegVideoDecoder::start()
+{
+    if (m_thread || !m_frame)
+        return;
+    m_thread = Thread::create("FFmpegVideoDecoder"_s, [protectedThis = Ref { *this }] {
+        protectedThis->run();
+    });
+}
+
+void FFmpegVideoDecoder::stop()
+{
+    m_stopping = true;
+    {
+        Locker locker { m_lock };
+        m_condition.notifyAll();
+    }
+    if (RefPtr thread = std::exchange(m_thread, nullptr))
+        thread->waitForCompletion();
+}
+
+void FFmpegVideoDecoder::updateOutputSize(int width, int height)
+{
+    if (width <= 0 || height <= 0)
+        return;
+    AVRational sar = m_codec->sample_aspect_ratio;
+    double displayWidth = width;
+    if (sar.num > 0 && sar.den > 0)
+        displayWidth = width * av_q2d(sar);
+    double scale = std::min({ 1.0, maxOutputWidth / displayWidth, maxOutputHeight / static_cast<double>(height) });
+    // Even dimensions keep swscale on its fast paths.
+    int outputWidth = std::max(2, static_cast<int>(std::lround(displayWidth * scale)) & ~1);
+    int outputHeight = std::max(2, static_cast<int>(std::lround(height * scale)) & ~1);
+    m_outputWidth = outputWidth;
+    m_outputHeight = outputHeight;
+}
+
+void FFmpegVideoDecoder::run()
+{
+    while (!m_stopping) {
+        auto entry = m_queue.pop(packetWaitTimeout);
+        if (!entry) {
+            if (m_queue.isAborted())
+                break;
+            continue;
+        }
+        if (entry->serial != m_serial)
+            flushForSerial(entry->serial);
+        if (entry->isEndOfStream()) {
+            avcodec_send_packet(m_codec.get(), nullptr);
+            receiveFrames();
+            // Draining leaves the codec in EOF state; reset it for whatever
+            // comes next (a seek, or a looping restart).
+            avcodec_flush_buffers(m_codec.get());
+            Locker locker { m_lock };
+            m_endSerial = m_serial;
+            m_condition.notifyAll();
+            continue;
+        }
+        if (!handlePacket(entry->packet.get()))
+            break;
+    }
+}
+
+void FFmpegVideoDecoder::flushForSerial(unsigned serial)
+{
+    avcodec_flush_buffers(m_codec.get());
+    m_serial = serial;
+    m_waitingForKeyframe = false;
+    m_lateFrames = 0;
+    if (m_skippingLoopFilter) {
+        m_codec->skip_loop_filter = AVDISCARD_DEFAULT;
+        m_skippingLoopFilter = false;
+    }
+    Locker locker { m_lock };
+    m_output.removeAllMatching([serial](auto& frame) {
+        return frame->serial != serial;
+    });
+    m_endSerial = std::numeric_limits<unsigned>::max();
+    m_condition.notifyAll();
+}
+
+bool FFmpegVideoDecoder::handlePacket(AVPacket* packet)
+{
+    if (m_suspended) {
+        m_waitingForKeyframe = true;
+        return true;
+    }
+    if (m_waitingForKeyframe) {
+        if (!(packet->flags & AV_PKT_FLAG_KEY))
+            return true;
+        avcodec_flush_buffers(m_codec.get());
+        m_waitingForKeyframe = false;
+    }
+
+    int64_t start = nowMicroseconds();
+    m_pendingConvertMicros = 0;
+    int result = avcodec_send_packet(m_codec.get(), packet);
+    if (result == AVERROR(EAGAIN)) {
+        receiveFrames();
+        result = avcodec_send_packet(m_codec.get(), packet);
+    }
+    if (result < 0 && result != AVERROR(EAGAIN) && result != AVERROR_EOF) {
+        // Corrupt packets are routine in live streams; keep going.
+        if (!(m_sendErrors++ % 100))
+            ffmpegMediaLog("video decoder: send_packet: %s (%u errors)", ffmpegErrorString(result).utf8().legacyCStringPointer(), m_sendErrors);
+    }
+    receiveFrames();
+    // Wall time in libavcodec (with frame threads: waiting for the
+    // threads), without the conversions done in between.
+    m_decodeMicros += std::max<int64_t>(0, nowMicroseconds() - start - m_pendingConvertMicros);
+    return !m_stopping;
+}
+
+FFmpegVideoDecoder::Timing FFmpegVideoDecoder::takeTiming()
+{
+    unsigned decoded = m_decodedFrames;
+    unsigned converted = m_convertedFrames;
+    int64_t decodeMicros = m_decodeMicros;
+    int64_t convertMicros = m_convertMicros;
+    Timing timing;
+    if (decoded > m_timingDecoded)
+        timing.decodeMilliseconds = (decodeMicros - m_timingDecodeMicros) / 1000.0 / (decoded - m_timingDecoded);
+    if (converted > m_timingConverted)
+        timing.convertMilliseconds = (convertMicros - m_timingConvertMicros) / 1000.0 / (converted - m_timingConverted);
+    m_timingDecoded = decoded;
+    m_timingConverted = converted;
+    m_timingDecodeMicros = decodeMicros;
+    m_timingConvertMicros = convertMicros;
+    return timing;
+}
+
+void FFmpegVideoDecoder::receiveFrames()
+{
+    while (!m_stopping) {
+        int result = avcodec_receive_frame(m_codec.get(), m_frame.get());
+        if (result == AVERROR(EAGAIN) || result == AVERROR_EOF)
+            return;
+        if (result < 0) {
+            if (!(m_sendErrors++ % 100))
+                ffmpegMediaLog("video decoder: receive_frame: %s", ffmpegErrorString(result).utf8().legacyCStringPointer());
+            return;
+        }
+        ++m_decodedFrames;
+        emitFrame(m_frame.get());
+        av_frame_unref(m_frame.get());
+    }
+}
+
+RefPtr<FFmpegVideoFrame> FFmpegVideoDecoder::takePoolFrame(int width, int height)
+{
+    // A pooled frame referenced only by the pool is neither queued nor held
+    // by the player or a NativeImage, so it can be overwritten.
+    m_pool.removeAllMatching([&](auto& frame) {
+        return frame->hasOneRef() && (frame->width() != width || frame->height() != height);
+    });
+    for (auto& frame : m_pool) {
+        if (frame->hasOneRef())
+            return frame.ptr();
+    }
+    RefPtr frame = FFmpegVideoFrame::create(width, height);
+    if (!frame) {
+        ffmpegMediaLog("video decoder: cannot allocate a %dx%d frame", width, height);
+        return nullptr;
+    }
+    if (m_pool.size() < maxPooledFrames) {
+        m_pool.append(Ref { *frame });
+        ffmpegMediaLog("video decoder: frame pool %zu x %dx%d (stride %zu, %zu KiB each)", m_pool.size(), width, height,
+            frame->stride(), frame->sizeInBytes() >> 10);
+    }
+    return frame;
+}
+
+void FFmpegVideoDecoder::emitFrame(AVFrame* frame)
+{
+    double pts = (frame->best_effort_timestamp == AV_NOPTS_VALUE || !m_timeBase.den)
+        ? std::numeric_limits<double>::quiet_NaN()
+        : frame->best_effort_timestamp * av_q2d(m_timeBase) - m_startTime;
+    double duration = frame->duration > 0 ? frame->duration * av_q2d(m_timeBase) : 0;
+    if (duration <= 0 && m_codec->framerate.num > 0 && m_codec->framerate.den > 0)
+        duration = av_q2d(av_inv_q(m_codec->framerate));
+    if (duration <= 0)
+        duration = 1.0 / 30;
+    if (!std::isfinite(pts))
+        return;
+
+    {
+        Locker locker { m_lock };
+        if (m_seekTarget >= 0 && m_seekSerial == m_serial) {
+            if (pts + duration <= m_seekTarget)
+                return;
+            m_seekTarget = -1;
+        }
+    }
+
+    bool isLate = pts + duration < m_clockHint - lateThreshold;
+    if (isLate) {
+        ++m_lateFrames;
+        if (m_lateFrames >= lateFramesBeforeSkippingLoopFilter && !m_skippingLoopFilter) {
+            // Deblocking is a large share of H.264 decode time; skipping it
+            // costs some quality but lets a slow CPU catch up.
+            m_codec->skip_loop_filter = AVDISCARD_NONREF;
+            m_skippingLoopFilter = true;
+        }
+        if (m_lateFrames >= lateFramesBeforeSkippingAllLoopFilter && m_codec->skip_loop_filter != AVDISCARD_ALL)
+            m_codec->skip_loop_filter = AVDISCARD_ALL;
+        if (m_lateFrames % lateFrameKeepInterval) {
+            ++m_droppedFrames;
+            return;
+        }
+    } else {
+        m_lateFrames = 0;
+        if (m_skippingLoopFilter) {
+            m_codec->skip_loop_filter = AVDISCARD_DEFAULT;
+            m_skippingLoopFilter = false;
+        }
+    }
+
+    updateOutputSize(frame->width, frame->height);
+    int width = m_outputWidth;
+    int height = m_outputHeight;
+    RefPtr output = takePoolFrame(width, height);
+    if (!output) {
+        ++m_droppedFrames;
+        return;
+    }
+    // Same size: only the YUV to BGRA conversion, no filtering needed.
+    int64_t convertStart = nowMicroseconds();
+    int swsFlags = (width == frame->width && height == frame->height) ? SWS_POINT : SWS_FAST_BILINEAR;
+    m_sws = sws_getCachedContext(m_sws, frame->width, frame->height, static_cast<AVPixelFormat>(frame->format),
+        width, height, AV_PIX_FMT_BGRA, swsFlags, nullptr, nullptr, nullptr);
+    if (!m_sws) {
+        ffmpegMediaLog("video decoder: no swscale path from %s", av_get_pix_fmt_name(static_cast<AVPixelFormat>(frame->format)));
+        m_fatalError = true;
+        return;
+    }
+    bool fullRange = frame->color_range == AVCOL_RANGE_JPEG;
+    sws_setColorspaceDetails(m_sws, sws_getCoefficients(swsColorspace(frame)), fullRange ? 1 : 0,
+        sws_getCoefficients(SWS_CS_DEFAULT), 1, 0, 1 << 16, 1 << 16);
+    uint8_t* destination[4] = { output->data(), nullptr, nullptr, nullptr };
+    int destinationStride[4] = { static_cast<int>(output->stride()), 0, 0, 0 };
+    sws_scale(m_sws, frame->data, frame->linesize, 0, frame->height, destination, destinationStride);
+    int64_t convertMicros = nowMicroseconds() - convertStart;
+    m_convertMicros += convertMicros;
+    m_pendingConvertMicros += convertMicros;
+    ++m_convertedFrames;
+    output->pts = pts;
+    output->duration = duration;
+    output->serial = m_serial;
+
+    Locker locker { m_lock };
+    while (m_output.size() >= maxOutputFrames && !m_stopping && m_queue.serial() == m_serial)
+        m_condition.waitFor(m_lock, outputWaitTimeout);
+    if (m_stopping || m_queue.serial() != m_serial)
+        return;
+    m_output.append(output.releaseNonNull());
+}
+
+RefPtr<FFmpegVideoFrame> FFmpegVideoDecoder::peekFrame(unsigned serial, size_t index)
+{
+    Locker locker { m_lock };
+    while (!m_output.isEmpty() && m_output.first()->serial != serial) {
+        m_output.removeFirst();
+        m_condition.notifyAll();
+    }
+    if (index >= m_output.size())
+        return nullptr;
+    auto it = m_output.begin();
+    for (size_t i = 0; i < index; ++i)
+        ++it;
+    if ((*it)->serial != serial)
+        return nullptr;
+    return it->ptr();
+}
+
+void FFmpegVideoDecoder::popFrame()
+{
+    Locker locker { m_lock };
+    if (!m_output.isEmpty())
+        m_output.removeFirst();
+    m_condition.notifyAll();
+}
+
+size_t FFmpegVideoDecoder::queuedFrames() const
+{
+    Locker locker { m_lock };
+    return m_output.size();
+}
+
+bool FFmpegVideoDecoder::reachedEnd(unsigned serial) const
+{
+    Locker locker { m_lock };
+    return m_endSerial == serial && m_output.isEmpty();
+}
+
+void FFmpegVideoDecoder::setSeekTarget(double time, unsigned serial)
+{
+    m_clockHint = time;
+    Locker locker { m_lock };
+    m_seekTarget = time;
+    m_seekSerial = serial;
+    m_condition.notifyAll();
+}
+
+void FFmpegVideoDecoder::setSuspended(bool suspended)
+{
+    m_suspended = suspended;
+}
+
+} // namespace WebCore
+
