+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Demuxer of the ffmpeg media engine: one thread that opens the resource
+// with libavformat (progressive MP4/WebM/MP3/Ogg/..., and HLS through
+// libavformat's hls demuxer), selects one video and one audio stream and
+// fills a packet queue per stream. Seeks are requested asynchronously and
+// tagged with a serial number that flows through the queues to the decoders,
+// so stale packets and frames are recognised and dropped.
+
+#pragma once
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include "FFmpegPlaybackPolicy.h"
+#include "FFmpegResourceIO.h"
+#include "FFmpegTimeRanges.h"
+#include "FFmpegUtilities.h"
+#include <atomic>
+#include <optional>
+#include <wtf/Condition.h>
+#include <wtf/Deque.h>
+#include <wtf/Lock.h>
+#include <wtf/Seconds.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/Threading.h>
+#include <wtf/URL.h>
+
+namespace WebCore {
+
+class PlatformMediaResourceLoader;
+
+class FFmpegPacketQueue {
+    WTF_MAKE_NONCOPYABLE(FFmpegPacketQueue);
+public:
+    FFmpegPacketQueue() = default;
+
+    struct Entry {
+        AVPacketPtr packet; // null: end of stream for `serial`
+        unsigned serial { 0 };
+        bool isEndOfStream() const { return !packet; }
+    };
+
+    void setTimeBase(AVRational timeBase) { m_timeBase = timeBase; }
+    void setEnabled(bool enabled) { m_enabled = enabled; }
+    bool enabled() const { return m_enabled; }
+
+    void push(AVPacketPtr&&, unsigned serial);
+    void pushEndOfStream(unsigned serial);
+    // Waits up to `timeout`. Returns nullopt on timeout or abort.
+    std::optional<Entry> pop(Seconds timeout);
+    void flush(unsigned newSerial);
+    void abort();
+
+    bool isAborted() const { return m_aborted; }
+    unsigned serial() const { return m_serial; }
+    FFmpegMedia::QueueLevel level() const;
+    size_t bytes() const;
+
+private:
+    mutable Lock m_lock;
+    Condition m_condition;
+    Deque<Entry> m_entries WTF_GUARDED_BY_LOCK(m_lock);
+    size_t m_bytes WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    int64_t m_lastTimestamp WTF_GUARDED_BY_LOCK(m_lock) { AV_NOPTS_VALUE };
+    AVRational m_timeBase { 1, 1 };
+    std::atomic<unsigned> m_serial { 0 };
+    std::atomic<bool> m_aborted { false };
+    bool m_enabled { false };
+};
+
+class FFmpegDemuxer final : public ThreadSafeRefCounted<FFmpegDemuxer> {
+public:
+    static Ref<FFmpegDemuxer> create(const URL&, Ref<PlatformMediaResourceLoader>&&, const String& userAgent);
+    ~FFmpegDemuxer();
+
+    void start();
+    // Aborts all I/O and joins the thread. Idempotent; main thread.
+    void stop();
+
+    enum class State : uint8_t { Opening, Ready, Failed };
+    struct Status {
+        State state { State::Opening };
+        FFmpegMedia::LoadFailure failure { FFmpegMedia::LoadFailure::None };
+        bool endOfStream { false };
+        bool readerWaiting { false };
+        uint64_t bytesReceived { 0 };
+        FFmpegMedia::TimeRangeSet buffered;
+        // Serial of the last seek the demuxer could not perform (0: none):
+        // reading went on from the old position.
+        unsigned seekFailedSerial { 0 };
+        // Serial of the last seek the demuxer has performed.
+        unsigned seekDoneSerial { 0 };
+    };
+    Status status() const;
+
+    // Valid once status().state == Ready; immutable from then on.
+    const FFmpegStreamInfo* videoStream() const { return m_video.index >= 0 ? &m_video : nullptr; }
+    const FFmpegStreamInfo* audioStream() const { return m_audio.index >= 0 ? &m_audio : nullptr; }
+    // NaN while unknown, +infinity for live streams.
+    double duration() const { return m_duration; }
+    bool isLive() const { return m_isLive; }
+    bool isSeekable() const { return m_isSeekable; }
+    bool isHLS() const { return m_isHLS; }
+    bool didPassAccessControlCheck() const { return m_shared->sawResponse && m_shared->didPassAccessControlCheck; }
+
+    FFmpegPacketQueue& videoQueue() { return m_videoQueue; }
+    FFmpegPacketQueue& audioQueue() { return m_audioQueue; }
+
+    // Main thread. Packets demuxed after the seek carry `serial`.
+    void seek(double time, unsigned serial);
+
+private:
+    FFmpegDemuxer(const URL&, Ref<PlatformMediaResourceLoader>&&, const String& userAgent);
+
+    void run();
+    bool openInput();
+    void selectStreams();
+    void readLoop();
+    void performSeek(double time, unsigned serial);
+    int seekTo(double time);
+    void logStreams() const;
+    void fail(FFmpegMedia::LoadFailure);
+    void closeInput();
+    bool usesResourceLoader(const URL&) const;
+
+    static int interruptCallback(void*);
+    static int ioOpen(AVFormatContext*, AVIOContext**, const char* url, int flags, AVDictionary** options);
+    static int ioClose(AVFormatContext*, AVIOContext*);
+
+    const URL m_url;
+    const Ref<PlatformMediaResourceLoader> m_loader;
+    const String m_userAgent;
+    const Ref<FFmpegIOShared> m_shared;
+    RefPtr<Thread> m_thread;
+
+    // Demuxer thread only.
+    AVFormatContext* m_context { nullptr };
+    AVIOContext* m_topLevelIO { nullptr };
+    int (*m_defaultIoOpen)(AVFormatContext*, AVIOContext**, const char*, int, AVDictionary**) { nullptr };
+    int (*m_defaultIoClose)(AVFormatContext*, AVIOContext*) { nullptr };
+    unsigned m_serial { 0 };
+    double m_segmentStart { 0 };
+
+    // Written by the demuxer thread before State::Ready is published.
+    FFmpegStreamInfo m_video;
+    FFmpegStreamInfo m_audio;
+    double m_duration { std::numeric_limits<double>::quiet_NaN() };
+    bool m_isLive { false };
+    bool m_isSeekable { false };
+    bool m_isHLS { false };
+
+    FFmpegPacketQueue m_videoQueue;
+    FFmpegPacketQueue m_audioQueue;
+
+    mutable Lock m_lock;
+    Condition m_condition;
+    State m_state WTF_GUARDED_BY_LOCK(m_lock) { State::Opening };
+    FFmpegMedia::LoadFailure m_failure WTF_GUARDED_BY_LOCK(m_lock) { FFmpegMedia::LoadFailure::None };
+    bool m_endOfStream WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_readerWaiting WTF_GUARDED_BY_LOCK(m_lock) { false };
+    FFmpegMedia::TimeRangeSet m_buffered WTF_GUARDED_BY_LOCK(m_lock);
+    std::optional<std::pair<double, unsigned>> m_pendingSeek WTF_GUARDED_BY_LOCK(m_lock);
+    unsigned m_seekFailedSerial WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    unsigned m_seekDoneSerial WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegLog.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegLog.h
new file mode 100644
index 000000000..bef2fb676
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegLog.h
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Console diagnostics of the ffmpeg media engine. On the PS5 the shell
+// executable defines ps5_log_line() (src/frontend/ps5/ps5_log.cpp), which
+// prefixes "[ms role]" and appends to /data/prosperoweb/log.txt; WebCore only
+// sees a weak declaration, so builds without that symbol (the smoke test,
+// other embedders) still link and log nothing. Lines start with "media:".
+// Thread-safe: ps5_log_line is.
+
+#pragma once
+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+
+#include <cstdarg>
+#include <cstdio>
+
+extern "C" void ps5_log_line(const char*) __attribute__((weak));
+
+namespace WebCore {
+
+inline bool ffmpegMediaLogEnabled()
+{
+    return !!ps5_log_line;
+}
+
+inline void ffmpegMediaLog(const char* format, ...) __attribute__((format(printf, 1, 2)));
+
+inline void ffmpegMediaLog(const char* format, ...)
+{
+    if (!ps5_log_line)
+        return;
+    char line[512];
+    int prefix = snprintf(line, sizeof(line), "media: ");
+    va_list arguments;
+    va_start(arguments, format);
+    vsnprintf(line + prefix, sizeof(line) - prefix, format, arguments);
+    va_end(arguments);
+    ps5_log_line(line);
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegPlaybackPolicy.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegPlaybackPolicy.h
new file mode 100644
index 000000000..92ea7d596
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegPlaybackPolicy.h
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Buffering thresholds and the HTML readyState/networkState decisions of the
+// ffmpeg media engine, as pure functions so they can be unit tested and
+// reused by a future MSE player.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+// Demuxer read-ahead limits. Reading pauses (networkState IDLE) when either
+// the total queued bytes reach maxQueuedBytes or every enabled stream has at
+// least maxQueuedSeconds queued; it resumes once that is no longer true.
+inline constexpr size_t maxQueuedBytes = 24u << 20;
+inline constexpr double maxQueuedSeconds = 10.0;
+// HLS reads further ahead: segment servers stall for many seconds at a time
+// (rezka: 17 s without a segment), and the byte cap above still bounds it.
+inline constexpr double hlsQueuedSeconds = 30.0;
+// A stream with fewer packets than this is never considered "full" (sparse
+// streams or broken durations must not stall the other stream).
+inline constexpr size_t minQueuedPackets = 25;
+
+struct QueueLevel {
+    bool enabled { false };
+    size_t packets { 0 };
+    double seconds { 0 };
+};
+
+inline bool streamHasEnough(const QueueLevel& queue, double targetSeconds = maxQueuedSeconds)
+{
+    return !queue.enabled || (queue.packets >= minQueuedPackets && queue.seconds >= targetSeconds);
+}
+
+inline bool demuxerShouldWait(size_t totalBytes, const QueueLevel& video, const QueueLevel& audio, double targetSeconds = maxQueuedSeconds)
+{
+    if (totalBytes >= maxQueuedBytes)
+        return true;
+    if (!video.enabled && !audio.enabled)
+        return false;
+    return streamHasEnough(video, targetSeconds) && streamHasEnough(audio, targetSeconds);
+}
+
+// Network read-ahead per stream: a request is suspended above the high water
+// mark of unread data and resumed below the low one. A server that supports
+// Range resumes with a Range request. One that does not resumes by
+// restarting the download and skipping to the position, which is expensive,
+// so it gets a higher (but still finite) cap: buffering it without limit
+// could take the whole body of a long progressive video into memory.
+inline constexpr uint64_t networkHighWaterBytes = 8u << 20;
+inline constexpr uint64_t networkLowWaterBytes = 2u << 20;
+inline constexpr uint64_t networkNoRangeHighWaterBytes = 32u << 20;
+
+// unreadBytes: received data at or after the read position. size: total
+// resource size, or < 0 when unknown (no Content-Length, chunked).
+// receivedEnd: offset one past the last received byte.
+inline bool networkShouldSuspend(uint64_t unreadBytes, uint64_t receivedEnd, int64_t size, bool rangesSupported)
+{
+    if (size > 0 && receivedEnd >= static_cast<uint64_t>(size))
+        return false; // everything is here; the request is about to finish
+    return unreadBytes > (rangesSupported ? networkHighWaterBytes : networkNoRangeHighWaterBytes);
+}
+
+inline bool networkShouldResume(uint64_t unreadBytes)
+{
+    return unreadBytes < networkLowWaterBytes;
+}
+
+// Stalled or failed media requests (FFmpegResourceIO.cpp). A request that
+// delivers no bytes for networkStallSeconds while the demuxer waits for
+// them, or that fails with a network error or a retryable HTTP status, is
+// cancelled and issued again from the current offset (a Range request),
+// after a backoff of 0.5, 1 and 2 s. After networkMaxRetries the stream
+// fails as before. Bytes arriving reset the count: each stall of a long
+// download gets its own retries.
+inline constexpr double networkStallSeconds = 8.0;
+inline constexpr unsigned networkMaxRetries = 3;
+
+inline bool networkStalled(double lastProgressAt, double now)
+{
+    return now - lastProgressAt >= networkStallSeconds;
+}
+
+// HTTP status of a failed response worth retrying: server errors, 408 and
+// 429. Other 4xx are final. 0 stands for a network failure (no response).
+inline bool networkStatusIsRetryable(int status)
+{
+    return !status || status == 408 || status == 429 || (status >= 500 && status <= 599);
+}
+
+class NetworkRetry {
+public:
+    struct Decision {
+        bool retry { false };
+        unsigned attempt { 0 }; // 1-based, when retry
+        double delaySeconds { 0 };
+    };
+
+    // A stall or a retryable failure: retry after the next backoff, or give up.
+    Decision onFailure()
+    {
+        Decision decision;
+        if (m_attempts >= networkMaxRetries)
+            return decision;
+        decision.retry = true;
+        decision.attempt = ++m_attempts;
+        decision.delaySeconds = 0.5 * static_cast<double>(1u << (decision.attempt - 1));
+        return decision;
+    }
+
+    // Bytes arrived: the connection works again.
+    void onProgress() { m_attempts = 0; }
+    unsigned attempts() const { return m_attempts; }
+
+private:
+    unsigned m_attempts { 0 };
+};
+
+// Layout of a decoded BGRA video frame. libswscale's x86 output loops store
+// 8 pixels per iteration (REAL_WRITEBGR32 in libswscale/x86/
+// swscale_template.c: "add $8, index; cmp dstw, index; jb"), so a row is
+// written up to the next multiple of 8 pixels: a tightly packed buffer
+// (stride = width * 4) is overrun by up to 28 bytes after its last row,
+// into the allocator's metadata. Rows are therefore padded to 64 bytes
+// (which is also what libswscale's SIMD paths want for alignment) and the
+// buffer gets a spare tail.
+inline constexpr size_t videoFrameAlignment = 64;
+inline constexpr size_t videoFrameTailPadding = 256;
+
+inline size_t videoFrameStride(int width)
+{
+    if (width <= 0)
+        return 0;
+    size_t bytes = static_cast<size_t>(width) * 4;
+    return (bytes + videoFrameAlignment - 1) & ~(videoFrameAlignment - 1);
+}
+
+inline size_t videoFrameBytes(int width, int height)
+{
+    if (width <= 0 || height <= 0)
+        return 0;
+    return videoFrameStride(width) * static_cast<size_t>(height) + videoFrameTailPadding;
+}
+
+// Thresholds on contiguous data ahead of the current position.
+inline constexpr double futureDataSeconds = 0.3;
+inline constexpr double enoughDataSeconds = 3.0;
+
+// Mirrors MediaPlayer::ReadyState without depending on WebCore.
+enum class ReadyLevel { HaveNothing, HaveMetadata, HaveCurrentData, HaveFutureData, HaveEnoughData };
+
+struct ReadyInputs {
+    bool metadataLoaded { false };
+    bool seeking { false };
+    // A frame for the current position is decoded (or, for audio-only media,
+    // decoded audio is queued for it).
+    bool currentDataAvailable { false };
+    double bufferedAheadSeconds { 0 };
+    // The demuxer has delivered everything (end of stream).
+    bool endOfStream { false };
+};
+
+inline ReadyLevel computeReadyLevel(const ReadyInputs& in)
+{
+    if (!in.metadataLoaded)
+        return ReadyLevel::HaveNothing;
+    if (in.seeking || !in.currentDataAvailable)
+        return ReadyLevel::HaveMetadata;
+    if (in.endOfStream || in.bufferedAheadSeconds >= enoughDataSeconds)
+        return ReadyLevel::HaveEnoughData;
+    if (in.bufferedAheadSeconds >= futureDataSeconds)
+        return ReadyLevel::HaveFutureData;
+    return ReadyLevel::HaveCurrentData;
+}
+
+// Mirrors MediaPlayer::NetworkState.
+enum class NetworkLevel { Empty, Idle, Loading, Loaded, FormatError, NetworkError, DecodeError };
+
+enum class LoadFailure { None, Open, Network, Decode };
+
+struct NetworkInputs {
+    bool started { false };
+    bool metadataLoaded { false };
+    LoadFailure failure { LoadFailure::None };
+    bool endOfStream { false };
+    bool readerWaiting { false };
+};
+
+inline NetworkLevel computeNetworkLevel(const NetworkInputs& in)
+{
+    switch (in.failure) {
+    case LoadFailure::Open:
+        // Nothing usable was found: the resource is not a playable format
+        // (or could not be fetched at all, which HTML reports the same way
+        // before metadata).
+        return in.metadataLoaded ? NetworkLevel::NetworkError : NetworkLevel::FormatError;
+    case LoadFailure::Network:
+        return in.metadataLoaded ? NetworkLevel::NetworkError : NetworkLevel::FormatError;
+    case LoadFailure::Decode:
+        return NetworkLevel::DecodeError;
+    case LoadFailure::None:
+        break;
+    }
+    if (!in.started)
+        return NetworkLevel::Idle;
+    if (in.endOfStream)
+        return NetworkLevel::Loaded;
+    if (in.readerWaiting && in.metadataLoaded)
+        return NetworkLevel::Idle;
+    return NetworkLevel::Loading;
+}
+
+} // namespace FFmpegMedia
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegPresenterPolicy.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegPresenterPolicy.h
new file mode 100644
index 000000000..d966fbf06
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegPresenterPolicy.h
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Frame presentation rules of the ffmpeg media engine's presenter thread
+// (FFmpegVideoPresenter.h). Engine-independent (no WebCore/WTF/ffmpeg):
+// callers pass the clock time, so the host tests drive it with a fake clock.
+//
+//  - a frame is due once the clock reached its pts (5 ms early tolerance);
+//    the presenter sleeps until then, at most maxWaitSeconds at a time,
+//    because an audio-driven clock can jump;
+//  - a due frame is shown even when it is late, unless it is more than
+//    1.5 frame intervals late and a newer frame is already decoded: then it
+//    is dropped and the newer one is considered instead;
+//  - paused or seeking, the first frame of a new position is shown at once.
+
+#pragma once
+
+#include <algorithm>
+#include <cstdio>
+#include <optional>
+#include <string>
+
+namespace WebCore {
+namespace FFmpegMedia {
+
+constexpr double presenterEarlyTolerance = 0.005;
+constexpr double presenterLateIntervals = 1.5;
+constexpr double presenterDefaultInterval = 1.0 / 30;
+constexpr double presenterMinWaitSeconds = 0.001;
+constexpr double presenterMaxWaitSeconds = 0.010;
+// No frame decoded yet while playing: poll the decoder's output this often.
+constexpr double presenterPollSeconds = 0.004;
+// Paused, nothing to show: the main thread wakes the presenter on changes.
+constexpr double presenterIdleSeconds = 0.020;
+
+enum class PresentAction { Wait, Show, Drop };
+
+struct PresentDecision {
+    PresentAction action { PresentAction::Wait };
+    // Wait: seconds of media time until the frame is due.
+    double untilDue { 0 };
+    // Show/Drop: how late the frame is (never negative).
+    double lateness { 0 };
+};
+
+// Frame duration, else the distance to the next frame, else 30 fps; bounded
+// so a broken timestamp neither drops everything nor nothing.
+inline double presentationInterval(double framePts, double frameDuration, std::optional<double> nextPts)
+{
+    double interval = frameDuration;
+    if (!(interval > 0) && nextPts && *nextPts > framePts)
+        interval = *nextPts - framePts;
+    if (!(interval > 0))
+        interval = presenterDefaultInterval;
+    return std::clamp(interval, 1.0 / 240, 0.25);
+}
+
+inline PresentDecision decidePresentation(double framePts, double frameDuration, std::optional<double> nextPts, double clock, bool showAtOnce)
+{
+    PresentDecision decision;
+    if (showAtOnce) {
+        decision.action = PresentAction::Show;
+        decision.lateness = std::max(0.0, clock - framePts);
+        return decision;
+    }
+    if (framePts > clock + presenterEarlyTolerance) {
+        decision.action = PresentAction::Wait;
+        decision.untilDue = framePts - clock;
+        return decision;
+    }
+    decision.lateness = std::max(0.0, clock - framePts);
+    double interval = presentationInterval(framePts, frameDuration, nextPts);
+    decision.action = decision.lateness > presenterLateIntervals * interval && nextPts ? PresentAction::Drop : PresentAction::Show;
+    return decision;
+}
+
+// Wall-clock seconds to sleep before the next decision. `untilDue` is media
+// time; at playback rate r it passes r times faster.
+inline double presenterWaitSeconds(std::optional<double> untilDue, double rate, bool running)
+{
+    if (!running)
+        return presenterIdleSeconds;
+    if (!untilDue)
+        return presenterPollSeconds;
+    double wall = rate > 0 ? *untilDue / rate : *untilDue;
+    return std::clamp(wall, presenterMinWaitSeconds, presenterMaxWaitSeconds);
+}
+
+// Per-interval counters for the "presenter:" log line.
+class PresenterStats {
+public:
+    void record(const PresentDecision& decision)
+    {
+        if (decision.action == PresentAction::Wait)
+            return;
+        ++m_due;
+        if (decision.action == PresentAction::Show) {
+            ++m_shown;
+            m_maxLateness = std::max(m_maxLateness, decision.lateness);
+        } else
+            ++m_lateDropped;
+    }
+
+    unsigned due() const { return m_due; }
+    unsigned shown() const { return m_shown; }
+    unsigned lateDropped() const { return m_lateDropped; }
+    double maxLatenessMilliseconds() const { return m_maxLateness * 1000; }
+
+    // True once `interval` seconds passed since the first call (which only
+    // starts the interval); the caller then logs line() and calls reset().
+    bool intervalElapsed(double now, double interval)
+    {
+        if (!m_started) {
+            m_started = true;
+            m_intervalStart = now;
+            return false;
+        }
+        return now - m_intervalStart >= interval;
+    }
+
+    std::string line() const
+    {
+        char text[128];
+        snprintf(text, sizeof(text), "presenter: due %u shown %u late-dropped %u max lateness %.1f ms", m_due, m_shown, m_lateDropped, maxLatenessMilliseconds());
+        return text;
+    }
+
+    void reset(double now)
+    {
+        m_due = m_shown = m_lateDropped = 0;
+        m_maxLateness = 0;
+        m_intervalStart = now;
+    }
+
+private:
+    unsigned m_due { 0 };
+    unsigned m_shown { 0 };
+    unsigned m_lateDropped { 0 };
+    double m_maxLateness { 0 };
+    double m_intervalStart { 0 };
+    bool m_started { false };
+};
+
+} // namespace FFmpegMedia
+} // namespace WebCore
diff --git a/Source/WebCore/platform/graphics/ffmpeg/FFmpegRemoteAudioClient.h b/Source/WebCore/platform/graphics/ffmpeg/FFmpegRemoteAudioClient.h
new file mode 100644
index 000000000..7fc925774
--- /dev/null
+++ b/Source/WebCore/platform/graphics/ffmpeg/FFmpegRemoteAudioClient.h
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Client side of the audio forwarding protocol (FFmpegAudioWire.h): connects
+// to the UI process's audio server over loopback TCP and streams PCM pulled
+// from a render callback, keeping about `targetAhead` seconds queued on the
+// server. Engine-independent (POSIX sockets, no WebCore/WTF) so the host
+// tests drive the same code as RemoteAudioSink.
+//
+// Threading: connect() runs once on the creating thread. pump() runs on one
+// writer thread and does all socket I/O. setPlaying(), requestFlush(),
+// setVolume() and latencySeconds() may be called from any thread.
+
+#pragma once
+
+#include "FFmpegAudioWire.h"
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+namespace WebCore {
+namespace FFmpegMedia {
+namespace AudioWire {
+
+inline double monotonicSeconds()
+{
+    using namespace std::chrono;
+    return duration<double>(steady_clock::now().time_since_epoch()).count();
+}
+
+class RemoteAudioClient {
+public:
+    static constexpr double defaultTargetAhead = 0.1;
+    static constexpr size_t chunkFrames = 480; // 10 ms
+
+    RemoteAudioClient() = default;
+    RemoteAudioClient(const RemoteAudioClient&) = delete;
+    RemoteAudioClient& operator=(const RemoteAudioClient&) = delete;
+
+    ~RemoteAudioClient()
+    {
+        if (m_fd >= 0)
+            ::close(m_fd);
+    }
+
+    void setTargetAhead(double seconds) { m_targetAhead = std::clamp(seconds, 0.02, 0.9); }
+    double targetAhead() const { return m_targetAhead; }
+
+    // Connects to 127.0.0.1:port, sends the hello and waits for "accepted",
+    // all within `timeoutMs`. On failure `error` says why.
+    bool connect(int port, int timeoutMs, std::string& error)
+    {
+        double deadline = monotonicSeconds() + timeoutMs / 1000.0;
+        m_fd = ::socket(AF_INET, SOCK_STREAM, 0);
+        if (m_fd < 0)
+            return fail(error, "socket");
+        int flags = fcntl(m_fd, F_GETFL, 0);
+        fcntl(m_fd, F_SETFL, flags | O_NONBLOCK);
+        int one = 1;
+        setsockopt(m_fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+#ifdef SO_NOSIGPIPE
+        setsockopt(m_fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+#endif
+        sockaddr_in address { };
+        address.sin_family = AF_INET;
+        address.sin_port = htons(static_cast<uint16_t>(port));
+        address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        if (::connect(m_fd, reinterpret_cast<sockaddr*>(&address), sizeof(address))) {
+            if (errno != EINPROGRESS)
+                return fail(error, "connect");
+            if (!waitFor(POLLOUT, deadline))
+                return fail(error, "connect timed out", false);
+            int soError = 0;
+            socklen_t length = sizeof(soError);
+            getsockopt(m_fd, SOL_SOCKET, SO_ERROR, &soError, &length);
+            if (soError) {
+                errno = soError;
+                return fail(error, "connect");
+            }
+        }
+        uint8_t hello[helloSize];
+        encodeHello(Hello { }, hello);
+        if (!sendAll(hello, sizeof(hello), deadline))
+            return fail(error, "sending the hello");
+        while (true) {
+            auto result = m_parser.next();
+            if (result == FrameParser::Result::Message) {
+                auto& message = m_parser.message();
+                if (message.type == Type::Accepted) {
+                    auto accepted = decodeAccepted(message.payload, message.bytes);
+                    if (!accepted)
+                        return fail(error, "malformed accepted message", false);
+                    m_accepted = *accepted;
+                    std::lock_guard<std::mutex> lock(m_lock);
+                    m_clock.setOutputLatencyFrames(accepted->outputLatencyFrames);
+                    return true;
+                }
+                if (message.type == Type::Rejected)
+                    return fail(error, "the server rejected the stream format", false);
+                continue;
+            }
+            if (result == FrameParser::Result::Error)
+                return fail(error, "protocol error", false);
+            if (!waitFor(POLLIN, deadline))
+                return fail(error, "no answer from the server", false);
+            if (!receive())
+                return fail(error, "connection closed during the handshake", false);
+        }
+    }
+
+    const Accepted& accepted() const { return m_accepted; }
+    bool failed() const { return m_failed; }
+    const std::string& failure() const { return m_failure; }
+
+    void setPlaying(bool playing) { m_wantPlaying = playing; }
+    void requestFlush()
+    {
+        {
+            std::lock_guard<std::mutex> lock(m_lock);
+            m_clock.retireAllSent();
+        }
+        m_flushRequested = true;
+    }
+    void setVolume(float gain)
+    {
+        m_volume = gain;
+        m_volumeChanged = true;
+    }
+    void requestClose() { m_closeRequested = true; }
+
+    double latencySeconds()
+    {
+        std::lock_guard<std::mutex> lock(m_lock);
+        return m_clock.latencySeconds(monotonicSeconds());
+    }
+
+    uint64_t totalSent()
+    {
+        std::lock_guard<std::mutex> lock(m_lock);
+        return m_clock.totalSent();
+    }
+
+    uint64_t estimatedRetired()
+    {
+        std::lock_guard<std::mutex> lock(m_lock);
+        return m_clock.estimatedRetired(monotonicSeconds());
+    }
+
+    // One step of the writer thread: reads played reports, forwards control
+    // requests, then tops the server up to targetAhead() with frames from
+    // `pull(float* interleaved, size_t frames)`. After a connection failure
+    // it keeps pulling in real time and discards the samples, so the clock
+    // still advances (like the null sink). Returns false once failed.
+    template<typename Pull>
+    bool pump(Pull&& pull)
+    {
+        double now = monotonicSeconds();
+        if (m_failed) {
+            paceLocally(now, pull);
+            return false;
+        }
+        if (!receive() || !handleMessages(now)) {
+            setFailed("connection lost");
+            return false;
+        }
+        m_out.clear();
+        if (m_flushRequested.exchange(false))
+            appendMessage(m_out, Type::Flush);
+        if (m_volumeChanged.exchange(false))
+            appendVolume(m_out, m_volume);
+        bool playing = m_wantPlaying;
+        if (playing != m_sentPlaying) {
+            appendPause(m_out, !playing);
+            m_sentPlaying = playing;
+            std::lock_guard<std::mutex> lock(m_lock);
+            m_clock.setPlaying(playing, now);
+        }
+        bool closing = m_closeRequested;
+        uint64_t ahead;
+        {
+            std::lock_guard<std::mutex> lock(m_lock);
+            ahead = m_clock.aheadFrames(now);
+        }
+        uint64_t target = static_cast<uint64_t>(m_targetAhead * sampleRate);
+        uint64_t pulled = 0;
+        while (playing && !closing && ahead + pulled < target) {
+            size_t frames = static_cast<size_t>(std::min<uint64_t>(chunkFrames, target - ahead - pulled));
+            m_samples.resize(frames * channels);
+            pull(m_samples.data(), frames);
+            appendMessage(m_out, Type::Pcm, m_samples.data(), m_samples.size() * sizeof(float));
+            pulled += frames;
+            // Counted as soon as the render callback consumed them: the
+            // engine's clock already includes these frames.
+            std::lock_guard<std::mutex> lock(m_lock);
+            m_clock.sent(frames);
+        }
+        if (closing)
+            appendMessage(m_out, Type::Close);
+        if (!m_out.empty() && !sendAll(m_out.data(), m_out.size(), now + 1)) {
+            setFailed("send failed");
+            return false;
+        }
+        if (closing) {
+            ::close(m_fd);
+            m_fd = -1;
+            m_failed = true;
+            m_failure = "closed";
+        }
+        return true;
+    }
+
+private:
+    bool fail(std::string& error, const char* what, bool withErrno = true)
+    {
+        error = what;
+        if (withErrno) {
+            error += ": ";
+            error += strerror(errno);
+        }
+        if (m_fd >= 0)
+            ::close(m_fd);
+        m_fd = -1;
+        return false;
+    }
+
+    void setFailed(const char* why)
+    {
+        m_failed = true;
+        m_failure = why;
+        if (m_fd >= 0)
+            ::close(m_fd);
+        m_fd = -1;
+        std::lock_guard<std::mutex> lock(m_lock);
+        m_clock.setOutputLatencyFrames(0);
+        m_clock.retireAllSent();
+        m_paceTime = monotonicSeconds();
+        m_paceFrames = 0;
+    }
+
+    template<typename Pull>
+    void paceLocally(double now, Pull& pull)
+    {
+        if (!m_wantPlaying) {
+            m_paceTime = now;
+            return;
+        }
+        m_paceFrames += std::min(now - m_paceTime, 0.1) * sampleRate;
+        m_paceTime = now;
+        size_t frames = static_cast<size_t>(m_paceFrames);
+        m_paceFrames -= frames;
+        if (!frames)
+            return;
+        m_samples.resize(frames * channels);
+        pull(m_samples.data(), frames);
+        std::lock_guard<std::mutex> lock(m_lock);
+        m_clock.sent(frames);
+        m_clock.retireAllSent();
+    }
+
+    bool waitFor(short events, double deadline)
+    {
+        while (true) {
+            int timeout = static_cast<int>((deadline - monotonicSeconds()) * 1000);
+            if (timeout < 0)
+                return false;
+            pollfd entry { m_fd, events, 0 };
+            int result = ::poll(&entry, 1, timeout);
+            if (result > 0)
+                return true;
+            if (!result || errno != EINTR)
+                return false;
+        }
+    }
+
+    bool sendAll(const uint8_t* data, size_t bytes, double deadline)
+    {
+        int flags = 0;
+#ifdef MSG_NOSIGNAL
+        flags |= MSG_NOSIGNAL;
+#endif
+        while (bytes) {
+            ssize_t sent = ::send(m_fd, data, bytes, flags);
+            if (sent > 0) {
+                data += sent;
+                bytes -= static_cast<size_t>(sent);
+                continue;
+            }
+            if (sent < 0 && errno == EINTR)
+                continue;
+            if (sent < 0 && (errno == EAGAIN || errno == EWOULDBLOCK) && waitFor(POLLOUT, deadline))
+                continue;
+            return false;
+        }
+        return true;
+    }
+
+    // Non-blocking read of whatever arrived. False when the peer closed.
+    bool receive()
+    {
+        uint8_t buffer[4096];
+        while (true) {
+            ssize_t got = ::recv(m_fd, buffer, sizeof(buffer), 0);
+            if (got > 0) {
+                m_parser.append(buffer, static_cast<size_t>(got));
+                continue;
+            }
+            if (!got)
+                return false;
+            if (errno == EINTR)
+                continue;
+            return errno == EAGAIN || errno == EWOULDBLOCK;
+        }
+    }
+
+    bool handleMessages(double now)
+    {
+        while (true) {
+            auto result = m_parser.next();
+            if (result == FrameParser::Result::NeedMore)
+                return true;
+            if (result != FrameParser::Result::Message)
+                return false;
+            auto& message = m_parser.message();
+            if (message.type == Type::Played) {
+                if (auto played = decodePlayed(message.payload, message.bytes)) {
+                    std::lock_guard<std::mutex> lock(m_lock);
+                    m_clock.report(*played, now);
+                }
+            }
+        }
+    }
+
+    int m_fd { -1 };
+    FrameParser m_parser;
+    Accepted m_accepted;
+    std::mutex m_lock;
+    RemoteAudioClock m_clock; // guarded by m_lock
+    double m_targetAhead { defaultTargetAhead };
+    std::vector<uint8_t> m_out;
+    std::vector<float> m_samples;
+    std::atomic<bool> m_wantPlaying { false };
+    std::atomic<bool> m_flushRequested { false };
+    std::atomic<bool> m_volumeChanged { false };
+    std::atomic<float> m_volume { 1 };
+    std::atomic<bool> m_closeRequested { false };
+    bool m_sentPlaying { true }; // the server starts a stream unpaused
+    bool m_failed { false };
+    std::string m_failure;
+    double m_paceTime { 0 };
+    double m_paceFrames { 0 };
+};
+
