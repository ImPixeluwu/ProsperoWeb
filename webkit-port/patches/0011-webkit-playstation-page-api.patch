@@ -139,10 +139,25 @@ bool PlayStationWebView::isFullScreen()
 
 void PlayStationWebView::enterFullScreen(CompletionHandler<void(bool)>&& completionHandler)
 {
+#if defined(PS5_HOMEBREW)
+    // Nothing calls willEnterFullScreen(), so m_isFullScreen stayed false:
+    // exitFullScreen() never reached the client and requestExitFullScreen()
+    // (WKViewRequestExitFullScreen) did nothing. Record the state when the
+    // client accepts; beganExitFullScreen()/closeFullScreenManager() clear it.
+    if (m_client && !isFullScreen()) {
+        m_client->enterFullScreen(*this, [this, protectedThis = Ref { *this }, completionHandler = WTF::move(completionHandler)](bool entered) mutable {
+            if (entered)
+                m_isFullScreen = true;
+            completionHandler(entered);
+        });
+    } else
+        completionHandler(false);
+#else
     if (m_client && !isFullScreen())
         m_client->enterFullScreen(*this, WTF::move(completionHandler));
     else
         completionHandler(false);
+#endif
 }
 
 void PlayStationWebView::exitFullScreen(CompletionHandler<void()>&& completionHandler)
