@@ -134,10 +177,52 @@ void WKPageHandleMouseEvent(WKPageRef pageRef, WKMouseEvent event)
         ASSERT_NOT_REACHED();
         return;
     }
+#if defined(PS5_HOMEBREW)
+    // libwpe's WebEventFactory derives clickCount from the event time and
+    // MouseEvent.buttons from the button bits of the modifiers. A constant
+    // time of 0 made every press within 5 px of the previous one a
+    // double/triple click (word/paragraph selection instead of a plain click),
+    // and without button bits mousedown reported buttons == 0. Give each event
+    // a real monotonic time and the pressed-button state after the event, as
+    // the WPE backends do.
+    static uint32_t pressedButtons = 0;
+    uint32_t buttonBit = 0;
+    switch (wpeEvent.button) {
+    case 1:
+        buttonBit = wpe_input_pointer_modifier_button1;
+        break;
+    case 2:
+        buttonBit = wpe_input_pointer_modifier_button2;
+        break;
+    case 3:
+        buttonBit = wpe_input_pointer_modifier_button3;
+        break;
+    default:
+        break;
+    }
+    if (event.type == kWKEventMouseDown)
+        pressedButtons |= buttonBit;
+    else if (event.type == kWKEventMouseUp)
+        pressedButtons &= ~buttonBit;
+    uint32_t time = static_cast<uint32_t>(MonotonicTime::now().secondsSinceEpoch().milliseconds());
+    wpeEvent.time = time ? time : 1;
+    wpeEvent.x = event.position.x;
+    wpeEvent.y = event.position.y;
+    wpeEvent.modifiers = pressedButtons;
+    if (event.modifiers & kWKEventModifiersShiftKey)
+        wpeEvent.modifiers |= wpe_input_keyboard_modifier_shift;
+    if (event.modifiers & kWKEventModifiersControlKey)
+        wpeEvent.modifiers |= wpe_input_keyboard_modifier_control;
+    if (event.modifiers & kWKEventModifiersAltKey)
+        wpeEvent.modifiers |= wpe_input_keyboard_modifier_alt;
+    if (event.modifiers & kWKEventModifiersMetaKey)
+        wpeEvent.modifiers |= wpe_input_keyboard_modifier_meta;
