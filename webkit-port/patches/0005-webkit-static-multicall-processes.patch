Subject: WebKit: multi-call process model for PS5_HOMEBREW

Homebrew payloads are not executables the kernel can exec, and the
payload loader starts children with an empty fd table, so the Sony
model (separate WebProcess.self/NetworkProcess.self, launched by
<process-launcher.h>, receiving the IPC socket via
PlayStation::getConnectionIdentifier() and dlopen()ing libWebKit) does
not apply. Instead the shell is one static multi-call executable:
 - ProcessLauncherPlayStation calls ps5_spawn_self({"WebProcess" |
   "NetworkProcess", id, "3"}, {clientFd}, 1) and ps5_terminate_process()
   (declared in webkit-port/include/ps5webkit/spawn.h, implemented by
   the shell); a failed spawn is logged and reported with an invalid
   connection identifier, so WebKit runs its failed-to-launch path,
 - the playstation EntryPoint files define ps5_webkit_web_process_main()
   and ps5_webkit_network_process_main() (ps5webkit/entry.h) without any
   dlopen() and are compiled into libWebKit,
 - WebKit/CMakeLists.txt skips the WebProcess/NetworkProcess executables
   when WebKit_NO_AUXILIARY_EXECUTABLES is set (by patch 0001).
PS5WEBKIT_INCLUDE_DIR must point to webkit-port/include.

Also fixes the case of WKRunLoop.{cpp,h} in PlatformPlayStation.cmake
(upstream only builds the port on case-insensitive Windows hosts).
diff --git a/Source/WebKit/CMakeLists.txt b/Source/WebKit/CMakeLists.txt
index 8067b2158..5567b5745 100644
--- a/Source/WebKit/CMakeLists.txt
+++ b/Source/WebKit/CMakeLists.txt
@@ -864,7 +864,7 @@ if (NOT USE_HEADER_MAPS AND NOT USE_FRAMEWORK_BUNDLES)
     )
     set(WebKit_INTERFACE_DEPENDENCIES "")
 endif ()
-if (NOT USE_EXTENSIONKIT)
+if (NOT USE_EXTENSIONKIT AND NOT WebKit_NO_AUXILIARY_EXECUTABLES)
     # ExtensionKit processes (on iOS) are separate targets, and not part of the
     # WebKit.framework bundle.
     set(WebKit_INTERFACE_LINK_DEPENDS
@@ -1674,7 +1674,7 @@ if (WEBKIT_SDK_IS_MACOS OR WEBKIT_SDK_IS_IOS_FAMILY)
     WEBKIT_DEFINE_AUXILIARY_PROCESSES()
 endif ()
 
-if (NOT USE_EXTENSIONKIT)
+if (NOT USE_EXTENSIONKIT AND NOT WebKit_NO_AUXILIARY_EXECUTABLES)
     list(APPEND WebProcess_PRIVATE_INCLUDE_DIRECTORIES $<TARGET_PROPERTY:WebKit,INCLUDE_DIRECTORIES>)
     WEBKIT_EXECUTABLE(WebProcess)
     WEBKIT_REUSE_PREFIX_HEADER(WebProcess WebKit WebKitPrefix.h PREFIX_LANGUAGES CXX)
@@ -1692,7 +1692,7 @@ endif ()
 
 if (COMPILER_IS_GCC_OR_CLANG)
     WEBKIT_ADD_TARGET_CXX_FLAGS(WebKit -Wno-unused-parameter)
-    if (NOT USE_EXTENSIONKIT)
+    if (NOT USE_EXTENSIONKIT AND NOT WebKit_NO_AUXILIARY_EXECUTABLES)
         WEBKIT_ADD_TARGET_CXX_FLAGS(WebProcess -Wno-unused-parameter)
         WEBKIT_ADD_TARGET_CXX_FLAGS(NetworkProcess -Wno-unused-parameter)
         if (ENABLE_GPU_PROCESS)
@@ -1713,13 +1713,20 @@ if (NOT APPLE)
         set_target_properties(WebKit PROPERTIES VERSION ${WEBKIT_VERSION} SOVERSION ${WEBKIT_VERSION_MAJOR})
     endif ()
 
+    if (WebKit_NO_AUXILIARY_EXECUTABLES)
+        install(TARGETS WebKit
+            LIBRARY DESTINATION "${LIB_INSTALL_DIR}"
+            ARCHIVE DESTINATION "${LIB_INSTALL_DIR}"
+        )
+    else ()
     install(TARGETS WebKit WebProcess NetworkProcess
         LIBRARY DESTINATION "${LIB_INSTALL_DIR}"
         RUNTIME DESTINATION "${LIBEXEC_INSTALL_DIR}"
         FRAMEWORK DESTINATION "${LIB_INSTALL_DIR}"
         BUNDLE DESTINATION "${LIBEXEC_INSTALL_DIR}"
     )
-    if (ENABLE_GPU_PROCESS)
+    endif ()
+    if (ENABLE_GPU_PROCESS AND NOT WebKit_NO_AUXILIARY_EXECUTABLES)
         install(TARGETS GPUProcess
             LIBRARY DESTINATION "${LIB_INSTALL_DIR}"
             RUNTIME DESTINATION "${LIBEXEC_INSTALL_DIR}"
diff --git a/Source/WebKit/NetworkProcess/EntryPoint/playstation/NetworkProcessMain.cpp b/Source/WebKit/NetworkProcess/EntryPoint/playstation/NetworkProcessMain.cpp
index 162edd286..ce7d2bb2c 100644
--- a/Source/WebKit/NetworkProcess/EntryPoint/playstation/NetworkProcessMain.cpp
+++ b/Source/WebKit/NetworkProcess/EntryPoint/playstation/NetworkProcessMain.cpp
@@ -26,6 +26,22 @@
 #include "config.h"
 #include "NetworkProcessMain.h"
 
+#if defined(PS5_HOMEBREW)
+#include <ps5webkit/entry.h>
+#include <stdio.h>
+
+// Statically linked into the shell's multi-call executable: nothing to
+// dlopen(), and the launcher already passes argv in the AuxiliaryProcessMain
+// format { name, processIdentifier, fd } (see ps5webkit/entry.h).
+extern "C" int ps5_webkit_network_process_main(int argc, char** argv)
+{
+    if (argc < 3) {
+        fprintf(stderr, "ps5_webkit_network_process_main: unexpected argument count %d\n", argc);
+        return 1;
+    }
+    return WebKit::NetworkProcessMain(argc, argv);
+}
+#else
 #include <dlfcn.h>
 #include <process-initialization/nk-networkprocess.h>
 #include <stdio.h>
@@ -79,3 +95,4 @@ int main(int argc, char** argv)
     };
     return WebKit::NetworkProcessMain(sizeof(internalArgv) / sizeof(char*), internalArgv);
 }
+#endif // defined(PS5_HOMEBREW)
diff --git a/Source/WebKit/PlatformPlayStation.cmake b/Source/WebKit/PlatformPlayStation.cmake
index 0a6968d20..8caba173f 100644
--- a/Source/WebKit/PlatformPlayStation.cmake
+++ b/Source/WebKit/PlatformPlayStation.cmake
@@ -1,6 +1,22 @@
 include(Headers.cmake)
 include(Platform/Curl.cmake)
 
+if (PS5_HOMEBREW)
+    # No separate WebProcess/NetworkProcess executables: their entry points
+    # (ps5_webkit_*_process_main) are compiled into the static libWebKit and
+    # called by the shell's multi-call executable. The launcher calls
+    # ps5_spawn_self(), provided by the shell. Both contracts live in
+    # ${PS5WEBKIT_INCLUDE_DIR}/ps5webkit/.
+    if (NOT PS5WEBKIT_INCLUDE_DIR)
+        message(FATAL_ERROR "PS5_HOMEBREW requires PS5WEBKIT_INCLUDE_DIR (webkit-port/include)")
+    endif ()
+    list(APPEND WebKit_SOURCES
+        NetworkProcess/EntryPoint/playstation/NetworkProcessMain.cpp
+        WebProcess/EntryPoint/playstation/WebProcessMain.cpp
+    )
+    list(APPEND WebKit_PRIVATE_INCLUDE_DIRECTORIES "${PS5WEBKIT_INCLUDE_DIR}")
+endif ()
+
 WEBKIT_ADD_TARGET_CXX_FLAGS(WebKit -Wno-unused-lambda-capture)
 
 list(APPEND WebProcess_SOURCES
@@ -69,7 +85,7 @@ list(APPEND WebKit_SOURCES
 
     UIProcess/API/C/playstation/WKContextConfigurationPlayStation.cpp
     UIProcess/API/C/playstation/WKPagePrivatePlayStation.cpp
-    UIProcess/API/C/playstation/WKRunloop.cpp
+    UIProcess/API/C/playstation/WKRunLoop.cpp
     UIProcess/API/C/playstation/WKView.cpp
 
     UIProcess/CoordinatedGraphics/DrawingAreaProxyCoordinatedGraphics.cpp
@@ -176,7 +192,7 @@ list(APPEND WebKit_PUBLIC_FRAMEWORK_HEADERS
 
     UIProcess/API/C/playstation/WKContextConfigurationPlayStation.h
     UIProcess/API/C/playstation/WKPagePrivatePlayStation.h
-    UIProcess/API/C/playstation/WKRunloop.h
+    UIProcess/API/C/playstation/WKRunLoop.h
     UIProcess/API/C/playstation/WKView.h
     UIProcess/API/C/playstation/WKViewClient.h
 )
diff --git a/Source/WebKit/UIProcess/Launcher/playstation/ProcessLauncherPlayStation.cpp b/Source/WebKit/UIProcess/Launcher/playstation/ProcessLauncherPlayStation.cpp
index f510f5eeb..a669c8c67 100644
--- a/Source/WebKit/UIProcess/Launcher/playstation/ProcessLauncherPlayStation.cpp
+++ b/Source/WebKit/UIProcess/Launcher/playstation/ProcessLauncherPlayStation.cpp
@@ -36,13 +36,21 @@
 
 #if USE(WPE_BACKEND_PLAYSTATION)
 #include "ProcessProviderLibWPE.h"
+#elif defined(PS5_HOMEBREW)
+#include <array>
+#include <cstring>
+#include <inttypes.h>
+#include <ps5webkit/spawn.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/RunLoop.h>
+#include <wtf/WorkQueue.h>
 #else
 #include <process-launcher.h>
 #endif
 
 namespace WebKit {
 
-#if !USE(WPE_BACKEND_PLAYSTATION)
+#if !USE(WPE_BACKEND_PLAYSTATION) && !defined(PS5_HOMEBREW)
 #define MAKE_PROCESS_PATH(x) "/app0/" #x "Process.self"
 static const char* defaultProcessPath(ProcessLauncher::ProcessType processType)
 {
@@ -72,6 +80,50 @@ void ProcessLauncher::launchProcess()
     setsockopt(socketPair.server.value(), SOL_SOCKET, SO_RCVBUF, &recvBufSize, 4);
     setsockopt(socketPair.client.value(), SOL_SOCKET, SO_RCVBUF, &recvBufSize, 4);
 
+#if defined(PS5_HOMEBREW) && !USE(WPE_BACKEND_PLAYSTATION)
+    // The shell re-executes its own multi-call ELF: argv[0] selects the role
+    // and the client socket is passed as fd 3 (see ps5webkit/spawn.h).
+    //
+    // ps5_spawn_self blocks on the broker round trip (~250 ms, more under load
+    // and on the first-use image mapping). Running it on the main thread would
+    // stall the UI run loop, painting and input, so dispatch it to a work queue
+    // and post didFinishLaunchingProcess back to the main run loop, the way the
+    // other ports complete asynchronously. The worker owns the socket pair for
+    // the duration of the call: the client fd must stay open until the broker
+    // has rdup'ed it, which happens inside ps5_spawn_self.
+    char coreProcessIdentifierString[32];
+    snprintf(coreProcessIdentifierString, sizeof coreProcessIdentifierString, "%" PRIu64, m_launchOptions.processIdentifier.toUInt64());
+    std::array<char, 32> identifierString;
+    memcpy(identifierString.data(), coreProcessIdentifierString, sizeof coreProcessIdentifierString);
+    ProcessLauncher::ProcessType processType = m_launchOptions.processType;
+
+    static NeverDestroyed<Ref<WorkQueue>> spawnQueue(WorkQueue::create("com.prosperoweb.spawn"_s));
+    spawnQueue.get()->dispatch([protectedThis = Ref { *this }, processType, identifierString, socketPair = WTF::move(socketPair)]() mutable {
+        const char* processName = "WebProcess";
+        if (processType == ProcessLauncher::ProcessType::Network)
+            processName = "NetworkProcess";
+#if ENABLE(GPU_PROCESS)
+        else if (processType == ProcessLauncher::ProcessType::GPU)
+            processName = "GPUProcess";
+#endif
+        const char* argv[] = { processName, identifierString.data(), "3", nullptr };
+        int fds[] = { socketPair.client.value() };
+        int32_t appLocalPid = ps5_spawn_self(argv, fds, 1);
+
+        RunLoop::mainSingleton().dispatch([protectedThis = WTF::move(protectedThis), appLocalPid, processType, serverIdentifier = WTF::move(socketPair.server)]() mutable {
+            if (appLocalPid < 0) {
+                // Report the failure like the GLib launcher does: an invalid
+                // connection identifier makes the process proxy run its
+                // terminated/failed-to-launch path instead of waiting forever.
+                SAFE_FPRINTF(stderr, "ps5webkit: failed to launch auxiliary process type %d (ps5_spawn_self returned %d)\n", static_cast<int>(processType), appLocalPid);
+                protectedThis->didFinishLaunchingProcess(0, { });
+                return;
+            }
+            protectedThis->didFinishLaunchingProcess(appLocalPid, IPC::Connection::Identifier { WTF::move(serverIdentifier) });
+        });
+    });
+    return;
+#else
     char coreProcessIdentifierString[16];
     snprintf(coreProcessIdentifierString, sizeof coreProcessIdentifierString, "%ld", m_launchOptions.processIdentifier.toUInt64());
 
@@ -90,7 +142,7 @@ void ProcessLauncher::launchProcess()
 #endif
 
     if (appLocalPid < 0) {
-#ifndef NDEBUG
+#if !defined(NDEBUG)
         SAFE_FPRINTF(stderr, "Failed to launch process. err=0x%08x path=%s\n", appLocalPid, m_launchOptions.processPath.utf8());
 #endif
         return;
@@ -100,6 +152,7 @@ void ProcessLauncher::launchProcess()
     RunLoop::mainSingleton().dispatch([protectedThis = Ref { *this }, appLocalPid, serverIdentifier = WTF::move(socketPair.server)] mutable {
         protectedThis->didFinishLaunchingProcess(appLocalPid, IPC::Connection::Identifier { WTF::move(serverIdentifier) });
     });
+#endif
 }
 
 void ProcessLauncher::terminateProcess(const String&)
@@ -109,6 +162,8 @@ void ProcessLauncher::terminateProcess(const String&)
 
 #if USE(WPE_BACKEND_PLAYSTATION)
     ProcessProviderLibWPE::singleton().kill(m_processID);
+#elif defined(PS5_HOMEBREW)
+    ps5_terminate_process(m_processID);
 #else
     PlayStation::terminateProcess(m_processID);
 #endif
