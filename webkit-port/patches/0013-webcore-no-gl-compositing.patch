Subject: WebCore/WebKit: never enter accelerated compositing without a GL display

The PS5 build paints without accelerated compositing (the shell sets
AcceleratedCompositingEnabled=false) and has no PlatformDisplay. Some
callers enter compositing mode regardless of the setting: a page calling
document.startViewTransition() made RenderLayerCompositor::
enableCompositingMode() create the root layer, the drawing area then
built a LayerTreeHost, and CoordinatedTileManager::create hit the
RELEASE_ASSERT in PlatformDisplay::sharedDisplay(), killing the
WebProcess.

- RenderLayerCompositor::enableCompositingMode() refuses to enable
  compositing when the setting is off (view transitions, plug-ins and
  page overlays all funnel through it).
- View transitions are skipped like for a hidden document: the update
  callback still runs; resolveViewTransitionRule() skips cross-document
  ones.
- DrawingAreaCoordinatedGraphics::enterAcceleratedCompositingMode() does
  nothing without a shared display, so graphicsLayerFactory() returns
  null instead of crashing.
- The WebProcess turns off accelerated buffers when there is no display.
diff --git a/Source/WebCore/dom/Document.cpp b/Source/WebCore/dom/Document.cpp
index ed8dedf70..703bf24b1 100644
--- a/Source/WebCore/dom/Document.cpp
+++ b/Source/WebCore/dom/Document.cpp
@@ -9332,6 +9332,12 @@ Variant<Document::SkipTransition, Vector<AtomString>> Document::resolveViewTrans
     if (hidden())
         return SkipTransition { };
 
+#if defined(PS5_HOMEBREW)
+    // View transitions need compositing, which the PS5 build does not have.
+    if (!settings().acceleratedCompositingEnabled())
+        return SkipTransition { };
+#endif
+
     RefPtr rule = protect(styleScope().resolver())->viewTransitionRule();
     if (rule && rule->computedNavigation() == ViewTransitionNavigation::Auto)
         return rule->types();
@@ -12713,6 +12719,15 @@ RefPtr<ViewTransition> Document::startViewTransition(StartViewTransitionCallback
         return viewTransition;
     }
 
+#if defined(PS5_HOMEBREW)
+    // The update callback still runs; only the animated transition, which
+    // needs compositing, is skipped.
+    if (!settings().acceleratedCompositingEnabled()) {
+        viewTransition->skipViewTransition(Exception { ExceptionCode::InvalidStateError, "View transition was skipped because accelerated compositing is disabled."_s });
+        return viewTransition;
+    }
+#endif
+
     if (RefPtr activeViewTransition = m_activeViewTransition)
         activeViewTransition->skipViewTransition(Exception { ExceptionCode::AbortError, "Old view transition aborted by new view transition."_s });
 
diff --git a/Source/WebCore/rendering/RenderLayerCompositor.cpp b/Source/WebCore/rendering/RenderLayerCompositor.cpp
index 9acfd0a4d..ad8177811 100644
--- a/Source/WebCore/rendering/RenderLayerCompositor.cpp
+++ b/Source/WebCore/rendering/RenderLayerCompositor.cpp
@@ -596,6 +596,15 @@ RenderLayerCompositor::~RenderLayerCompositor()
 
 void RenderLayerCompositor::enableCompositingMode(bool enable /* = true */)
 {
+#if defined(PS5_HOMEBREW)
+    // The PS5 build paints without accelerated compositing (no GL display):
+    // entering compositing mode would make the drawing area create a
+    // LayerTreeHost, which needs PlatformDisplay::sharedDisplay(). Callers
+    // that force it regardless of the setting (view transitions, plug-ins,
+    // page overlays) stay in the software path.
+    if (enable && !m_renderView.settings().acceleratedCompositingEnabled())
+        return;
+#endif
     if (enable != m_compositing) {
         m_compositing = enable;
         
